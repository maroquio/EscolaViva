      { "id": "projections", "label": "What is computed on read", "focus": ["database", "reportCard", "board"], "note": "Average, attendance and read rate are queried, never kept in a computed column." },
      { "id": "outputs", "label": "What leaves the database", "focus": ["database", "log", "dump"], "note": "The log carries identifiers and outcomes; the dump is the only copy, and it only counts once restored." }
