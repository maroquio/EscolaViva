  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "The database decides, the projections show",
      "items": [
        "Average, attendance and status are computed on every read",
        "No use case decides from a value that was computed and stored",
        "When cache, replica and search arrive, none of them will decide anything"
      ]
    },
    {
      "dot": "rose",
      "title": "What the log never carries",
      "items": [
        "It records student_id, never the student's name",
        "Never a guardian's e-mail, never a grade, never an excuse",
        "Data about minors gets stricter treatment from day 1"
      ]
    },
    {
      "dot": "amber",
      "title": "The only copy that exists",
      "items": [
        "There is no object storage, replica or search index at this stage",
        "The dump is the only copy — and it is only a backup once restored",
        "The restore compares the count of active enrollments on both sides"
      ]
    }
  ]
}
