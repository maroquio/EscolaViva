  "cards": [
    {
      "dot": "amber",
      "title": "Synchronous on purpose",
      "items": [
        "There is no queue, no worker and no background execution",
        "The browser waits for the entire check to finish",
        "Optimising before measuring would erase the evidence"
      ]
    },
    {
      "dot": "emerald",
      "title": "What closing guarantees",
      "items": [
        "It only closes with a grade for every active enrollment in every assigned subject",
        "Once closed, posting a grade for that term is refused",
        "Closing twice is refused by the uniqueness constraint"
      ]
    },
    {
      "dot": "rose",
      "title": "The number to record",
      "items": [
        "Closing one class group of 35 students: about 6 seconds",
        "Closing the network's 40 class groups: about 4 minutes",
        "That number is what justifies the queue at Stage 05"
      ]
    }
