  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "What the teacher sees",
      "items": [
        "Only the class groups and subjects where they are the assigned teacher",
        "Any other identifier answers 404, not 403",
        "The grades route is the performance reference: p95 under 300 ms"
      ]
    },
    {
      "dot": "emerald",
      "title": "Posting is a batch operation",
      "items": [
        "The whole class group is written in a single submission",
        "An empty field clears that student's grade for the term",
        "Reposting updates; it never duplicates"
      ]
    },
    {
      "dot": "amber",
      "title": "Once closed, it locks",
      "items": [
        "With the term closed, posting a grade into it is refused",
        "Attendance is per day — per-lesson attendance is a different product",
        "A repeated roll call on the same day updates the existing row"
      ]
    }
  ]
