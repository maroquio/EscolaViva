    { "id": "classGroups", "lane": "teacher", "col": 1, "type": "frontend", "label": "Class groups", "sublabel": "only their own" },
    { "id": "grades", "lane": "assessment", "col": 1, "type": "backend", "label": "Grades", "sublabel": "0 to 10, one decimal" },
    { "id": "rollCall", "lane": "assessment", "col": 3, "type": "backend", "label": "Roll call", "sublabel": "per day, not per lesson" },
    { "id": "close", "lane": "assessment", "col": 5, "type": "backend", "label": "Close", "sublabel": "one term at a time" },
    { "id": "stored", "lane": "database", "col": 3, "type": "database", "label": "Stored", "sublabel": "grade, attendance" },
