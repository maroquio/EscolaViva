# EscolaViva — Estágio 01
# I18: config por variável de ambiente, segredo fora do repositório. Copie para `.env`
# (que está no .gitignore) e ajuste. Falta de qualquer variável obrigatória derruba o boot.

# Ambiente de execução: development | test | production.
# É o que decide o default de SECURE_COOKIE — não existe "modo debug" escondido no código.
APP_ENV=development

# Porta HTTP do processo. A mesma imagem roda em dev e em produção (I19); só a porta muda.
PORT=3000

# O compose mora em `infra/`, e o Docker só procura o arquivo na pasta atual e nas de cima —
# nunca nas de baixo. Esta variável é o que mantém `docker compose up -d database` funcionando
# da raiz, sem `-f` em todo comando. Lida pelo próprio Docker, não pela aplicação.
COMPOSE_FILE=infra/docker-compose.yml

# Portas que o docker-compose publica no host. Só existem para o desenvolvimento local:
# quem já tem PostgreSQL instalado encontra 5432 ocupada. Se mudar aqui, mude também a
# porta dentro de DATABASE_URL e TEST_DATABASE_URL abaixo.
DB_PORT=5432
TEST_DB_PORT=5433

# PostgreSQL primário: a única fonte da verdade do sistema (I5).
# Nenhum estado da aplicação vive fora daqui.
DATABASE_URL=postgres://escolaviva:escolaviva_dev@localhost:5432/escolaviva

# Banco descartável usado por `bun test`. Nunca aponte para o banco de desenvolvimento:
# a suíte roda as migrações e trunca as tabelas entre os casos.
TEST_DATABASE_URL=postgres://escolaviva:escolaviva_dev@localhost:5433/escolaviva_teste

# Segredo que assina o cookie de sessão (I2). Mínimo de 32 caracteres.
# Gere com `openssl rand -hex 32`. Trocar este valor invalida todas as sessões abertas.
SESSION_SECRET=troque-este-valor-por-32-caracteres-ou-mais

# Validade da sessão em horas. Expiração vive na tabela `sessao`, não no cookie —
# é isso que dá trabalho real ao único job periódico do estágio (I20).
SESSION_DURATION_HOURS=12

# Tempo máximo que a aplicação gasta em uma requisição, em milissegundos (I14):
# sempre menor que o timeout de quem estiver na frente. Sem balanceador ainda,
# mas o número já é explícito para não ser descoberto no primeiro incidente.
HTTP_TIMEOUT_MS=25000

# Proxies confiáveis, separados por vírgula (I12). Fica vazio no Estágio 01: sem proxy
# confiável a aplicação ignora X-Forwarded-For e usa o endereço remoto da conexão.
# Quando CDN e balanceador entrarem, muda esta variável — não o código.
TRUSTED_PROXIES=

# Nível mínimo de log: debug | info | warn | error. O log é JSON em stdout, sem dado
# pessoal e sem segredo (I17); quem coleta é o ambiente, não a aplicação.
LOG_LEVEL=info

# Marca o cookie de sessão como Secure. Default: true quando APP_ENV=production.
# Em desenvolvimento fica false porque o servidor local não tem TLS.
SECURE_COOKIE=false

# Origens autorizadas a falar com a API por CORS, separadas por vírgula. Vazio significa
# mesma origem: nenhum cabeçalho de CORS é emitido, que é o arranjo deste estágio.
# Preencha no dia em que o front for publicado à parte.
ALLOWED_ORIGINS=

# Domínio do cookie de sessão. Vazio significa host-only — o cookie só volta para o host
# que o emitiu. Preencha com .seudominio.com.br quando o front e a API forem subdomínios
# distintos do mesmo site.
#
# Cuidado com o que este par NÃO resolve: front e API em domínios registráveis diferentes
# (por exemplo pages.dev e seudominio.com.br) são cross-site, e com SameSite=Lax o navegador
# não manda cookie nenhum em XHR — a API veria toda requisição como anônima, por mais
# permissivo que ALLOWED_ORIGINS esteja. Esse cenário exige SameSite=None com Secure, que
# hoje é constante no código e não variável de ambiente.
COOKIE_DOMAIN=

# Onde está o `dist` do front — a mesma aplicação serve a API e as telas. Vazio significa
# apps/web/dist, contado a partir da raiz do repositório, que é onde `bun run build:web`
# publica. A imagem Docker preenche com /app/front, porque lá o código do front não existe:
# só o build dele. Se a pasta não existir, todo caminho de tela responde 404 — o servidor
# prefere dizer que não tem o front a entregar um documento vazio.
FRONT_PATH=
