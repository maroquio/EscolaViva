<%
const reportCard = it.reportCard;

const criteria = it.criteria;

const STATUS_CLASS = it.tagClass.finalStatus;

const STATUS_LABEL = it.statusLabel;
%>
<header class="page__header">
  <div>
    <p class="overline">Boletim</p>
    <h1 class="page__title"><%= reportCard.studentName %></h1>
    <p class="page__summary">
      <%= it.labels.classGroup %> <%= reportCard.classGroupName %><%= it.presentation.separator %>ano letivo <span class="number"><%= reportCard.year %></span>
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--secondary"
       href="<%= it.routes.guardian.attendance({ id: it.enrollmentId }) %>">Ver frequência</a>
    <a class="button button--quiet" href="<%= it.routes.guardian.dashboard() %>"><%= it.actions.backTo.students %></a>
  </p>
</header>

<section class="section" aria-labelledby="result-title">
  <div class="section__header">
    <h2 id="result-title">Resultado do ano</h2>
    <p class="section__note">Apurado a cada leitura, a partir das notas e da chamada</p>
  </div>

  <div class="stack">
    <div class="dashboard">
      <div class="card">
        <p class="card__label">Média geral</p>
        <p class="card__number"><%= it.formatGrade(reportCard.overallAverage) %></p>
        <p class="card__detail">Média simples das disciplinas cursadas</p>
      </div>

      <div class="card">
        <p class="card__label"><%= it.labels.attendance %></p>
        <p class="card__number"><%= it.formatPercent(reportCard.attendanceRate) %></p>
        <p class="card__detail">
          <span class="number"><%= reportCard.presentDays %></span> de
          <span class="number"><%= reportCard.totalDays %></span> dias com chamada registrada
        </p>
      </div>

      <div class="card">
<% // magic-values: permitido — a generic noun heading five distinct state vocabularies; it is not the label of a single datum, and for that reason it does not belong in LABELS %>
        <p class="card__label">Situação</p>
        <p>
          <span class="tag <%= STATUS_CLASS[reportCard.status] %>">
            <%= STATUS_LABEL[reportCard.status] %>
          </span>
        </p>
        <p class="card__detail">Critério: média <%= criteria.average %> e frequência <%= criteria.attendance %></p>
      </div>
    </div>

    <p class="muted">
      A situação sai destes dois números: é aprovado quem termina o ano com média final de
      <strong><%= criteria.average %> ou mais</strong> e frequência de <strong><%= criteria.attendance %> ou mais</strong> — as duas
      condições ao mesmo tempo. Enquanto algum bimestre não estiver fechado, ou faltar nota em
      alguma disciplina, o ano permanece em curso e ninguém é reprovado por lançamento que ainda
      não aconteceu.
    </p>
  </div>
</section>

<section class="section" aria-labelledby="grades-title">
  <div class="section__header">
    <h2 id="grades-title">Notas por disciplina</h2>
    <p class="section__note">O travessão marca bimestre sem nota lançada</p>
  </div>

  <% if (reportCard.rows.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma disciplina alocada nesta turma',
      text: 'A turma ainda não tem professor alocado em nenhuma disciplina, então não há nota a mostrar. A secretaria da unidade faz essa alocação.',
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Notas de <%= reportCard.studentName %> em <%= reportCard.year %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.subject %></th>
          <% it.terms.forEach((term) => { %>
          <th scope="col" class="cell-center"><%= it.termLabel(term) %></th>
          <% }) %>
          <th scope="col" class="cell-center">Média anual</th>
        </tr>
      </thead>
      <tbody>
        <% reportCard.rows.forEach((row) => { %>
        <tr>
          <th scope="row"><%= row.subjectName %></th>
          <% row.grades.forEach((grade) => { %>
          <td class="number cell-center"><%= it.formatGrade(grade) %></td>
          <% }) %>
          <td class="number cell-center"><%= it.formatGrade(row.average) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Médias</th>
          <% reportCard.termAverages.forEach((termAverage) => { %>
          <td class="number cell-center"><%= it.formatGrade(termAverage) %></td>
          <% }) %>
          <td class="number cell-center"><%= it.formatGrade(reportCard.overallAverage) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</section>
