<%
const reportCard = it.reportCard;

const criteria = it.criteria;

const STATUS_CLASS = it.tagClass.finalStatus;

const STATUS_LABEL = it.statusLabel;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Boletim</p>
    <h1 class="pagina__titulo"><%= reportCard.studentName %></h1>
    <p class="pagina__resumo">
      <%= it.labels.classGroup %> <%= reportCard.classGroupName %><%= it.presentation.separator %>ano letivo <span class="numero"><%= reportCard.year %></span>
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario"
       href="<%= it.routes.guardian.attendance({ id: it.enrollmentId }) %>">Ver frequência</a>
    <a class="botao botao--discreto" href="<%= it.routes.guardian.dashboard() %>"><%= it.actions.backTo.students %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resultado">
  <div class="secao__cabecalho">
    <h2 id="titulo-resultado">Resultado do ano</h2>
    <p class="secao__nota">Apurado a cada leitura, a partir das notas e da chamada</p>
  </div>

  <div class="pilha">
    <div class="painel">
      <div class="cartao">
        <p class="cartao__rotulo">Média geral</p>
        <p class="cartao__numero"><%= it.formatGrade(reportCard.overallAverage) %></p>
        <p class="cartao__detalhe">Média simples das disciplinas cursadas</p>
      </div>

      <div class="cartao">
        <p class="cartao__rotulo"><%= it.labels.attendance %></p>
        <p class="cartao__numero"><%= it.formatPercent(reportCard.attendanceRate) %></p>
        <p class="cartao__detalhe">
          <span class="numero"><%= reportCard.presentDays %></span> de
          <span class="numero"><%= reportCard.totalDays %></span> dias com chamada registrada
        </p>
      </div>

      <div class="cartao">
<% // magic-values: permitido — substantivo genérico que encabeça cinco vocabulários de estado distintos; não é o rótulo de um dado só, e por isso não entra em LABELS %>
        <p class="cartao__rotulo">Situação</p>
        <p>
          <span class="etiqueta <%= STATUS_CLASS[reportCard.status] %>">
            <%= STATUS_LABEL[reportCard.status] %>
          </span>
        </p>
        <p class="cartao__detalhe">Critério: média <%= criteria.average %> e frequência <%= criteria.attendance %></p>
      </div>
    </div>

    <p class="suave">
      A situação sai destes dois números: é aprovado quem termina o ano com média final de
      <strong><%= criteria.average %> ou mais</strong> e frequência de <strong><%= criteria.attendance %> ou mais</strong> — as duas
      condições ao mesmo tempo. Enquanto algum bimestre não estiver fechado, ou faltar nota em
      alguma disciplina, o ano permanece em curso e ninguém é reprovado por lançamento que ainda
      não aconteceu.
    </p>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-notas">
  <div class="secao__cabecalho">
    <h2 id="titulo-notas">Notas por disciplina</h2>
    <p class="secao__nota">O travessão marca bimestre sem nota lançada</p>
  </div>

  <% if (reportCard.rows.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma disciplina alocada nesta turma',
      text: 'A turma ainda não tem professor alocado em nenhuma disciplina, então não há nota a mostrar. A secretaria da unidade faz essa alocação.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Notas de <%= reportCard.studentName %> em <%= reportCard.year %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.subject %></th>
          <% it.terms.forEach((term) => { %>
          <th scope="col" class="celula-centro"><%= it.termLabel(term) %></th>
          <% }) %>
          <th scope="col" class="celula-centro">Média anual</th>
        </tr>
      </thead>
      <tbody>
        <% reportCard.rows.forEach((row) => { %>
        <tr>
          <th scope="row"><%= row.subjectName %></th>
          <% row.grades.forEach((grade) => { %>
          <td class="numero celula-centro"><%= it.formatGrade(grade) %></td>
          <% }) %>
          <td class="numero celula-centro"><%= it.formatGrade(row.average) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Médias</th>
          <% reportCard.termAverages.forEach((termAverage) => { %>
          <td class="numero celula-centro"><%= it.formatGrade(termAverage) %></td>
          <% }) %>
          <td class="numero celula-centro"><%= it.formatGrade(reportCard.overallAverage) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</section>
