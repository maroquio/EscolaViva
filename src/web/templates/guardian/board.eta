<%
const unread = it.unread;
const read = it.read;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.monitoring %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      O que a escola enviou a você. Cada comunicado abre por inteiro e pode ser marcado como lido.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.routes.guardian.dashboard() %>"><%= it.actions.backTo.students %></a>
  </p>
</header>

<section class="secao" aria-labelledby="unread-title">
  <div class="secao__cabecalho">
    <h2 id="unread-title">Não lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.unreadTotal %></span>
      <%= it.pluralize(it.unreadTotal, it.nouns.announcement) %>
    </p>
  </div>

  <% if (unread.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nada por ler',
      text: 'Todos os comunicados enviados a você já foram marcados como lidos.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% unread.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.routes.guardian.announcement({ announcementId: item.announcementId }) %>"><%= item.title %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publishedAt %>">
            <%= it.formatDateTime(item.publishedAt) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.partials.pagination, {
    pagination: it.unreadPagination, label: 'comunicados não lidos'
  }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="read-title">
  <div class="secao__cabecalho">
    <h2 id="read-title">Já lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.readTotal %></span>
      <%= it.pluralize(it.readTotal, it.nouns.announcement) %>
    </p>
  </div>

  <% if (read.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum comunicado marcado como lido',
      text: 'Ao abrir um comunicado, use o botão "Marcar como lido" para que a escola saiba que a mensagem chegou.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% read.forEach((item) => { %>
    <li class="linha">
      <a href="<%= it.routes.guardian.announcement({ announcementId: item.announcementId }) %>"><%= item.title %></a>
      <span class="suave">
        publicado em
        <time datetime="<%= item.publishedAt %>"><%= it.formatDate(item.publishedAt) %></time>
       <%= it.presentation.separator %>lido em
        <time datetime="<%= item.readAt %>"><%= it.formatDateTime(item.readAt) %></time>
      </span>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.partials.pagination, {
    pagination: it.readPagination, label: 'comunicados lidos'
  }) %>
  <% } %>
</section>
