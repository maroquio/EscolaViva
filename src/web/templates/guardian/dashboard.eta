<%
const enrollments = it.enrollments;
const unread = it.unread;

const STATUS_CLASS = it.tagClass.guardianEnrollment;

const STATUS_LABEL = it.statusLabel;
%>
<header class="page__header">
  <div>
    <p class="overline"><%= it.areas.monitoring %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Boletim, frequência e comunicados dos alunos sob sua responsabilidade.
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.guardian.board() %>">Abrir o mural</a>
  </p>
</header>

<section class="section" aria-labelledby="summary-title">
  <h2 class="visually-hidden" id="summary-title">Resumo</h2>

  <div class="dashboard">
    <div class="card">
      <p class="card__label">Alunos acompanhados</p>
      <p class="card__number"><%= it.pagination === undefined ? enrollments.length : it.pagination.total %></p>
      <p class="card__detail">Matrículas ligadas ao seu cadastro</p>
    </div>

    <a class="card" href="<%= it.routes.guardian.board() %>">
      <span class="card__label">Comunicados não lidos</span>
      <span class="card__number"><%= it.unreadTotal %></span>
      <span class="card__detail">
        <%= it.boardTotal %> <%= it.pluralize(it.boardTotal, it.nouns.announcement) %> no mural
      </span>
    </a>
  </div>
</section>

<section class="section" aria-labelledby="students-title">
  <div class="section__header">
    <h2 id="students-title">Alunos</h2>
    <p class="section__note">Uma matrícula por ano letivo</p>
  </div>

  <% if (enrollments.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum aluno vinculado à sua conta',
      text: 'O vínculo entre você e o aluno é feito pela secretaria da unidade. Enquanto ele não existir, esta tela fica vazia — procure a secretaria da escola para conferir seu cadastro.',
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Matrículas sob sua responsabilidade</caption>
      <thead>
        <tr>
          <th class="cell-elastic" scope="col"><%= it.labels.student %></th>
          <th class="cell-center" scope="col"><%= it.labels.classGroup %></th>
          <th class="cell-center" scope="col"><%= it.labels.year %></th>
          <th class="cell-center" scope="col"><%= it.labels.enrollment %></th>
          <th class="cell-center" scope="col">Acompanhar</th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach((enrollment) => { %>
        <tr>
          <th class="cell-elastic" scope="row"><%= enrollment.studentName %></th>
          <td class="cell-center"><%= enrollment.classGroupName %></td>
          <td class="number cell-center"><%= enrollment.year %></td>
          <td class="cell-center">
            <span class="tag <%= STATUS_CLASS[enrollment.status] %>">
              <%= STATUS_LABEL[enrollment.status] %>
            </span>
          </td>
          <td class="cell-center">
            <span class="table__actions">
                            <a class="button button--secondary button--small"
                 href="<%= it.routes.guardian.reportCard({ id: enrollment.id }) %>">
                Boletim<span class="visually-hidden"> de <%= enrollment.studentName %></span></a>
              <a class="button button--secondary button--small"
                 href="<%= it.routes.guardian.attendance({ id: enrollment.id }) %>">
<% // magic-values: allowed — the label of the link that opens the attendance screen, twin of the "Boletim" on the line above; it is not `LABELS.attendance`, which names the RATE on the report card %>
                Frequência<span class="visually-hidden"> de <%= enrollment.studentName %></span></a>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.enrollment.plural }) %>
  <% } %>
</section>

<section class="section" aria-labelledby="unread-title">
  <div class="section__header">
    <h2 id="unread-title">Comunicados não lidos</h2>
    <p class="section__note"><a href="<%= it.routes.guardian.board() %>">Ver o mural completo</a></p>
  </div>

  <% if (unread.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nada por ler',
      text: 'Todos os comunicados enviados a você já foram marcados como lidos.',
      action: { href: it.routes.guardian.board(), text: 'Ver comunicados anteriores' },
    }) %>
  <% } else { %>
  <ul class="stack">
    <% unread.forEach((item) => { %>
    <li class="panel">
      <div class="row row--between">
        <h3>
          <a href="<%= it.routes.guardian.announcement({ announcementId: item.announcementId }) %>"><%= item.title %></a>
        </h3>
        <span class="row">
          <time class="muted" datetime="<%= item.publishedAt %>">
            <%= it.formatDateTime(item.publishedAt) %>
          </time>
          <span class="tag tag--in-progress">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
