<%
const enrollments = it.enrollments;
const unread = it.unread;

const STATUS_CLASS = it.tagClass.guardianEnrollment;

const STATUS_LABEL = it.statusLabel;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.monitoring %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Boletim, frequência e comunicados dos alunos sob sua responsabilidade.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.routes.guardian.board() %>">Abrir o mural</a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resumo">
  <h2 class="visualmente-oculto" id="titulo-resumo">Resumo</h2>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo">Alunos acompanhados</p>
      <p class="cartao__numero"><%= it.pagination === undefined ? enrollments.length : it.pagination.total %></p>
      <p class="cartao__detalhe">Matrículas ligadas ao seu cadastro</p>
    </div>

    <a class="cartao" href="<%= it.routes.guardian.board() %>">
      <span class="cartao__rotulo">Comunicados não lidos</span>
      <span class="cartao__numero"><%= it.unreadTotal %></span>
      <span class="cartao__detalhe">
        <%= it.boardTotal %> <%= it.pluralize(it.boardTotal, it.nouns.announcement) %> no mural
      </span>
    </a>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-alunos">
  <div class="secao__cabecalho">
    <h2 id="titulo-alunos">Alunos</h2>
    <p class="secao__nota">Uma matrícula por ano letivo</p>
  </div>

  <% if (enrollments.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum aluno vinculado à sua conta',
      text: 'O vínculo entre você e o aluno é feito pela secretaria da unidade. Enquanto ele não existir, esta tela fica vazia — procure a secretaria da escola para conferir seu cadastro.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Matrículas sob sua responsabilidade</caption>
      <thead>
        <tr>
          <th class="celula-elastica" scope="col"><%= it.labels.student %></th>
          <th class="celula-centro" scope="col"><%= it.labels.classGroup %></th>
          <th class="celula-centro" scope="col"><%= it.labels.year %></th>
          <th class="celula-centro" scope="col"><%= it.labels.enrollment %></th>
          <th class="celula-centro" scope="col">Acompanhar</th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach((enrollment) => { %>
        <tr>
          <th class="celula-elastica" scope="row"><%= enrollment.studentName %></th>
          <td class="celula-centro"><%= enrollment.classGroupName %></td>
          <td class="numero celula-centro"><%= enrollment.year %></td>
          <td class="celula-centro">
            <span class="etiqueta <%= STATUS_CLASS[enrollment.status] %>">
              <%= STATUS_LABEL[enrollment.status] %>
            </span>
          </td>
          <td class="celula-centro">
            <span class="tabela__acoes">
                            <a class="botao botao--secundario botao--miudo"
                 href="<%= it.routes.guardian.reportCard({ id: enrollment.id }) %>">
                Boletim<span class="visualmente-oculto"> de <%= enrollment.studentName %></span></a>
              <a class="botao botao--secundario botao--miudo"
                 href="<%= it.routes.guardian.attendance({ id: enrollment.id }) %>">
<% // magic-values: permitido — rótulo do link que abre a tela de frequência, par do "Boletim" da linha acima; não é `LABELS.attendance`, que nomeia a TAXA no cartão do boletim %>
                Frequência<span class="visualmente-oculto"> de <%= enrollment.studentName %></span></a>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.enrollment.plural }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-nao-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-nao-lidos">Comunicados não lidos</h2>
    <p class="secao__nota"><a href="<%= it.routes.guardian.board() %>">Ver o mural completo</a></p>
  </div>

  <% if (unread.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nada por ler',
      text: 'Todos os comunicados enviados a você já foram marcados como lidos.',
      action: { href: it.routes.guardian.board(), text: 'Ver comunicados anteriores' },
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% unread.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.routes.guardian.announcement({ comunicadoId: item.announcementId }) %>"><%= item.title %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publishedAt %>">
            <%= it.formatDateTime(item.publishedAt) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
