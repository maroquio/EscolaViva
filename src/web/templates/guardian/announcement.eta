<%
const announcement = it.announcement;
const readAt = it.readAt;
%>
<header class="page__header">
  <div>
    <p class="overline">Comunicado</p>
    <h1 class="page__title"><%= announcement.title %></h1>
    <p class="page__summary">
      Publicado por <%= announcement.authorName %> em
      <time datetime="<%= announcement.publishedAt %>">
        <%= it.formatDateTime(announcement.publishedAt) %>
      </time>
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--quiet" href="<%= it.routes.guardian.board() %>"><%= it.actions.backTo.board %></a>
  </p>
</header>

<article class="stack">
  <div class="panel reading">
    <p class="running-text"><%= announcement.body %></p>
  </div>

  <footer class="actions">
    <% if (readAt === null) { %>
    <form method="post" action="<%= it.routes.guardian.announcementRead({ announcementId: announcement.id }) %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <button class="button button--primary" type="submit">Marcar como lido</button>
    </form>
    <p class="muted">
      Marcar como lido avisa a escola de que a mensagem chegou até você.
    </p>
    <% } else { %>
    <p class="row">
      <span class="tag tag--passed">Lido</span>
      <span class="muted">
        em <time datetime="<%= readAt %>"><%= it.formatDateTime(readAt) %></time>
      </span>
    </p>
    <% } %>
  </footer>
</article>
