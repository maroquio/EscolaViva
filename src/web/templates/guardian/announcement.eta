<%
const announcement = it.announcement;
const readAt = it.readAt;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Comunicado</p>
    <h1 class="pagina__titulo"><%= announcement.title %></h1>
    <p class="pagina__resumo">
      Publicado por <%= announcement.authorName %> em
      <time datetime="<%= announcement.publishedAt %>">
        <%= it.formatDateTime(announcement.publishedAt) %>
      </time>
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.routes.guardian.board() %>"><%= it.actions.backTo.board %></a>
  </p>
</header>

<article class="pilha">
  <div class="quadro leitura">
    <p class="texto-corrido"><%= announcement.body %></p>
  </div>

  <footer class="acoes">
    <% if (readAt === null) { %>
    <form method="post" action="<%= it.routes.guardian.announcementRead({ comunicadoId: announcement.id }) %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <button class="botao botao--primario" type="submit">Marcar como lido</button>
    </form>
    <p class="suave">
      Marcar como lido avisa a escola de que a mensagem chegou até você.
    </p>
    <% } else { %>
    <p class="linha">
      <span class="etiqueta etiqueta--aprovado">Lido</span>
      <span class="suave">
        em <time datetime="<%= readAt %>"><%= it.formatDateTime(readAt) %></time>
      </span>
    </p>
    <% } %>
  </footer>
</article>
