<%
const reportCard = it.reportCard;
const days = it.days;
const absences = reportCard.totalDays - reportCard.presentDays;

const ATTENDANCE_LABEL = it.attendanceLabel;

const ATTENDANCE_CLASS = it.tagClass.attendance;

const MISSING = it.missingValue;

const CRITERIA = it.criteria;

const dayStatus = (day) => {
  if (day.present) {
    return { className: ATTENDANCE_CLASS.present, label: ATTENDANCE_LABEL.present };
  }
  if (day.excuse) {
    return {
      className: ATTENDANCE_CLASS.excusedAbsence,
      label: ATTENDANCE_LABEL.excusedAbsence,
    };
  }
  return { className: ATTENDANCE_CLASS.absence, label: ATTENDANCE_LABEL.absence };
};
%>
<header class="page__header">
  <div>
    <p class="overline">Frequência</p>
    <h1 class="page__title"><%= it.enrollment.studentName %></h1>
    <p class="page__summary">
      Turma <%= it.enrollment.classGroupName %><%= it.presentation.separator %>ano letivo
      <span class="number"><%= it.enrollment.year %></span>
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--secondary"
       href="<%= it.routes.guardian.reportCard({ id: it.enrollment.id }) %>">Ver boletim</a>
    <a class="button button--quiet" href="<%= it.routes.guardian.dashboard() %>"><%= it.actions.backTo.students %></a>
  </p>
</header>

<section class="section" aria-labelledby="tally-title">
  <div class="section__header">
    <h2 id="tally-title">Apuração do ano</h2>
    <p class="section__note">São necessários <%= CRITERIA.attendance %> de presença para aprovação</p>
  </div>

  <div class="dashboard">
    <div class="card">
      <p class="card__label"><%= it.labels.attendance %></p>
      <p class="card__number"><%= it.formatPercent(reportCard.attendanceRate) %></p>
      <p class="card__detail">Presenças sobre dias com chamada</p>
    </div>

    <div class="card">
      <p class="card__label">Presenças</p>
      <p class="card__number"><%= reportCard.presentDays %></p>
      <p class="card__detail">
        de <span class="number"><%= reportCard.totalDays %></span> dias registrados
      </p>
    </div>

    <div class="card">
      <p class="card__label">Faltas</p>
      <p class="card__number"><%= absences %></p>
      <p class="card__detail">Justificadas e não justificadas</p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="days-title">
  <div class="section__header">
    <h2 id="days-title">Dia a dia</h2>
    <p class="section__note">Do dia mais recente para o mais antigo</p>
  </div>

  <% if (days.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum dia de chamada registrado',
      text: 'A frequência aparece aqui assim que o professor registrar a primeira chamada da turma.',
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Chamada de <%= it.enrollment.studentName %></caption>
      <thead>
        <tr>
          <th scope="col" class="cell-center">Data</th>
<%
// magic-values: permitido — cabeça genérica de cinco vocabulários de estado distintos; por isso não é membro de `it.labels`. %>
          <th scope="col" class="cell-center">Situação</th>
          <th scope="col" class="cell-text cell-elastic">Justificativa</th>
        </tr>
      </thead>
      <tbody>
        <% days.forEach((day) => { const status = dayStatus(day); %>
        <tr>
          <th scope="row" class="cell-center">
            <time datetime="<%= day.date %>"><%= it.formatDate(day.date) %></time>
          </th>
          <td class="cell-center">
            <span class="tag <%= status.className %>"><%= status.label %></span>
          </td>
          <td class="cell-text cell-elastic">
            <%= day.excuse ? day.excuse : MISSING %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: 'dias registrados' }) %>
  <% } %>
</section>
