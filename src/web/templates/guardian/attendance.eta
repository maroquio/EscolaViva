<%
const reportCard = it.reportCard;
const days = it.days;
const absences = reportCard.totalDays - reportCard.presentDays;

const ATTENDANCE_LABEL = it.attendanceLabel;

const ATTENDANCE_CLASS = it.tagClass.attendance;

const MISSING = it.missingValue;

const CRITERIA = it.criteria;

const dayStatus = (day) => {
  if (day.present) {
    return { className: ATTENDANCE_CLASS.present, label: ATTENDANCE_LABEL.present };
  }
  if (day.excuse) {
    return {
      className: ATTENDANCE_CLASS.excusedAbsence,
      label: ATTENDANCE_LABEL.excusedAbsence,
    };
  }
  return { className: ATTENDANCE_CLASS.absence, label: ATTENDANCE_LABEL.absence };
};
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Frequência</p>
    <h1 class="pagina__titulo"><%= it.enrollment.studentName %></h1>
    <p class="pagina__resumo">
      Turma <%= it.enrollment.classGroupName %><%= it.presentation.separator %>ano letivo
      <span class="numero"><%= it.enrollment.year %></span>
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario"
       href="<%= it.routes.guardian.reportCard({ id: it.enrollment.id }) %>">Ver boletim</a>
    <a class="botao botao--discreto" href="<%= it.routes.guardian.dashboard() %>"><%= it.actions.backTo.students %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-apuracao">
  <div class="secao__cabecalho">
    <h2 id="titulo-apuracao">Apuração do ano</h2>
    <p class="secao__nota">São necessários <%= CRITERIA.attendance %> de presença para aprovação</p>
  </div>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo"><%= it.labels.attendance %></p>
      <p class="cartao__numero"><%= it.formatPercent(reportCard.attendanceRate) %></p>
      <p class="cartao__detalhe">Presenças sobre dias com chamada</p>
    </div>

    <div class="cartao">
      <p class="cartao__rotulo">Presenças</p>
      <p class="cartao__numero"><%= reportCard.presentDays %></p>
      <p class="cartao__detalhe">
        de <span class="numero"><%= reportCard.totalDays %></span> dias registrados
      </p>
    </div>

    <div class="cartao">
      <p class="cartao__rotulo">Faltas</p>
      <p class="cartao__numero"><%= absences %></p>
      <p class="cartao__detalhe">Justificadas e não justificadas</p>
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-dias">
  <div class="secao__cabecalho">
    <h2 id="titulo-dias">Dia a dia</h2>
    <p class="secao__nota">Do dia mais recente para o mais antigo</p>
  </div>

  <% if (days.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum dia de chamada registrado',
      text: 'A frequência aparece aqui assim que o professor registrar a primeira chamada da turma.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Chamada de <%= it.enrollment.studentName %></caption>
      <thead>
        <tr>
          <th scope="col" class="celula-centro">Data</th>
<%
// magic-values: permitido — cabeça genérica de cinco vocabulários de estado distintos; por isso não é membro de `it.labels`. %>
          <th scope="col" class="celula-centro">Situação</th>
          <th scope="col" class="celula-texto celula-elastica">Justificativa</th>
        </tr>
      </thead>
      <tbody>
        <% days.forEach((day) => { const status = dayStatus(day); %>
        <tr>
          <th scope="row" class="celula-centro">
            <time datetime="<%= day.date %>"><%= it.formatDate(day.date) %></time>
          </th>
          <td class="celula-centro">
            <span class="etiqueta <%= status.className %>"><%= status.label %></span>
          </td>
          <td class="celula-texto celula-elastica">
            <%= day.excuse ? day.excuse : MISSING %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: 'dias registrados' }) %>
  <% } %>
</section>
