<%
/*
  Navegação por papel: cada grupo só aparece para quem tem o papel que o abre. Não existe item
  desabilitado nem tela que responde 403 depois do clique — o menu é a lista do que a pessoa
  realmente pode fazer.

  Os catorze endereços vêm de `it.rotas`, o mesmo mapa que o router registra. Escritos à mão, eles
  eram a maior concentração de URL literal do sistema: renomear `/rede/anos-letivos` quebrava este
  menu em silêncio, porque `.eta` não passa pelo compilador e link quebrado só aparece no clique.

  Os RÓTULOS e os PAPÉIS chegam pelo mesmo caminho, e pelo mesmo motivo. Treze dos catorze links
  levam a uma tela que já tem título em `TITULOS`, e o rótulo do link é esse título: escrevê-lo de
  novo aqui deixava o sistema livre para chamar a mesma tela de "Anos letivos" no menu e de outra
  coisa no `<h1>` que o menu abre. Os quatro papéis que abrem cada grupo são de `PAPEL`
  (`identidade`), o mesmo vocabulário que a sessão carrega em `usuario.papeis` — um `'secretria'`
  digitado aqui não falha em lugar nenhum: o grupo apenas some do menu de quem tem o papel.

  O NOME DE CADA GRUPO vem de `it.areas` pelo mesmo motivo, e é o mesmo texto que as telas daquele
  grupo imprimem no sobretítulo: o sobretítulo existe justamente para dizer em que parte deste menu
  a pessoa está, então "Rede" aqui e "Rede" lá em cima da tela de unidades são a mesma decisão. Se
  fossem dois literais, renomear o grupo para "Rede de ensino" deixaria o menu dizendo uma coisa e a
  tela que ele abre dizendo outra, sem nada quebrar.

  As três coisas chegam como `it.titulos`, `it.papel` e `it.areas`, injetadas por `render.ts`. Não podiam vir do
  handler: este parcial é incluído pelo `_layout`, que é escolhido pelo próprio `render.ts` a partir
  da sessão, e nenhuma rota sabe que ele existe para se lembrar de alimentá-lo. `it.titulo`, no
  singular, continua sendo outra coisa — o título DESTA página, que a rota passa.

  "Mural" é o único rótulo que fica escrito: `TITULOS.responsavel.mural` é "Mural de comunicados",
  e a barra lateral é estreita demais para ele. São dois textos diferentes, e não uma cópia.

  `aria-current="page"` marca UM item: o de caminho mais longo que casa com a URL atual, para que
  `/secretaria/alunos` não acenda também `/secretaria`. A comparação é feita sobre o mesmo `href`
  que sai do mapa, então o destaque acompanha qualquer renomeação de rota sem retoque aqui.
*/
const usuario = it.usuario;
const papeis = new Set(usuario === null ? [] : usuario.papeis.map((p) => p.papel));

/* Trocar a própria senha não é privilégio de papel nenhum: o grupo "Conta" vale para os quatro. */
const QUALQUER_PAPEL = Object.values(it.papel);

const grupos = [
  { titulo: it.areas.rede, papeis: [it.papel.adminRede], itens: [
    { href: it.rotas.rede.painel(), texto: it.titulos.rede.painel },
    { href: it.rotas.rede.unidades(), texto: it.titulos.rede.unidades },
    { href: it.rotas.rede.usuarios(), texto: it.titulos.rede.usuarios },
    { href: it.rotas.rede.anosLetivos(), texto: it.titulos.rede.anos },
  ] },
  { titulo: it.areas.secretaria, papeis: [it.papel.secretaria], itens: [
    { href: it.rotas.secretaria.painel(), texto: it.titulos.secretaria.painel },
    { href: it.rotas.secretaria.alunos(), texto: it.titulos.secretaria.alunos },
    { href: it.rotas.secretaria.responsaveis(), texto: it.titulos.secretaria.responsaveis },
    { href: it.rotas.secretaria.turmas(), texto: it.titulos.secretaria.turmas },
    { href: it.rotas.secretaria.disciplinas(), texto: it.titulos.secretaria.disciplinas },
  ] },
  { titulo: it.areas.ensino, papeis: [it.papel.professor], itens: [
    { href: it.rotas.professor.painel(), texto: it.titulos.professor.painel },
  ] },
  { titulo: it.areas.acompanhamento, papeis: [it.papel.responsavel], itens: [
    { href: it.rotas.responsavel.painel(), texto: it.titulos.responsavel.painel },
    { href: it.rotas.responsavel.mural(), texto: 'Mural' },
  ] },
  { titulo: it.areas.comunicacao, papeis: [it.papel.adminRede, it.papel.secretaria], itens: [
    { href: it.rotas.comunicados.lista(), texto: it.titulos.comunicados.lista },
  ] },
  { titulo: it.areas.conta, papeis: QUALQUER_PAPEL, itens: [
    { href: it.rotas.conta.senha(), texto: it.titulos.trocarSenha },
  ] },
].filter((grupo) => grupo.papeis.some((papel) => papeis.has(papel)));

const caminho = it.caminhoAtual ?? '';
const candidatos = grupos
  .flatMap((grupo) => grupo.itens.map((item) => item.href))
  // O `/` abaixo delimita o segmento: é ele que faz `/secretaria` casar com `/secretaria/alunos` e
  // não com `/secretariaX`. Os dois lados da comparação já saem de `ROTAS`; o que sobra é a barra.
  .filter((href) => caminho === href || caminho.startsWith(href + '/'));
const atual = candidatos.sort((a, b) => b.length - a.length)[0] ?? '';
%>
<nav class="navegacao" aria-label="Navegação principal">
  <% grupos.forEach((grupo) => { %>
  <div class="navegacao__grupo">
    <h2 class="navegacao__titulo"><%= grupo.titulo %></h2>
    <ul class="navegacao__lista">
      <% grupo.itens.forEach((item) => { %>
      <li>
        <a class="navegacao__link" href="<%= item.href %>"<% if (item.href === atual) { %> aria-current="page"<% } %>><%= item.texto %></a>
      </li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
</nav>
