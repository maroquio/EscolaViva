<%
const correlationId = it.correlationId ?? '';
%>
<div class="error">
  <div>
    <p class="error__status">Erro <%= it.status %></p>
    <h1><%= it.title %></h1>
  </div>

  <p class="reading"><%= it.detail %></p>

  <% if (correlationId !== '') { %>
  <div class="error__occurrence">
    <dl class="definition-list">
      <dt>Ocorrência</dt>
      <dd><code class="code"><%= correlationId %></code></dd>
    </dl>
    <p class="error__instruction">
      Informe este código ao pedir ajuda: ele localiza exatamente esta ocorrência no registro do sistema.
    </p>
  </div>
  <% } %>

  <p class="row">
    <a class="button button--secondary" href="<%= it.routes.public.dashboard() %>"><%= it.actions.backTo.dashboard %></a>
    <a class="button button--quiet" href="<%= it.routes.public.login() %>">Entrar novamente</a>
  </p>
</div>
