<%
const anos = it.anos ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.rede %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O ano letivo delimita as matrículas: um aluno tem uma matrícula ativa por ano, e é esse
      recorte que o boletim e a frequência usam.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.rotas.rede.anoLetivoNovo() %>"><%= it.titulos.rede.anoNovo %></a>
  </div>
</div>

<section class="secao" aria-labelledby="lista-anos-titulo">
  <div class="secao__cabecalho">
    <h2 id="lista-anos-titulo">Anos definidos</h2>
    <p class="secao__nota">Do mais recente para o mais antigo</p>
  </div>

  <% if (anos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum ano letivo definido',
      texto: 'Enquanto não houver um ano definido, a secretaria não consegue criar turmas nem matricular alunos.',
      acao: { href: it.rotas.rede.anoLetivoNovo(), texto: it.titulos.rede.anoNovo }
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Calendário letivo da rede</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.rotulos.ano %></th>
          <th scope="col"><%= it.rotulos.inicio %></th>
          <th scope="col"><%= it.rotulos.termino %></th>
        </tr>
      </thead>
      <tbody>
        <% anos.forEach((anoLetivo) => { %>
        <tr>
          <th scope="row" class="numero"><%= anoLetivo.ano %></th>
          <td class="numero"><%= it.formatarData(anoLetivo.dataInicio) %></td>
          <td class="numero"><%= it.formatarData(anoLetivo.dataFim) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: it.contagem.anoLetivo.plural }) %>
  <% } %>
</section>
