<%
/*
  Anos letivos da rede: a lista, e só. O formulário mora em `it.rotas.rede.anoLetivoNovo()`.

  É o calendário que sustenta turma e matrícula: sem ano definido, a secretaria não tem onde
  matricular ninguém.

  Datas aparecem em fonte monoespaçada, como todo número desta interface, para que a coluna possa
  ser comparada de relance.

  Os dois caminhos para o formulário — o botão do cabeçalho e a ação do estado vazio — levam ao
  mesmo lugar e saem de `it.rotas`, o mesmo mapa que o router registra. Escritos à mão, seriam duas
  cópias do endereço que podem divergir de um lado só, e URL literal em `.eta` não quebra
  compilação: quebra a tela de quem clica.

  Os caminhos das parciais incluídas seguem a mesma regra: chegam em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo.
*/
const anos = it.anos ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Rede</p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O ano letivo delimita as matrículas: um aluno tem uma matrícula ativa por ano, e é esse
      recorte que o boletim e a frequência usam.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.rotas.rede.anoLetivoNovo() %>">Definir ano letivo</a>
  </div>
</div>

<section class="secao" aria-labelledby="lista-anos-titulo">
  <div class="secao__cabecalho">
    <h2 id="lista-anos-titulo">Anos definidos</h2>
    <p class="secao__nota">Do mais recente para o mais antigo</p>
  </div>

  <% if (anos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum ano letivo definido',
      texto: 'Enquanto não houver um ano definido, a secretaria não consegue criar turmas nem matricular alunos.',
      acao: { href: it.rotas.rede.anoLetivoNovo(), texto: 'Definir ano letivo' }
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Calendário letivo da rede</caption>
      <thead>
        <tr>
          <th scope="col">Ano</th>
          <th scope="col">Início</th>
          <th scope="col">Término</th>
        </tr>
      </thead>
      <tbody>
        <% anos.forEach((anoLetivo) => { %>
        <tr>
          <th scope="row" class="numero"><%= anoLetivo.ano %></th>
          <td class="numero"><%= it.formatarData(anoLetivo.dataInicio) %></td>
          <td class="numero"><%= it.formatarData(anoLetivo.dataFim) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: 'anos letivos' }) %>
  <% } %>
</section>
