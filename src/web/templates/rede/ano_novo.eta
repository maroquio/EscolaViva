<%
/*
  Definição de ano letivo.

  Um ano por rede — a repetição é recusada pelo banco e volta como erro no campo, não como falha do
  sistema. O ano vem como texto e é conferido em quatro dígitos antes de virar número: converter
  vazio em 0 devolveria a mensagem errada.

  Os dois endereços da tela — o destino do formulário e o "Cancelar" — vêm de `it.rotas`, o mesmo
  mapa que o router registra. São o mesmo endereço escrito duas vezes, e escrevê-lo à mão aqui não
  quebraria compilação: quebraria a tela de quem clica, porque `.eta` não passa pelo compilador.

  O rótulo do botão que envia é o título DESTA tela, e por isso lê `it.titulos.rede.anoNovo` — a
  mesma chave que a rota passa como `it.titulo` no `<h1>` acima. São a mesma decisão dita uma vez:
  renomear a tela renomeia junto o botão que a cumpre, e a lista que traz até aqui.
*/

/*
  A faixa aceita e os sufixos de id chegam prontos da rota: o Eta não importa TypeScript, então
  `LIMITES.anoLetivo` (`src/academico/constantes.ts`) e `SUFIXOS_DE_ID` (`src/web/constantes.ts`)
  atravessam por `it`. Redigitar 2000 aqui faria a tela recusar uma faixa e o caso de uso outra;
  redigitar "-erro" faria o `aria-describedby` apontar para um id que não existe.
*/
const valores = it.valores ?? { ano: '', dataInicio: '', dataFim: '' };
const { erroDe, descricao, sufixos } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Rede · Anos letivos</p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O período define o que conta como "este ano" para matrícula, boletim e frequência. Não pode
      haver dois anos iguais na mesma rede.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.rede.anosLetivos() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="ano">
          Ano <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="ano"
          name="ano"
          type="number"
          required
          min="<%= it.anoMinimo %>"
          max="<%= it.anoMaximo %>"
          step="1"
          inputmode="numeric"
          value="<%= valores.ano %>"
          <% if (erroDe('ano') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('ano') !== '') { %>aria-describedby="<%= descricao('ano') %>"<% } %>>
        <% if (erroDe('ano') !== '') { %>
        <p class="campo__erro" id="ano<%= sufixos.erro %>"><%= erroDe('ano') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="dataInicio">
          Início <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="dataInicio"
          name="dataInicio"
          type="date"
          required
          value="<%= valores.dataInicio %>"
          <% if (erroDe('dataInicio') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('dataInicio') !== '') { %>aria-describedby="<%= descricao('dataInicio') %>"<% } %>>
        <% if (erroDe('dataInicio') !== '') { %>
        <p class="campo__erro" id="dataInicio<%= sufixos.erro %>"><%= erroDe('dataInicio') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="dataFim">
          Término <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="dataFim"
          name="dataFim"
          type="date"
          required
          value="<%= valores.dataFim %>"
          <% if (erroDe('dataFim') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('dataFim', true) %>">
        <p class="campo__ajuda" id="dataFim<%= sufixos.ajuda %>">Precisa ser posterior à data de início.</p>
        <% if (erroDe('dataFim') !== '') { %>
        <p class="campo__erro" id="dataFim<%= sufixos.erro %>"><%= erroDe('dataFim') %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.rede.anoNovo %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.rede.anosLetivos() %>">Cancelar</a>
    </div>
  </form>
</div>
