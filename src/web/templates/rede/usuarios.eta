<%
/*
  Usuários da rede: quem tem acesso, com qual papel e em qual unidade. O convite mora em
  `it.rotas.rede.usuarioNovo()`; esta página é a lista e o recado que volta dela.

  A senha provisória é o que merece atenção aqui. Ela é gerada no convite, não é guardada em lugar
  nenhum em texto claro e aparece uma única vez, logo depois do redirecionamento — por isso o bloco
  é o primeiro elemento da página e fala em voz alta (`role="status"`). Quem fechar a página sem
  anotar precisa convidar de novo.

  Os dois caminhos para o convite — o botão do cabeçalho e a ação do estado vazio — levam ao mesmo
  lugar e saem de `it.rotas`, o mesmo mapa que o router registra. Escritos à mão, seriam duas cópias
  do endereço que podem divergir de um lado só, e URL literal em `.eta` não quebra compilação:
  quebra a tela de quem clica — justamente a tela por onde todo acesso à rede começa.

  Os caminhos das parciais incluídas seguem a mesma regra: chegam em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo.
*/
const usuarios = it.usuarios ?? [];
const papeis = it.papeis ?? [];
const convite = it.convite ?? null;
const convidado = convite === null ? null : (usuarios.find((u) => u.id === convite.usuarioId) ?? null);

const rotuloDoPapel = (valor) => {
  const achado = papeis.find((opcao) => opcao.valor === valor);
  return achado === undefined ? valor : achado.rotulo;
};

/*
  As palavras da última coluna e a do usuário sem atribuição são `VOCABULARIO.ativo` e
  `VOCABULARIO.semPapel` (`src/identidade/constantes.ts`), entregues pela rota: o Eta não importa
  TypeScript, e "Inativo" escrito aqui divergiria do módulo dono sem quebrar nada.
*/
const ROTULO_DA_SITUACAO = it.rotuloDaSituacao;

/*
  A cor da etiqueta acompanha o rótulo e não o substitui — quem lê em preto e branco lê "Inativo".
  Classe de CSS é vocabulário da folha de estilo, e por isso mora aqui e não em `constantes.ts`.
*/
const CLASSE_DA_SITUACAO = { sim: 'etiqueta etiqueta--ativa', nao: 'etiqueta' };
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Rede</p>
    <h1 class="pagina__titulo">Usuários</h1>
    <p class="pagina__resumo">
      Todo acesso nasce aqui. O papel decide o que a pessoa vê, e ele existe sempre dentro de uma
      unidade: a mesma pessoa pode ser secretária em uma escola e responsável em outra.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.rotas.rede.usuarioNovo() %>">Convidar usuário</a>
  </div>
</div>

<% if (convite !== null && convidado !== null) { %>
<div class="aviso aviso--atencao" role="status">
  <p class="aviso__titulo">Senha provisória de <%= convidado.nome %></p>
  <p><code class="codigo"><%= convite.senha %></code></p>
  <p>
    Anote agora: esta senha aparece uma única vez e não pode ser recuperada depois que você sair
    desta página. Entregue-a pessoalmente ou por um canal que vocês já usem — o envio automático
    por e-mail entra no Estágio 04. Peça que a pessoa entre com
    <strong><%= convidado.email %></strong> e troque a senha no primeiro acesso.
  </p>
</div>
<% } %>

<section class="secao" aria-labelledby="lista-usuarios-titulo">
  <div class="secao__cabecalho">
    <h2 id="lista-usuarios-titulo">Quem tem acesso</h2>
    <p class="secao__nota"><%= it.navegacao === undefined ? usuarios.length : it.navegacao.total %> no total</p>
  </div>

  <% if (usuarios.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum usuário cadastrado',
      texto: 'Convide a secretaria primeiro: é ela quem cadastra alunos, responsáveis e turmas.',
      acao: { href: it.rotas.rede.usuarioNovo(), texto: 'Convidar usuário' }
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Usuários da rede</caption>
      <thead>
        <tr>
          <th scope="col">Nome</th>
          <th scope="col">CPF</th>
          <th scope="col">E-mail</th>
          <th scope="col">Papéis</th>
          <th scope="col">Situação</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach((usuario) => { %>
        <tr>
          <th scope="row"><%= usuario.nome %></th>
          <td class="celula-texto"><%= it.formatarCpf(usuario.cpf ?? '') %></td>
          <td class="celula-texto"><%= usuario.email %></td>
          <td class="celula-texto">
            <% if (usuario.papeis.length === 0) { %>
            <span class="suave"><%= it.semPapel %></span>
            <% } else { %>
            <% usuario.papeis.forEach((atribuicao) => { %>
            <div><%= rotuloDoPapel(atribuicao.papel) %> · <%= atribuicao.unidadeNome %></div>
            <% }) %>
            <% } %>
          </td>
          <td>
            <span class="<%= usuario.ativo ? CLASSE_DA_SITUACAO.sim : CLASSE_DA_SITUACAO.nao %>"><%= usuario.ativo ? ROTULO_DA_SITUACAO.sim : ROTULO_DA_SITUACAO.nao %></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: 'usuários' }) %>
  <% } %>
</section>
