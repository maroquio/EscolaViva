<%
/*
  Convite de usuário.

  Um mesmo e-mail pode ser secretária em uma unidade e responsável em outra, então o convite aceita
  várias linhas de unidade + papel. Sem JavaScript no cliente, as linhas são fixas: as que ficarem
  vazias são simplesmente ignoradas, e as preenchidas pela metade voltam com erro.

  As duas listas de seleção não são paginadas, ao contrário da tabela em `it.rotas.rede.usuarios()`:
  recortar o que a pessoa lê é cuidado com o banco, recortar o que ela pode escolher seria esconder
  opção sem avisar.

  Os dois endereços da tela — o destino do formulário e o "Cancelar" — vêm de `it.rotas`, o mesmo
  mapa que o router registra. São o mesmo endereço escrito duas vezes, e escrevê-lo à mão aqui não
  quebraria compilação: quebraria a tela de quem clica, porque `.eta` não passa pelo compilador.
*/

/*
  Os dois tamanhos chegam prontos da rota: o Eta não importa TypeScript, então
  `LIMITES.usuario.nome` (`src/identidade/constantes.ts`) e `TAMANHO_DO_CPF_COM_MASCARA`
  (`src/shared/constantes.ts`) atravessam por `it`. Quem recusa o nome longo é `convidarUsuario`,
  com `MENSAGENS.usuario.nomeLongo`, e quem decide se o CPF vale é `shared/documento`, que aceita
  com ou sem pontuação — o `maxlength` só limita o que cabe na caixa.
*/

/*
  `campos` é o `CAMPOS.usuario` de `src/identidade/constantes.ts`, que chega pelo `it.campos` da
  camada web. É o nome que ATRAVESSA este arquivo: a rota lê o corpo do POST por ele e o
  `falhaDeCampo` do caso de uso o devolve para `erroDe`. Divergindo, o campo chega vazio e o
  servidor recusa por obrigatório justamente o que a pessoa acabou de preencher — sem erro em lugar
  nenhum. `unidades` e `papeis` são as duas listas paralelas das atribuições, que a rota junta no
  campo `atribuicoes`.

  `it.idDoErro` e `it.idDaAjuda` são a outra ponta de `descricao()`: ela monta o `aria-describedby`
  do `<input>`, elas montam o `id` do parágrafo para onde ele aponta. Escrever esse id à mão aqui
  apontaria o leitor de tela para um elemento inexistente, e nada falharia — a caixa recusa o id, o
  texto do erro continua aparecendo e ninguém que enxerga percebe.
*/
const unidades = it.unidades ?? [];
const responsaveis = it.responsaveis ?? [];
const papeis = it.papeis ?? [];
const linhas = it.linhas ?? [];
const valores = it.valores ?? { nome: '', email: '', cpf: '', responsavelId: '' };
const campos = it.campos.usuario;
// magic-values: permitido — o `id` do <input> e o `for` do <label> logo abaixo casam um com o outro
// dentro das mesmas seis linhas e não atravessam este arquivo; `for="nome"` ao lado de `id="nome"`
// é o HTML mais legível que existe, e o nome que atravessa é o do `name=`, que vem de `campos`.
const { erroDe, descricao } = it;
/* "Rede · Usuários" é a área do menu mais a lista onde esta tela vive: os dois pedaços já têm dono. */
const sobretitulo = `${it.areas.rede}${it.apresentacao.separador}${it.titulos.rede.usuarios}`;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= sobretitulo %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      A senha provisória é gerada agora e aparece uma única vez na lista, logo depois de criar.
      Tenha onde anotá-la antes de enviar o formulário.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario formulario--largo" method="post" action="<%= it.rotas.rede.usuarios() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="nome">
          <%= it.rotulos.nome %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="nome"
          name="<%= campos.nome %>"
          type="text"
          required
          maxlength="<%= it.limiteDoNome %>"
          autocomplete="off"
          value="<%= valores.nome %>"
          <% if (erroDe(campos.nome) !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao(campos.nome) !== '') { %>aria-describedby="<%= descricao(campos.nome) %>"<% } %>>
        <% if (erroDe(campos.nome) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.nome) %>"><%= erroDe(campos.nome) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="cpf">
          <%= it.rotulos.cpf %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="cpf"
          name="<%= campos.cpf %>"
          type="text"
          required
          maxlength="<%= it.tamanhoDoCpf %>"
          autocomplete="off"
          value="<%= valores.cpf %>"
          <% if (erroDe(campos.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.cpf, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.cpf) %>">É por ele que a pessoa entra. Com ou sem pontos.</p>
        <% if (erroDe(campos.cpf) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.cpf) %>"><%= erroDe(campos.cpf) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="email">
          <%= it.rotulos.email %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= campos.email %>"
          type="email"
          required
          autocapitalize="none"
          spellcheck="false"
          autocomplete="off"
          value="<%= valores.email %>"
          <% if (erroDe(campos.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.email, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.email) %>">Contato. Não é usado para entrar.</p>
        <% if (erroDe(campos.email) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.email) %>"><%= erroDe(campos.email) %></p>
        <% } %>
      </div>
    </div>

    <fieldset <% if (erroDe(campos.atribuicoes) !== '') { %>aria-describedby="<%= it.idDoErro(campos.atribuicoes) %>"<% } %>>
      <legend>Atribuições</legend>
      <% if (erroDe(campos.atribuicoes) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.atribuicoes) %>"><%= erroDe(campos.atribuicoes) %></p>
      <% } %>

      <div class="pilha">
        <% linhas.forEach((linha, indice) => { %>
        <div class="formulario__linha">
          <div class="campo">
            <label class="campo__rotulo" for="unidade-<%= indice %>"><%= it.rotulos.unidade %> <%= indice + 1 %></label>
            <select id="unidade-<%= indice %>" name="<%= campos.unidades %>">
              <option value="">Sem atribuição</option>
              <% unidades.forEach((unidade) => { %>
              <option value="<%= unidade.id %>" <% if (unidade.id === linha.unidadeId) { %>selected<% } %>><%= unidade.nome %></option>
              <% }) %>
            </select>
          </div>

          <div class="campo">
            <label class="campo__rotulo" for="papel-<%= indice %>">Papel <%= indice + 1 %></label>
            <select id="papel-<%= indice %>" name="<%= campos.papeis %>">
              <option value="">Sem atribuição</option>
              <% papeis.forEach((opcao) => { %>
              <option value="<%= opcao.valor %>" <% if (opcao.valor === linha.papel) { %>selected<% } %>><%= opcao.rotulo %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <% }) %>
      </div>
    </fieldset>

    <div class="campo">
      <label class="campo__rotulo" for="responsavelId">Cadastro de responsável</label>
      <select
        id="responsavelId"
        name="<%= campos.responsavelId %>"
        <% if (erroDe(campos.responsavelId) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao(campos.responsavelId, true) %>">
        <option value="">Nenhum</option>
        <% responsaveis.forEach((responsavel) => { %>
        <option value="<%= responsavel.id %>" <% if (responsavel.id === valores.responsavelId) { %>selected<% } %>><%= responsavel.nome %> — <%= responsavel.email %></option>
        <% }) %>
      </select>
      <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.responsavelId) %>">
        Obrigatório quando alguma atribuição acima for Responsável: é esse cadastro que liga a
        conta aos alunos. A secretaria cria o cadastro antes do convite.
      </p>
      <% if (erroDe(campos.responsavelId) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.responsavelId) %>"><%= erroDe(campos.responsavelId) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Criar usuário</button>
      <a class="botao botao--discreto" href="<%= it.rotas.rede.usuarios() %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
</div>
