<%
/*
  Painel da rede.

  Quatro números e o ano em vigor. Não há gráfico, não há período comparativo e não há métrica
  que ninguém use: cada cartão responde uma pergunta que o administrador faz de verdade — quantas
  escolas, quantas pessoas com acesso, quantas turmas abertas e quantos alunos matriculados.

  Turmas e matriculados são do ano letivo em vigor; unidades e usuários são da rede inteira. O
  rótulo de cada cartão diz qual é qual, porque somar anos diferentes daria um número sem uso.

  O caminho da parcial incluída também não é escrito à mão: ele chega em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo. Renomear a parcial passa a ser uma
  edição só, e não uma caçada por aspas espalhadas pelos `.eta`.

  Os DOIS cartões que são link levam a uma tela que já tem título em `TITULOS`, e o rótulo do
  cartão é esse título: ele chega em `it.titulos`, injetado por `render.ts` do mesmo jeito que
  `it.rotas`. Escrito à mão, o painel ficava livre para chamar a tela de "Unidades" aqui e de outra
  coisa no `<h1>` que o clique abre — a mesma divergência silenciosa que o menu já não tem.

  Os outros dois cartões NÃO são link, e por isso continuam com o rótulo escrito. "Turmas" e
  "Matriculados" nomeiam uma CONTAGEM desta rede, não uma tela: coincidem com
  `TITULOS.secretaria.turmas` por serem a mesma palavra do domínio, e não a mesma decisão —
  renomear a tela da secretaria não deve renomear um número do painel da rede. A justificativa que
  `scripts/magic-values.ts` exige fica na linha acima do literal, e encostada na margem de
  propósito: o Eta guarda o que vier ANTES de um `<%` como texto do documento, então indentar o
  comentário empurraria a linha seguinte dois espaços para a direita no HTML servido.
*/
const contagens = it.contagens ?? { unidades: 0, usuarios: 0, turmas: 0, matriculados: 0 };
const anoLetivo = it.anoLetivo ?? null;
const rede = it.usuario === null ? '' : it.usuario.redeNome;
const anoNoRotulo = anoLetivo === null ? 'sem ano letivo' : 'ano letivo ' + anoLetivo.ano;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Rede</p>
    <h1 class="pagina__titulo"><%= rede %></h1>
    <p class="pagina__resumo">
      A rede é o contorno de tudo o que este sistema mostra: nenhuma consulta atravessa para outra
      rede, e é daqui que saem as unidades, os acessos e o calendário que a secretaria usa.
    </p>
  </div>
</div>

<section class="secao" aria-labelledby="numeros-titulo">
  <div class="secao__cabecalho">
    <h2 id="numeros-titulo">Onde a rede está hoje</h2>
    <p class="secao__nota">Contagem no momento em que esta página foi aberta.</p>
  </div>

  <div class="painel">
    <a class="cartao" href="<%= it.rotas.rede.unidades() %>">
      <span class="cartao__rotulo"><%= it.titulos.rede.unidades %></span>
      <span class="cartao__numero"><%= contagens.unidades %></span>
      <span class="cartao__detalhe">Escolas ativas e inativas da rede</span>
    </a>

    <a class="cartao" href="<%= it.rotas.rede.usuarios() %>">
      <span class="cartao__rotulo"><%= it.titulos.rede.usuarios %></span>
      <span class="cartao__numero"><%= contagens.usuarios %></span>
      <span class="cartao__detalhe">Pessoas com acesso, somando todos os papéis</span>
    </a>

    <div class="cartao">
<% // magic-values: permitido — nomeia a contagem desta rede, não a tela `TITULOS.secretaria.turmas` %>
      <span class="cartao__rotulo">Turmas</span>
      <span class="cartao__numero"><%= contagens.turmas %></span>
      <span class="cartao__detalhe">Abertas no <%= anoNoRotulo %></span>
    </div>

    <div class="cartao">
      <span class="cartao__rotulo">Matriculados</span>
      <span class="cartao__numero"><%= contagens.matriculados %></span>
      <span class="cartao__detalhe">Matrículas ativas no <%= anoNoRotulo %></span>
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="ano-titulo">
  <div class="secao__cabecalho">
    <h2 id="ano-titulo">Ano letivo em vigor</h2>
    <p class="secao__nota">
      <%= it.anosDefinidos %> ano(s) definido(s) nesta rede.
    </p>
  </div>

  <% if (anoLetivo === null) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum ano letivo definido',
      texto: 'Sem ano letivo não existe turma nem matrícula. É o primeiro passo depois de criar as unidades.',
      /* O rótulo nomeia a AÇÃO da tela `ano_novo` e por isso lê o título dela; o `href` passa
         pela lista de propósito, para o administrador ver o calendário antes de definir. */
      acao: { href: it.rotas.rede.anosLetivos(), texto: it.titulos.rede.anoNovo }
    }) %>
  <% } else { %>
  <div class="quadro">
    <dl class="lista-definicoes">
      <dt>Ano</dt>
      <dd class="numero"><%= anoLetivo.ano %></dd>
      <dt>Início</dt>
      <dd class="numero"><%= it.formatarData(anoLetivo.dataInicio) %></dd>
      <dt>Término</dt>
      <dd class="numero"><%= it.formatarData(anoLetivo.dataFim) %></dd>
    </dl>
  </div>
  <% } %>
</section>
