<%
const values = it.values ?? { networkSlug: '', cpf: '' };
const fields = it.fields.login;

const { errorFor, describedBy } = it;
%>
<h1><%= it.title %></h1>

<form class="form" method="post" action="<%= it.routes.public.login() %>">
  <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

  <div class="field">
    <label class="field__label" for="networkSlug">
      Identificador da rede <span class="field__required" aria-hidden="true">*</span>
    </label>
    <input
      id="networkSlug"
      name="<%= fields.networkSlug %>"
      type="text"
      required
      autocomplete="organization"
      autocapitalize="none"
      spellcheck="false"
      value="<%= values.networkSlug %>"
      <% if (errorFor(fields.networkSlug) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= describedBy(fields.networkSlug, true) %>">
    <p class="field__help" id="<%= it.helpId(fields.networkSlug) %>">
      O apelido curto da rede, informado pela secretaria — tudo minúsculo, sem espaço.
    </p>
    <% if (errorFor(fields.networkSlug) !== '') { %>
    <p class="field__error" id="<%= it.errorId(fields.networkSlug) %>"><%= errorFor(fields.networkSlug) %></p>
    <% } %>
  </div>

  <div class="field">
    <label class="field__label" for="cpf">
      <%= it.labels.cpf %> <span class="field__required" aria-hidden="true">*</span>
    </label>
    <input
      id="cpf"
      name="<%= fields.cpf %>"
      type="text"
      required
      inputmode="numeric"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      value="<%= values.cpf %>"
      <% if (errorFor(fields.cpf) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= describedBy(fields.cpf, true) %>">
    <p class="field__help" id="<%= it.helpId(fields.cpf) %>">
      O CPF pode ser digitado com ou sem pontos e traço.
    </p>
    <% if (errorFor(fields.cpf) !== '') { %>
    <p class="field__error" id="<%= it.errorId(fields.cpf) %>"><%= errorFor(fields.cpf) %></p>
    <% } %>
  </div>

  <div class="field">
    <label class="field__label" for="password">
      Senha <span class="field__required" aria-hidden="true">*</span>
    </label>
    <input
      id="password"
      name="<%= fields.password %>"
      type="password"
      required
      autocomplete="current-password"
      <% if (errorFor(fields.password) !== '') { %>aria-invalid="true"<% } %>
      <% if (describedBy(fields.password, false) !== '') { %>aria-describedby="<%= describedBy(fields.password, false) %>"<% } %>>
    <% if (errorFor(fields.password) !== '') { %>
    <p class="field__error" id="<%= it.errorId(fields.password) %>"><%= errorFor(fields.password) %></p>
    <% } %>
  </div>

  <div class="actions">
    <button class="button button--primary" type="submit"><%= it.titles.login %></button>
  </div>
</form>
