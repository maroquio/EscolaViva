<%
const valores = it.valores ?? { redeSlug: '', cpf: '' };
const campos = it.campos.login;

const { erroDe, descricao } = it;
%>
<h1><%= it.titulo %></h1>

<form class="formulario" method="post" action="<%= it.rotas.publicas.login() %>">
  <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

  <div class="campo">
    <label class="campo__rotulo" for="redeSlug">
      Identificador da rede <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="redeSlug"
      name="<%= campos.redeSlug %>"
      type="text"
      required
      autocomplete="organization"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.redeSlug %>"
      <% if (erroDe(campos.redeSlug) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= descricao(campos.redeSlug, true) %>">
    <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.redeSlug) %>">
      O apelido curto da rede, informado pela secretaria — tudo minúsculo, sem espaço.
    </p>
    <% if (erroDe(campos.redeSlug) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.redeSlug) %>"><%= erroDe(campos.redeSlug) %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="cpf">
      <%= it.rotulos.cpf %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="cpf"
      name="<%= campos.cpf %>"
      type="text"
      required
      inputmode="numeric"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.cpf %>"
      <% if (erroDe(campos.cpf) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= descricao(campos.cpf, true) %>">
    <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.cpf) %>">
      O CPF pode ser digitado com ou sem pontos e traço.
    </p>
    <% if (erroDe(campos.cpf) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.cpf) %>"><%= erroDe(campos.cpf) %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="senha">
      Senha <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="senha"
      name="<%= campos.senha %>"
      type="password"
      required
      autocomplete="current-password"
      <% if (erroDe(campos.senha) !== '') { %>aria-invalid="true"<% } %>
      <% if (descricao(campos.senha, false) !== '') { %>aria-describedby="<%= descricao(campos.senha, false) %>"<% } %>>
    <% if (erroDe(campos.senha) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.senha) %>"><%= erroDe(campos.senha) %></p>
    <% } %>
  </div>

  <div class="acoes">
    <button class="botao botao--primario" type="submit"><%= it.titulos.login %></button>
  </div>
</form>
