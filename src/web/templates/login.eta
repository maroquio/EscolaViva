<%
/*
  Entrar no sistema.

  A folha centrada do `_layout_publico` é escolhida por `renderizar`, que olha a sessão: nesta
  tela nunca há usuário, então nunca há barra lateral nem contexto de rede.

  A mensagem de recusa vem inteira de `identidade.autenticar` e é deliberadamente vaga — a tela
  não diz se o CPF existe. Ela aparece uma vez, no aviso do topo montado por
  `_mensagens`; quando o erro tem campo, o mesmo texto marca o campo. A senha nunca volta
  preenchida.

  O rótulo do botão que envia é o título DESTA tela, e por isso lê `it.titulos.login` — a mesma
  chave que `rotas/login.ts` passa como `it.titulo` no `<h1>` acima. São a mesma decisão dita uma
  vez, e não duas palavras que por acaso se escrevem igual: o "Entrar novamente" da página de erro
  é outro texto e continua sendo outro.
*/
/*
  `campos` é o apelido curto do mapa de nomes deste formulário — `CAMPOS.login`, de
  `src/identidade/constantes.ts`, que chega por `render.ts` porque o Eta não importa TypeScript. O
  que ele guarda é o nome que ATRAVESSA o arquivo: `rotas/login.ts` lê o corpo do POST por
  `CAMPOS.login.cpf` e `falhaDeCampo` devolve o mesmo nome na recusa, que é o que `erroDe()` e
  `descricao()` procuram. Divergindo, o campo chega vazio ao servidor, que recusa por obrigatório o
  que a pessoa acabou de digitar.

  O `cpf` daqui é o do LOGIN, e não o `CAMPOS.responsavel.cpf` do acadêmico: os dois se escrevem
  igual e respondem a decisões diferentes — um é o identificador com que se entra, o outro é um dado
  da ficha do responsável. Renomear o campo do cadastro não pode mexer no formulário de entrada.

  `it.idDoErro` e `it.idDaAjuda` são o outro lado de `descricao()`: ela monta o `aria-describedby`, e
  eles montam o `id` para onde essa lista aponta. Escrever "-erro" à mão aqui faria o
  `aria-describedby` apontar para um id inexistente — nada falha, ninguém que enxerga percebe, e o
  leitor de tela não lê nem a ajuda nem o erro.

  O `id` do `<input>` e o `for` do `<label>`, esses continuam escritos à mão de propósito: casam um
  com o outro dentro das mesmas seis linhas, nada fora deste arquivo os lê, e `for="senha"` ao lado
  de `id="senha"` é o HTML mais legível que se pode deixar para quem está aprendendo.
  magic-values: permitido — o `id`/`for` não é o nome que atravessa o arquivo; o `name=`, sim.
*/
const valores = it.valores ?? { redeSlug: '', cpf: '' };
const campos = it.campos.login;

/* `erroDe` e `descricao` chegam prontos de `render.ts`, já fechados sobre os erros deste render.
   `descricao` só referencia id de elemento que existe: ajuda quando pedida, erro quando há. */
const { erroDe, descricao } = it;
%>
<h1><%= it.titulo %></h1>

<form class="formulario" method="post" action="<%= it.rotas.publicas.login() %>">
  <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

  <div class="campo">
    <label class="campo__rotulo" for="redeSlug">
      Identificador da rede <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="redeSlug"
      name="<%= campos.redeSlug %>"
      type="text"
      required
      autocomplete="organization"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.redeSlug %>"
      <% if (erroDe(campos.redeSlug) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= descricao(campos.redeSlug, true) %>">
    <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.redeSlug) %>">
      O apelido curto da rede, informado pela secretaria — tudo minúsculo, sem espaço.
    </p>
    <% if (erroDe(campos.redeSlug) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.redeSlug) %>"><%= erroDe(campos.redeSlug) %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="cpf">
      <%= it.rotulos.cpf %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="cpf"
      name="<%= campos.cpf %>"
      type="text"
      required
      inputmode="numeric"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.cpf %>"
      <% if (erroDe(campos.cpf) !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= descricao(campos.cpf, true) %>">
    <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.cpf) %>">
      O CPF pode ser digitado com ou sem pontos e traço.
    </p>
    <% if (erroDe(campos.cpf) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.cpf) %>"><%= erroDe(campos.cpf) %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="senha">
      Senha <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="senha"
      name="<%= campos.senha %>"
      type="password"
      required
      autocomplete="current-password"
      <% if (erroDe(campos.senha) !== '') { %>aria-invalid="true"<% } %>
      <% if (descricao(campos.senha, false) !== '') { %>aria-describedby="<%= descricao(campos.senha, false) %>"<% } %>>
    <% if (erroDe(campos.senha) !== '') { %>
    <p class="campo__erro" id="<%= it.idDoErro(campos.senha) %>"><%= erroDe(campos.senha) %></p>
    <% } %>
  </div>

  <div class="acoes">
    <button class="botao botao--primario" type="submit"><%= it.titulos.login %></button>
  </div>
</form>
