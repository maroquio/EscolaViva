<%
/*
  Entrar no sistema.

  A folha centrada do `_layout_publico` é escolhida por `renderizar`, que olha a sessão: nesta
  tela nunca há usuário, então nunca há barra lateral nem contexto de rede.

  A mensagem de recusa vem inteira de `identidade.autenticar` e é deliberadamente vaga — a tela
  não diz se o e-mail existe. Ela aparece uma vez, no aviso do topo montado por `_mensagens`;
  quando o erro tem campo, o mesmo texto marca o campo. A senha nunca volta preenchida.
*/
const valores = it.valores ?? { redeSlug: '', email: '' };

/* `erroDe` e `descricao` chegam prontos de `render.ts`, já fechados sobre os erros deste render.
   `descricao` só referencia id de elemento que existe: ajuda quando pedida, erro quando há. */
const { erroDe, descricao } = it;
%>
<h1>Entrar</h1>

<form class="formulario" method="post" action="/login">
  <input type="hidden" name="_chave" value="<%= it.chave %>">

  <div class="campo">
    <label class="campo__rotulo" for="redeSlug">
      Identificador da rede <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="redeSlug"
      name="redeSlug"
      type="text"
      required
      autocomplete="organization"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.redeSlug %>"
      <% if (erroDe('redeSlug') !== '') { %>aria-invalid="true"<% } %>
      aria-describedby="<%= descricao('redeSlug', true) %>">
    <p class="campo__ajuda" id="redeSlug-ajuda">
      O apelido curto da rede, informado pela secretaria — tudo minúsculo, sem espaço.
    </p>
    <% if (erroDe('redeSlug') !== '') { %>
    <p class="campo__erro" id="redeSlug-erro"><%= erroDe('redeSlug') %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="email">
      E-mail <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      inputmode="email"
      autocomplete="username"
      autocapitalize="none"
      spellcheck="false"
      value="<%= valores.email %>"
      <% if (erroDe('email') !== '') { %>aria-invalid="true"<% } %>
      <% if (descricao('email', false) !== '') { %>aria-describedby="<%= descricao('email', false) %>"<% } %>>
    <% if (erroDe('email') !== '') { %>
    <p class="campo__erro" id="email-erro"><%= erroDe('email') %></p>
    <% } %>
  </div>

  <div class="campo">
    <label class="campo__rotulo" for="senha">
      Senha <span class="campo__obrigatorio" aria-hidden="true">*</span>
    </label>
    <input
      id="senha"
      name="senha"
      type="password"
      required
      autocomplete="current-password"
      <% if (erroDe('senha') !== '') { %>aria-invalid="true"<% } %>
      <% if (descricao('senha', false) !== '') { %>aria-describedby="<%= descricao('senha', false) %>"<% } %>>
    <% if (erroDe('senha') !== '') { %>
    <p class="campo__erro" id="senha-erro"><%= erroDe('senha') %></p>
    <% } %>
  </div>

  <div class="acoes">
    <button class="botao botao--primario" type="submit">Entrar</button>
  </div>
</form>
