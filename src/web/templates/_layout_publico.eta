<%
const folhaDeEstilo = it.rotas.publicas
  .publico()
  .replace(it.curingaDeAsset, it.asset(it.nomeLogicoDaFolha));
%><!doctype html>
<html lang="<%= it.documento.idioma %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= it.documento.esquemaDeCor %>">
  <meta name="robots" content="<%= it.documento.robots %>">
  <title><%= it.titulo %><%= it.apresentacao.sufixoDoTitulo %></title>
  <link rel="stylesheet" href="<%= folhaDeEstilo %>">
  <%~ include(it.parciais.icone) %>
</head>
<body>
  <a class="pular-para-conteudo" href="#<%= it.documento.idDoConteudo %>">Pular para o conteúdo</a>

  <div class="publico">
    <main class="publico__cartao" id="<%= it.documento.idDoConteudo %>" tabindex="-1">
      <header>
        <span class="marca publico__marca"><%~ it.apresentacao.marca %></span>
        <p class="publico__titulo"><%= it.apresentacao.subtituloPublico %></p>
      </header>

      <%~ include(it.parciais.mensagens, it) %>
      <%~ it.body %>

      <p class="publico__rodape">
        <%= it.apresentacao.rodapePublico %>

      </p>
    </main>
  </div>

  <%~ include(it.parciais.scriptAvisos) %>
</body>
</html>
