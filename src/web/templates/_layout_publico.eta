<%
/*
  Layout das telas sem sessão: entrar no sistema e página de erro. Uma folha centrada sobre a
  pauta do fundo — a mesma marca tipográfica da aplicação, sem barra lateral e sem contexto de
  rede, porque nada disso é conhecido antes do login.

  O título da página vem do <h1> do próprio conteúdo; aqui só a marca e o rodapé.

  O endereço da folha não é escrito à mão, pela mesma razão do `_layout`: `it.rotas.publicas.publico`
  é a MESMA rota curinga que serve os arquivos publicados (I10), e o nome versionado que `it.asset`
  resolve entra no lugar do curinga. Com o `/publico/` digitado aqui, mudar o prefixo publicado em
  `ROTAS` fazia a aplicação seguir e esta tela — mais TODA página de erro, que também usa este
  layout — perder o CSS em silêncio.
*/
const folhaDeEstilo = it.rotas.publicas
  .publico()
  .replace(it.curingaDeAsset, it.asset(it.nomeLogicoDaFolha));
%><!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="robots" content="noindex, nofollow">
  <title><%= it.titulo %> · EscolaViva</title>
  <link rel="stylesheet" href="<%= folhaDeEstilo %>">
  <%~ include("/parciais/_icone") %>
</head>
<body>
  <a class="pular-para-conteudo" href="#conteudo">Pular para o conteúdo</a>

  <div class="publico">
    <main class="publico__cartao" id="conteudo" tabindex="-1">
      <header>
        <span class="marca publico__marca">Escola<em>Viva</em></span>
        <p class="publico__titulo">Portal da rede escolar</p>
      </header>

      <%~ include("/parciais/_mensagens", it) %>
      <%~ it.body %>

      <p class="publico__rodape">
        Sistema de uso restrito. O acesso é registrado.
      </p>
    </main>
  </div>

  <%~ include("/parciais/_script_avisos") %>
</body>
</html>
