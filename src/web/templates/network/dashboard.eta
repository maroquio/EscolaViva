<%
const counts = it.counts ?? { schools: 0, users: 0, classGroups: 0, enrolled: 0 };
const academicYear = it.academicYear ?? null;
const network = it.user === null ? '' : it.user.networkName;
// magic-values: permitido — prosa das duas frases dos cartões, e não o substantivo contado `NOUNS.academicYear`
const academicYearInWords = 'ano letivo';
const yearInLabel =
  academicYear === null ? 'sem ' + academicYearInWords : academicYearInWords + ' ' + academicYear.year;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.network %></p>
    <h1 class="pagina__titulo"><%= network %></h1>
    <p class="pagina__resumo">
      A rede é o contorno de tudo o que este sistema mostra: nenhuma consulta atravessa para outra
      rede, e é daqui que saem as unidades, os acessos e o calendário que a secretaria usa.
    </p>
  </div>
</div>

<section class="secao" aria-labelledby="numeros-titulo">
  <div class="secao__cabecalho">
    <h2 id="numeros-titulo">Onde a rede está hoje</h2>
    <p class="secao__nota">Contagem no momento em que esta página foi aberta.</p>
  </div>

  <div class="painel">
    <a class="cartao" href="<%= it.routes.network.schools() %>">
      <span class="cartao__rotulo"><%= it.titles.network.schools %></span>
      <span class="cartao__numero"><%= counts.schools %></span>
      <span class="cartao__detalhe">Escolas ativas e inativas da rede</span>
    </a>

    <a class="cartao" href="<%= it.routes.network.users() %>">
      <span class="cartao__rotulo"><%= it.titles.network.users %></span>
      <span class="cartao__numero"><%= counts.users %></span>
      <span class="cartao__detalhe">Pessoas com acesso, somando todos os papéis</span>
    </a>

    <div class="cartao">
      <span class="cartao__rotulo">Turmas</span>
      <span class="cartao__numero"><%= counts.classGroups %></span>
      <span class="cartao__detalhe">Abertas no <%= yearInLabel %></span>
    </div>

    <div class="cartao">
      <span class="cartao__rotulo">Matriculados</span>
      <span class="cartao__numero"><%= counts.enrolled %></span>
      <span class="cartao__detalhe">Matrículas ativas no <%= yearInLabel %></span>
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="ano-titulo">
  <div class="secao__cabecalho">
    <h2 id="ano-titulo">Ano letivo em vigor</h2>
    <p class="secao__nota">
      <%= it.definedYears %> ano(s) definido(s) nesta rede.
    </p>
  </div>

  <% if (academicYear === null) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum ano letivo definido',
      text: 'Sem ano letivo não existe turma nem matrícula. É o primeiro passo depois de criar as unidades.',
      action: { href: it.routes.network.academicYears(), text: it.titles.network.yearNew }
    }) %>
  <% } else { %>
  <div class="quadro">
    <dl class="lista-definicoes">
      <dt><%= it.labels.year %></dt>
      <dd class="numero"><%= academicYear.year %></dd>
      <dt><%= it.labels.start %></dt>
      <dd class="numero"><%= it.formatDate(academicYear.startDate) %></dd>
      <dt><%= it.labels.end %></dt>
      <dd class="numero"><%= it.formatDate(academicYear.endDate) %></dd>
    </dl>
  </div>
  <% } %>
</section>
