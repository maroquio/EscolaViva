<%
const counts = it.counts ?? { schools: 0, users: 0, classGroups: 0, enrolled: 0 };
const academicYear = it.academicYear ?? null;
const network = it.user === null ? '' : it.user.networkName;
// magic-values: permitido — prosa das duas frases dos cartões, e não o substantivo contado `NOUNS.academicYear`
const academicYearInWords = 'ano letivo';
const yearInLabel =
  academicYear === null ? 'sem ' + academicYearInWords : academicYearInWords + ' ' + academicYear.year;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.network %></p>
    <h1 class="page__title"><%= network %></h1>
    <p class="page__summary">
      A rede é o contorno de tudo o que este sistema mostra: nenhuma consulta atravessa para outra
      rede, e é daqui que saem as unidades, os acessos e o calendário que a secretaria usa.
    </p>
  </div>
</div>

<section class="section" aria-labelledby="numbers-title">
  <div class="section__header">
    <h2 id="numbers-title">Onde a rede está hoje</h2>
    <p class="section__note">Contagem no momento em que esta página foi aberta.</p>
  </div>

  <div class="dashboard">
    <a class="card" href="<%= it.routes.network.schools() %>">
      <span class="card__label"><%= it.titles.network.schools %></span>
      <span class="card__number"><%= counts.schools %></span>
      <span class="card__detail">Escolas ativas e inativas da rede</span>
    </a>

    <a class="card" href="<%= it.routes.network.users() %>">
      <span class="card__label"><%= it.titles.network.users %></span>
      <span class="card__number"><%= counts.users %></span>
      <span class="card__detail">Pessoas com acesso, somando todos os papéis</span>
    </a>

    <div class="card">
      <span class="card__label">Turmas</span>
      <span class="card__number"><%= counts.classGroups %></span>
      <span class="card__detail">Abertas no <%= yearInLabel %></span>
    </div>

    <div class="card">
      <span class="card__label">Matriculados</span>
      <span class="card__number"><%= counts.enrolled %></span>
      <span class="card__detail">Matrículas ativas no <%= yearInLabel %></span>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="year-title">
  <div class="section__header">
    <h2 id="year-title">Ano letivo em vigor</h2>
    <p class="section__note">
      <%= it.definedYears %> ano(s) definido(s) nesta rede.
    </p>
  </div>

  <% if (academicYear === null) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum ano letivo definido',
      text: 'Sem ano letivo não existe turma nem matrícula. É o primeiro passo depois de criar as unidades.',
      action: { href: it.routes.network.academicYears(), text: it.titles.network.yearNew }
    }) %>
  <% } else { %>
  <div class="panel">
    <dl class="definition-list">
      <dt><%= it.labels.year %></dt>
      <dd class="number"><%= academicYear.year %></dd>
      <dt><%= it.labels.start %></dt>
      <dd class="number"><%= it.formatDate(academicYear.startDate) %></dd>
      <dt><%= it.labels.end %></dt>
      <dd class="number"><%= it.formatDate(academicYear.endDate) %></dd>
    </dl>
  </div>
  <% } %>
</section>
