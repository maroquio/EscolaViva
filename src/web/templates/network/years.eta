<%
const years = it.years ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.network %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      O ano letivo delimita as matrículas: um aluno tem uma matrícula ativa por ano, e é esse
      recorte que o boletim e a frequência usam.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.routes.network.academicYearNew() %>"><%= it.titles.network.yearNew %></a>
  </div>
</div>

<section class="secao" aria-labelledby="lista-anos-titulo">
  <div class="secao__cabecalho">
    <h2 id="lista-anos-titulo">Anos definidos</h2>
    <p class="secao__nota">Do mais recente para o mais antigo</p>
  </div>

  <% if (years.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum ano letivo definido',
      text: 'Enquanto não houver um ano definido, a secretaria não consegue criar turmas nem matricular alunos.',
      action: { href: it.routes.network.academicYearNew(), text: it.titles.network.yearNew }
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Calendário letivo da rede</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.year %></th>
          <th scope="col"><%= it.labels.start %></th>
          <th scope="col"><%= it.labels.end %></th>
        </tr>
      </thead>
      <tbody>
        <% years.forEach((academicYear) => { %>
        <tr>
          <th scope="row" class="numero"><%= academicYear.year %></th>
          <td class="numero"><%= it.formatDate(academicYear.startDate) %></td>
          <td class="numero"><%= it.formatDate(academicYear.endDate) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.academicYear.plural }) %>
  <% } %>
</section>
