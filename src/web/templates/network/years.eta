<%
const years = it.years ?? [];
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.network %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      O ano letivo delimita as matrículas: um aluno tem uma matrícula ativa por ano, e é esse
      recorte que o boletim e a frequência usam.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--primary" href="<%= it.routes.network.academicYearNew() %>"><%= it.titles.network.yearNew %></a>
  </div>
</div>

<section class="section" aria-labelledby="years-list-title">
  <div class="section__header">
    <h2 id="years-list-title">Anos definidos</h2>
    <p class="section__note">Do mais recente para o mais antigo</p>
  </div>

  <% if (years.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum ano letivo definido',
      text: 'Enquanto não houver um ano definido, a secretaria não consegue criar turmas nem matricular alunos.',
      action: { href: it.routes.network.academicYearNew(), text: it.titles.network.yearNew }
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Calendário letivo da rede</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.year %></th>
          <th scope="col"><%= it.labels.start %></th>
          <th scope="col"><%= it.labels.end %></th>
        </tr>
      </thead>
      <tbody>
        <% years.forEach((academicYear) => { %>
        <tr>
          <th scope="row" class="number"><%= academicYear.year %></th>
          <td class="number"><%= it.formatDate(academicYear.startDate) %></td>
          <td class="number"><%= it.formatDate(academicYear.endDate) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.academicYear.plural }) %>
  <% } %>
</section>
