<%
const valores = it.valores ?? { ano: '', dataInicio: '', dataFim: '' };
const campos = it.campos.anoLetivo;
const { erroDe, descricao } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.rede %><%= it.apresentacao.separador %><%= it.titulos.rede.anos %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O período define o que conta como "este ano" para matrícula, boletim e frequência. Não pode
      haver dois anos iguais na mesma rede.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.rede.anosLetivos() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="ano">
          <%= it.rotulos.ano %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="ano"
          name="<%= campos.ano %>"
          type="number"
          required
          min="<%= it.anoMinimo %>"
          max="<%= it.anoMaximo %>"
          step="1"
          inputmode="numeric"
          value="<%= valores.ano %>"
          <% if (erroDe(campos.ano) !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao(campos.ano) !== '') { %>aria-describedby="<%= descricao(campos.ano) %>"<% } %>>
        <% if (erroDe(campos.ano) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.ano) %>"><%= erroDe(campos.ano) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="dataInicio">
          <%= it.rotulos.inicio %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="dataInicio"
          name="<%= campos.dataInicio %>"
          type="date"
          required
          value="<%= valores.dataInicio %>"
          <% if (erroDe(campos.dataInicio) !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao(campos.dataInicio) !== '') { %>aria-describedby="<%= descricao(campos.dataInicio) %>"<% } %>>
        <% if (erroDe(campos.dataInicio) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.dataInicio) %>"><%= erroDe(campos.dataInicio) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="dataFim">
          <%= it.rotulos.termino %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="dataFim"
          name="<%= campos.dataFim %>"
          type="date"
          required
          value="<%= valores.dataFim %>"
          <% if (erroDe(campos.dataFim) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.dataFim, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.dataFim) %>">Precisa ser posterior à data de início.</p>
        <% if (erroDe(campos.dataFim) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.dataFim) %>"><%= erroDe(campos.dataFim) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.rede.anoNovo %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.rede.anosLetivos() %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
</div>
