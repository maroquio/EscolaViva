<%
const schools = it.schools ?? [];
const guardians = it.guardians ?? [];
const roles = it.roles ?? [];
const rows = it.rows ?? [];
const values = it.values ?? { name: '', email: '', cpf: '', guardianId: '' };
const fields = it.fields.user;
const { errorFor, describedBy } = it;
const overline = `${it.areas.network}${it.presentation.separator}${it.titles.network.users}`;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= overline %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      A senha provisória é gerada agora e aparece uma única vez na lista, logo depois de criar.
      Tenha onde anotá-la antes de enviar o formulário.
    </p>
  </div>
</div>

<div class="panel">
  <form class="form form--wide" method="post" action="<%= it.routes.network.users() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="name">
          <%= it.labels.name %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="name"
          name="<%= fields.name %>"
          type="text"
          required
          maxlength="<%= it.nameLimit %>"
          autocomplete="off"
          value="<%= values.name %>"
          <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.name) !== '') { %>aria-describedby="<%= describedBy(fields.name) %>"<% } %>>
        <% if (errorFor(fields.name) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="cpf">
          <%= it.labels.cpf %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="cpf"
          name="<%= fields.cpf %>"
          type="text"
          required
          maxlength="<%= it.cpfLength %>"
          autocomplete="off"
          value="<%= values.cpf %>"
          <% if (errorFor(fields.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.cpf, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.cpf) %>">É por ele que a pessoa entra. Com ou sem pontos.</p>
        <% if (errorFor(fields.cpf) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.cpf) %>"><%= errorFor(fields.cpf) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="email">
          <%= it.labels.email %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= fields.email %>"
          type="email"
          required
          autocapitalize="none"
          spellcheck="false"
          autocomplete="off"
          value="<%= values.email %>"
          <% if (errorFor(fields.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.email, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.email) %>">Contato. Não é usado para entrar.</p>
        <% if (errorFor(fields.email) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.email) %>"><%= errorFor(fields.email) %></p>
        <% } %>
      </div>
    </div>

    <fieldset <% if (errorFor(fields.roleAssignments) !== '') { %>aria-describedby="<%= it.errorId(fields.roleAssignments) %>"<% } %>>
      <legend>Atribuições</legend>
      <% if (errorFor(fields.roleAssignments) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.roleAssignments) %>"><%= errorFor(fields.roleAssignments) %></p>
      <% } %>

      <div class="stack">
        <% rows.forEach((row, index) => { %>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for="school-<%= index %>"><%= it.labels.school %> <%= index + 1 %></label>
            <select id="school-<%= index %>" name="<%= fields.schools %>">
              <option value="">Sem atribuição</option>
              <% schools.forEach((school) => { %>
              <option value="<%= school.id %>" <% if (school.id === row.schoolId) { %>selected<% } %>><%= school.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="role-<%= index %>">Papel <%= index + 1 %></label>
            <select id="role-<%= index %>" name="<%= fields.roles %>">
              <option value="">Sem atribuição</option>
              <% roles.forEach((option) => { %>
              <option value="<%= option.value %>" <% if (option.value === row.role) { %>selected<% } %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <% }) %>
      </div>
    </fieldset>

    <div class="field">
      <label class="field__label" for="guardianId">Cadastro de responsável</label>
      <select
        id="guardianId"
        name="<%= fields.guardianId %>"
        <% if (errorFor(fields.guardianId) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.guardianId, true) %>">
        <option value="">Nenhum</option>
        <% guardians.forEach((guardian) => { %>
        <option value="<%= guardian.id %>" <% if (guardian.id === values.guardianId) { %>selected<% } %>><%= guardian.name %> — <%= guardian.email %></option>
        <% }) %>
      </select>
      <p class="field__help" id="<%= it.helpId(fields.guardianId) %>">
        Obrigatório quando alguma atribuição acima for Responsável: é esse cadastro que liga a
        conta aos alunos. A secretaria cria o cadastro antes do convite.
      </p>
      <% if (errorFor(fields.guardianId) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.guardianId) %>"><%= errorFor(fields.guardianId) %></p>
      <% } %>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit">Criar usuário</button>
      <a class="button button--quiet" href="<%= it.routes.network.users() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
