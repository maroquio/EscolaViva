<%
const schools = it.schools ?? [];
const guardians = it.guardians ?? [];
const roles = it.roles ?? [];
const rows = it.rows ?? [];
const values = it.values ?? { name: '', email: '', cpf: '', guardianId: '' };
const fields = it.fields.user;
const { errorFor, describedBy } = it;
const overline = `${it.areas.network}${it.presentation.separator}${it.titles.network.users}`;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= overline %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      A senha provisória é gerada agora e aparece uma única vez na lista, logo depois de criar.
      Tenha onde anotá-la antes de enviar o formulário.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario formulario--largo" method="post" action="<%= it.routes.network.users() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="nome">
          <%= it.labels.name %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="nome"
          name="<%= fields.name %>"
          type="text"
          required
          maxlength="<%= it.nameLimit %>"
          autocomplete="off"
          value="<%= values.name %>"
          <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.name) !== '') { %>aria-describedby="<%= describedBy(fields.name) %>"<% } %>>
        <% if (errorFor(fields.name) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="cpf">
          <%= it.labels.cpf %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="cpf"
          name="<%= fields.cpf %>"
          type="text"
          required
          maxlength="<%= it.cpfLength %>"
          autocomplete="off"
          value="<%= values.cpf %>"
          <% if (errorFor(fields.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.cpf, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.cpf) %>">É por ele que a pessoa entra. Com ou sem pontos.</p>
        <% if (errorFor(fields.cpf) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.cpf) %>"><%= errorFor(fields.cpf) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="email">
          <%= it.labels.email %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= fields.email %>"
          type="email"
          required
          autocapitalize="none"
          spellcheck="false"
          autocomplete="off"
          value="<%= values.email %>"
          <% if (errorFor(fields.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.email, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.email) %>">Contato. Não é usado para entrar.</p>
        <% if (errorFor(fields.email) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.email) %>"><%= errorFor(fields.email) %></p>
        <% } %>
      </div>
    </div>

    <fieldset <% if (errorFor(fields.roleAssignments) !== '') { %>aria-describedby="<%= it.errorId(fields.roleAssignments) %>"<% } %>>
      <legend>Atribuições</legend>
      <% if (errorFor(fields.roleAssignments) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.roleAssignments) %>"><%= errorFor(fields.roleAssignments) %></p>
      <% } %>

      <div class="pilha">
        <% rows.forEach((row, index) => { %>
        <div class="formulario__linha">
          <div class="campo">
            <label class="campo__rotulo" for="unidade-<%= index %>"><%= it.labels.school %> <%= index + 1 %></label>
            <select id="unidade-<%= index %>" name="<%= fields.schools %>">
              <option value="">Sem atribuição</option>
              <% schools.forEach((school) => { %>
              <option value="<%= school.id %>" <% if (school.id === row.schoolId) { %>selected<% } %>><%= school.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="campo">
            <label class="campo__rotulo" for="papel-<%= index %>">Papel <%= index + 1 %></label>
            <select id="papel-<%= index %>" name="<%= fields.roles %>">
              <option value="">Sem atribuição</option>
              <% roles.forEach((option) => { %>
              <option value="<%= option.value %>" <% if (option.value === row.role) { %>selected<% } %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <% }) %>
      </div>
    </fieldset>

    <div class="campo">
      <label class="campo__rotulo" for="responsavelId">Cadastro de responsável</label>
      <select
        id="responsavelId"
        name="<%= fields.guardianId %>"
        <% if (errorFor(fields.guardianId) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.guardianId, true) %>">
        <option value="">Nenhum</option>
        <% guardians.forEach((guardian) => { %>
        <option value="<%= guardian.id %>" <% if (guardian.id === values.guardianId) { %>selected<% } %>><%= guardian.name %> — <%= guardian.email %></option>
        <% }) %>
      </select>
      <p class="campo__ajuda" id="<%= it.helpId(fields.guardianId) %>">
        Obrigatório quando alguma atribuição acima for Responsável: é esse cadastro que liga a
        conta aos alunos. A secretaria cria o cadastro antes do convite.
      </p>
      <% if (errorFor(fields.guardianId) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.guardianId) %>"><%= errorFor(fields.guardianId) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Criar usuário</button>
      <a class="botao botao--discreto" href="<%= it.routes.network.users() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
