<%
const values = it.values ?? { name: '', inepCode: '' };
const { errorFor, describedBy } = it;
const fields = it.fields.school;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.network %><%= it.presentation.separator %><%= it.titles.network.schools %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      A unidade é onde tudo o mais acontece: sem ela não há turma, papel nem comunicado. O nome
      precisa ser único dentro da rede.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.routes.network.schools() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="name">
          <%= it.labels.name %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="name"
          name="<%= fields.name %>"
          type="text"
          required
          maxlength="<%= it.nameLimit %>"
          autocomplete="off"
          value="<%= values.name %>"
          <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.name, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.name) %>">Como a escola é chamada no dia a dia.</p>
        <% if (errorFor(fields.name) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="inepCode">Código INEP</label>
        <input
          id="inepCode"
          name="<%= fields.inepCode %>"
          type="text"
          maxlength="<%= it.inepCodeLimit %>"
          inputmode="numeric"
          autocomplete="off"
          value="<%= values.inepCode %>"
          <% if (errorFor(fields.inepCode) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.inepCode, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.inepCode) %>">Opcional. Pode ser preenchido depois.</p>
        <% if (errorFor(fields.inepCode) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.inepCode) %>"><%= errorFor(fields.inepCode) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titles.network.schoolNew %></button>
      <a class="botao botao--discreto" href="<%= it.routes.network.schools() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
