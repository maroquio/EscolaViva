<%
const users = it.users ?? [];
const roles = it.roles ?? [];
const invite = it.invite ?? null;
const invited = invite === null ? null : (users.find((u) => u.id === invite.userId) ?? null);

const roleLabel = (value) => {
  const found = roles.find((option) => option.value === value);
  return found === undefined ? value : found.label;
};

const STATUS_LABEL = it.statusLabel;

const STATUS_CLASS = { yes: 'tag tag--active', no: 'tag' };
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.network %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Todo acesso nasce aqui. O papel decide o que a pessoa vê, e ele existe sempre dentro de uma
      unidade: a mesma pessoa pode ser secretária em uma escola e responsável em outra.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--primary" href="<%= it.routes.network.userNew() %>"><%= it.titles.network.userNew %></a>
  </div>
</div>

<% if (invite !== null && invited !== null) { %>
<div class="notice notice--warning" role="status">
  <p class="notice__title">Senha provisória de <%= invited.name %></p>
  <p><code class="code"><%= invite.password %></code></p>
  <p>
    Anote agora: esta senha aparece uma única vez e não pode ser recuperada depois que você sair
    desta página. Entregue-a pessoalmente ou por um canal que vocês já usem — o envio automático
    por e-mail entra no Estágio 04. Peça que a pessoa entre com
    <strong><%= invited.email %></strong> e troque a senha no primeiro acesso.
  </p>
</div>
<% } %>

<section class="section" aria-labelledby="users-list-title">
  <div class="section__header">
    <h2 id="users-list-title">Quem tem acesso</h2>
    <p class="section__note"><%= it.pagination === undefined ? users.length : it.pagination.total %> no total</p>
  </div>

  <% if (users.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum usuário cadastrado',
      text: 'Convide a secretaria primeiro: é ela quem cadastra alunos, responsáveis e turmas.',
      action: { href: it.routes.network.userNew(), text: it.titles.network.userNew }
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Usuários da rede</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.name %></th>
          <th scope="col"><%= it.labels.cpf %></th>
          <th scope="col"><%= it.labels.email %></th>
          <th scope="col">Papéis</th>
<% // magic-values: permitido — this is not a `LABELS.status`, nor the `IDENTITY_VOCABULARY.active` of the cell below %>
          <th scope="col">Situação</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((user) => { %>
        <tr>
          <th scope="row"><%= user.name %></th>
          <td class="cell-text"><%= it.formatCpf(user.cpf ?? '') %></td>
          <td class="cell-text"><%= user.email %></td>
          <td class="cell-text">
            <% if (user.roles.length === 0) { %>
            <span class="muted"><%= it.noRole %></span>
            <% } else { %>
            <% user.roles.forEach((assignment) => { %>
            <div><%= roleLabel(assignment.role) %><%= it.presentation.separator %><%= assignment.schoolName %></div>
            <% }) %>
            <% } %>
          </td>
          <td>
            <span class="<%= user.active ? STATUS_CLASS.yes : STATUS_CLASS.no %>"><%= user.active ? STATUS_LABEL.yes : STATUS_LABEL.no %></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.user.plural }) %>
  <% } %>
</section>
