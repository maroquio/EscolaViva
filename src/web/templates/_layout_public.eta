<%
const stylesheet = it.routes.public
  .assets()
  .replace(it.assetWildcard, it.asset(it.stylesheetLogicalName));
%><!doctype html>
<html lang="<%= it.document.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= it.document.colorScheme %>">
  <meta name="robots" content="<%= it.document.robots %>">
  <title><%= it.title %><%= it.presentation.titleSuffix %></title>
  <link rel="stylesheet" href="<%= stylesheet %>">
  <%~ include(it.partials.icon) %>
</head>
<body>
  <a class="skip-to-content" href="#<%= it.document.contentId %>">Pular para o conteúdo</a>

  <div class="public">
    <main class="public__card" id="<%= it.document.contentId %>" tabindex="-1">
      <header>
        <span class="brand public__brand"><%~ it.presentation.brand %></span>
        <p class="public__title"><%= it.presentation.publicSubtitle %></p>
      </header>

      <%~ include(it.partials.messages, it) %>
      <%~ it.body %>

      <p class="public__footer">
        <%= it.presentation.publicFooter %>

      </p>
    </main>
  </div>

  <%~ include(it.partials.noticesScript) %>
</body>
</html>
