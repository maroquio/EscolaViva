<%
const values = it.values;
const guardians = it.guardians;
const selected = new Set(values.selected);
const fields = it.fields.announcement;
const audiences = it.audiences;
const separatorBeforeBreak = it.presentation.separator.trimEnd();
const { errorFor, describedBy, errorId, helpId } = it;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.communication %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      O comunicado aparece no mural dos responsáveis escolhidos, e a leitura de cada um passa a ser
      medida a partir da publicação.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.routes.announcements.list() %>"><%= it.actions.backTo.announcements %></a>
  </p>
</header>

<% if (it.school === null) { %>
<section class="secao" aria-labelledby="titulo-unidade">
  <div class="secao__cabecalho">
    <h2 id="titulo-unidade">Passo 1<%= it.presentation.separator %>Unidade</h2>
    <p class="secao__nota">A lista de destinatários é a dos responsáveis desta unidade</p>
  </div>

  <% if (it.schools.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma unidade ativa ao seu alcance',
      text: 'Comunicado é sempre de uma unidade para os responsáveis dela. Peça ao administrador da rede uma unidade ativa com o seu papel.',
    }) %>
  <% } else { %>
  <form class="formulario" method="get" action="<%= it.routes.announcements.new() %>">
    <div class="campo">
      <label class="campo__rotulo" for="unidadeId">
        <%= it.labels.school %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <select id="unidadeId" name="<%= it.schoolField %>" required
              aria-describedby="<%= describedBy(fields.schoolId, true) %>"
              <% if (errorFor(fields.schoolId) !== '') { %>aria-invalid="true"<% } %>>
        <option value="">Escolha a unidade</option>
        <% it.schools.forEach((school) => { %>
        <option value="<%= school.id %>"><%= school.name %></option>
        <% }) %>
      </select>
      <p class="campo__ajuda" id="<%= helpId(fields.schoolId) %>">
        Só aparecem as unidades ativas em que você tem papel.
      </p>
      <% if (errorFor(fields.schoolId) !== '') { %>
      <p class="campo__erro" id="<%= errorId(fields.schoolId) %>"><%= errorFor(fields.schoolId) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Continuar</button>
    </div>
  </form>
  <% } %>
</section>
<% } else { %>
<section class="secao" aria-labelledby="titulo-mensagem">
  <div class="secao__cabecalho">
    <h2 id="titulo-mensagem">Passo 2<%= it.presentation.separator %>Mensagem</h2>
    <p class="secao__nota">
      <%= it.labels.school %> <strong><%= it.school.name %></strong><%= separatorBeforeBreak %>

      <a href="<%= it.routes.announcements.new() %>">trocar unidade</a>
    </p>
  </div>

  <form class="formulario formulario--largo" method="post" action="<%= it.routes.announcements.new() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
    <input type="hidden" name="<%= fields.schoolId %>" value="<%= it.school.id %>">

    <div class="campo leitura">
      <label class="campo__rotulo" for="titulo">
        Título <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input type="text" id="titulo" name="<%= fields.title %>" required
             value="<%= values.title %>"
             aria-describedby="<%= describedBy(fields.title, true) %>"
             <% if (errorFor(fields.title) !== '') { %>aria-invalid="true"<% } %>>
      <p class="campo__ajuda" id="<%= helpId(fields.title) %>">
        É a linha que o responsável vê na lista do mural.
      </p>
      <% if (errorFor(fields.title) !== '') { %>
      <p class="campo__erro" id="<%= errorId(fields.title) %>"><%= errorFor(fields.title) %></p>
      <% } %>
    </div>

    <div class="campo leitura">
      <label class="campo__rotulo" for="corpo">
        Mensagem <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <textarea id="corpo" name="<%= fields.body %>" required rows="<%= it.messageRows %>"
                <% if (errorFor(fields.body) !== '') { %>aria-invalid="true"<% } %>
                aria-describedby="<%= describedBy(fields.body, true) %>"><%= values.body %></textarea>
      <p class="campo__ajuda" id="<%= helpId(fields.body) %>">
        O texto aparece como foi digitado, com as quebras de linha preservadas.
      </p>
      <% if (errorFor(fields.body) !== '') { %>
      <p class="campo__erro" id="<%= errorId(fields.body) %>"><%= errorFor(fields.body) %></p>
      <% } %>
    </div>

    <fieldset aria-describedby="<%= describedBy(fields.recipients, true) %>">
      <legend><%= it.labels.recipients %></legend>

      <div class="pilha">
        <div class="campo campo--opcao">
          <input type="radio" id="alcance-unidade" name="<%= fields.audience %>" value="<%= audiences.school %>"
                 <% if (values.audience === audiences.school) { %>checked<% } %>>
          <label class="campo__rotulo" for="alcance-unidade">
            Todos os responsáveis da unidade
            (<span class="numero"><%= guardians.length %></span>)
          </label>
        </div>

        <div class="campo campo--opcao">
          <input type="radio" id="alcance-selecionados" name="<%= fields.audience %>" value="<%= audiences.selected %>"
                 <% if (values.audience === audiences.selected) { %>checked<% } %>>
          <label class="campo__rotulo" for="alcance-selecionados">
            Apenas os responsáveis marcados abaixo
          </label>
        </div>

        <p class="campo__ajuda" id="<%= helpId(fields.recipients) %>">
          Enviar para toda a unidade alcança quem tiver aluno com matrícula ativa no dia do envio.
        </p>

        <% if (errorFor(fields.recipients) !== '') { %>
        <p class="campo__erro" id="<%= errorId(fields.recipients) %>"><%= errorFor(fields.recipients) %></p>
        <% } %>

        <% if (guardians.length === 0) { %>
          <%~ include(it.partials.empty, {
            title: 'Nenhum responsável nesta unidade',
            text: 'Só recebe comunicado quem está vinculado a um aluno com matrícula ativa aqui. A secretaria faz esse vínculo na ficha do aluno.',
          }) %>
        <% } else { %>
                <p class="linha">
          <button class="botao botao--secundario botao--miudo" type="button"
                  id="marcar-todos" hidden>Selecionar todos</button>
        </p>

        <ul class="grade-opcoes">
          <% guardians.forEach((guardian) => { %>
          <li class="campo campo--opcao">
            <input type="checkbox" id="responsavel-<%= guardian.id %>"
                   name="<%= fields.guardians %>" value="<%= guardian.id %>"
                   <% if (selected.has(guardian.id)) { %>checked<% } %>>
            <label class="campo__rotulo" for="responsavel-<%= guardian.id %>">
              <%= guardian.name %>
            </label>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </fieldset>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Publicar comunicado</button>
      <a class="botao botao--discreto" href="<%= it.routes.announcements.list() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</section>

<script>
  (() => {
    const botao = document.getElementById('marcar-todos');
    const caixas = Array.from(document.querySelectorAll('input[name="<%= fields.guardians %>"]'));
    const alcanceSelecionados = document.getElementById('alcance-selecionados');
    if (botao === null || caixas.length === 0) return;

    const todasMarcadas = () => caixas.every((caixa) => caixa.checked);
    const atualizarRotulo = () => {
      botao.textContent = todasMarcadas() ? 'Desmarcar todos' : 'Selecionar todos';
    };

    botao.addEventListener('click', () => {
      const marcar = !todasMarcadas();
      caixas.forEach((caixa) => { caixa.checked = marcar; });
      if (marcar && alcanceSelecionados !== null) alcanceSelecionados.checked = true;
      atualizarRotulo();
    });

    caixas.forEach((caixa) => caixa.addEventListener('change', atualizarRotulo));

    atualizarRotulo();
    botao.hidden = false;
  })();
</script>
<% } %>
