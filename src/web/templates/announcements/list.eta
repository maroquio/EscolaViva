<%
const announcements = it.announcements;
const summary = it.summary;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.communication %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      O que foi enviado ao mural dos responsáveis, com quantos receberam e quantos leram.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.routes.announcements.new() %>"><%= it.titles.announcements.new %></a>
  </p>
</header>

<form class="filtro" method="get" action="<%= it.routes.announcements.list() %>">
  <label class="campo__rotulo" for="filtro-unidade"><%= it.labels.school %></label>
  <select id="filtro-unidade" name="<%= it.schoolField %>">
    <% if (it.seesWholeNetwork) { %>
    <option value=""<% if (it.currentSchool === '') { %> selected<% } %>>Toda a rede</option>
    <% } %>
    <% it.schools.forEach((school) => { %>
    <option value="<%= school.id %>"<% if (school.id === it.currentSchool) { %> selected<% } %>>
      <%= school.name %>
    </option>
    <% }) %>
  </select>
  <button class="botao botao--secundario" type="submit">Filtrar</button>
</form>

<section class="secao" aria-labelledby="titulo-alcance">
  <div class="secao__cabecalho">
    <h2 id="titulo-alcance">Alcance da comunicação</h2>
    <p class="secao__nota">Soma dos comunicados listados abaixo</p>
  </div>

  <div class="pilha">
    <div class="painel">
      <div class="cartao">
        <p class="cartao__rotulo">Taxa de leitura</p>
        <p class="cartao__numero"><%= it.formatRate(summary.rate) %></p>
        <p class="cartao__detalhe">Leituras sobre destinatários alcançados</p>
      </div>

      <div class="cartao">
        <p class="cartao__rotulo"><%= it.labels.recipients %></p>
        <p class="cartao__numero"><%= summary.recipients %></p>
        <p class="cartao__detalhe">Responsáveis que receberam algum comunicado</p>
      </div>

      <div class="cartao">
        <p class="cartao__rotulo">Leituras</p>
        <p class="cartao__numero"><%= summary.reads %></p>
        <p class="cartao__detalhe">Marcadas pelo próprio responsável no mural</p>
      </div>
    </div>

    <p class="suave">
      A leitura é registrada quando o responsável abre o comunicado no portal e marca que leu.
      Comunicado publicado que ninguém marcou continua contando como enviado e não como lido — é
      essa distância entre os dois números que diz quanto da comunicação da escola chega ao destino.
    </p>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-publicados">
  <div class="secao__cabecalho">
    <h2 id="titulo-publicados">Publicados</h2>
    <p class="secao__nota">Do mais recente para o mais antigo</p>
  </div>

  <% if (announcements.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum comunicado neste recorte',
      text: 'Ainda não há comunicado publicado para a unidade escolhida. O primeiro envio já entra nesta lista com a medição de leitura.',
      action: { href: it.routes.announcements.new(), text: 'Publicar o primeiro comunicado' },
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Comunicados e leituras</caption>
      <thead>
        <tr>
          <th scope="col">Comunicado</th>
          <th scope="col">Publicado em</th>
          <th scope="col"><%= it.labels.recipients %></th>
          <th scope="col">Leituras</th>
          <th scope="col">Taxa de leitura</th>
        </tr>
      </thead>
      <tbody>
        <% announcements.forEach((item) => { %>
        <tr>
          <td class="celula-texto"><%= item.title %></td>
          <td class="numero">
            <time datetime="<%= item.publishedAt %>"><%= it.formatDate(item.publishedAt) %></time>
          </td>
          <td class="numero"><%= item.recipients %></td>
          <td class="numero"><%= item.reads %></td>
          <td class="numero"><%= it.formatRate(item.rate) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td class="celula-texto" colspan="2">Total do recorte</td>
          <td class="numero"><%= summary.recipients %></td>
          <td class="numero"><%= summary.reads %></td>
          <td class="numero"><%= it.formatRate(summary.rate) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.announcement.plural }) %>
  <% } %>
</section>
