<%
const announcements = it.announcements;
const summary = it.summary;
%>
<header class="page__header">
  <div>
    <p class="overline"><%= it.areas.communication %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      O que foi enviado ao mural dos responsáveis, com quantos receberam e quantos leram.
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--primary" href="<%= it.routes.announcements.new() %>"><%= it.titles.announcements.new %></a>
  </p>
</header>

<form class="filter" method="get" action="<%= it.routes.announcements.list() %>">
  <label class="field__label" for="school-filter"><%= it.labels.school %></label>
  <select id="school-filter" name="<%= it.schoolField %>">
    <% if (it.seesWholeNetwork) { %>
    <option value=""<% if (it.currentSchool === '') { %> selected<% } %>>Toda a rede</option>
    <% } %>
    <% it.schools.forEach((school) => { %>
    <option value="<%= school.id %>"<% if (school.id === it.currentSchool) { %> selected<% } %>>
      <%= school.name %>
    </option>
    <% }) %>
  </select>
  <button class="button button--secondary" type="submit">Filtrar</button>
</form>

<section class="section" aria-labelledby="audience-title">
  <div class="section__header">
    <h2 id="audience-title">Alcance da comunicação</h2>
    <p class="section__note">Soma dos comunicados listados abaixo</p>
  </div>

  <div class="stack">
    <div class="dashboard">
      <div class="card">
        <p class="card__label">Taxa de leitura</p>
        <p class="card__number"><%= it.formatRate(summary.rate) %></p>
        <p class="card__detail">Leituras sobre destinatários alcançados</p>
      </div>

      <div class="card">
        <p class="card__label"><%= it.labels.recipients %></p>
        <p class="card__number"><%= summary.recipients %></p>
        <p class="card__detail">Responsáveis que receberam algum comunicado</p>
      </div>

      <div class="card">
        <p class="card__label">Leituras</p>
        <p class="card__number"><%= summary.reads %></p>
        <p class="card__detail">Marcadas pelo próprio responsável no mural</p>
      </div>
    </div>

    <p class="muted">
      A leitura é registrada quando o responsável abre o comunicado no portal e marca que leu.
      Comunicado publicado que ninguém marcou continua contando como enviado e não como lido — é
      essa distância entre os dois números que diz quanto da comunicação da escola chega ao destino.
    </p>
  </div>
</section>

<section class="section" aria-labelledby="published-title">
  <div class="section__header">
    <h2 id="published-title">Publicados</h2>
    <p class="section__note">Do mais recente para o mais antigo</p>
  </div>

  <% if (announcements.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum comunicado neste recorte',
      text: 'Ainda não há comunicado publicado para a unidade escolhida. O primeiro envio já entra nesta lista com a medição de leitura.',
      action: { href: it.routes.announcements.new(), text: 'Publicar o primeiro comunicado' },
    }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Comunicados e leituras</caption>
      <thead>
        <tr>
          <th scope="col">Comunicado</th>
          <th scope="col">Publicado em</th>
          <th scope="col"><%= it.labels.recipients %></th>
          <th scope="col">Leituras</th>
          <th scope="col">Taxa de leitura</th>
        </tr>
      </thead>
      <tbody>
        <% announcements.forEach((item) => { %>
        <tr>
          <td class="cell-text"><%= item.title %></td>
          <td class="number">
            <time datetime="<%= item.publishedAt %>"><%= it.formatDate(item.publishedAt) %></time>
          </td>
          <td class="number"><%= item.recipients %></td>
          <td class="number"><%= item.reads %></td>
          <td class="number"><%= it.formatRate(item.rate) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td class="cell-text" colspan="2">Total do recorte</td>
          <td class="number"><%= summary.recipients %></td>
          <td class="number"><%= summary.reads %></td>
          <td class="number"><%= it.formatRate(summary.rate) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.announcement.plural }) %>
  <% } %>
</section>
