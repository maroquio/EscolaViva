<%
const { erroDe, descricao } = it;
const campos = it.campos.senha;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Conta</p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Vale para qualquer papel. Depois de trocar, a senha antiga deixa de funcionar imediatamente;
      as sessões já abertas continuam válidas até expirarem.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.conta.senha() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="senhaAtual">
        Senha atual <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaAtual"
        name="<%= campos.atual %>"
        type="password"
        required
        autocomplete="current-password"
        <% if (erroDe(campos.atual) !== '') { %>aria-invalid="true"<% } %>
        <% if (descricao(campos.atual, false) !== '') { %>aria-describedby="<%= descricao(campos.atual, false) %>"<% } %>>
      <% if (erroDe(campos.atual) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.atual) %>"><%= erroDe(campos.atual) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaNova">
        Senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaNova"
        name="<%= campos.nova %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (erroDe(campos.nova) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao(campos.nova, true) %>">
      <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.nova) %>">
        Escolha uma senha longa e que você não use em outro sistema. Se ela for curta demais, o
        servidor recusa e diz o mínimo exigido.
      </p>
      <% if (erroDe(campos.nova) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.nova) %>"><%= erroDe(campos.nova) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaConfirmacao">
        Repita a senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaConfirmacao"
        name="<%= campos.confirmacao %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (erroDe(campos.confirmacao) !== '') { %>aria-invalid="true"<% } %>
        <% if (descricao(campos.confirmacao, false) !== '') { %>aria-describedby="<%= descricao(campos.confirmacao, false) %>"<% } %>>
      <% if (erroDe(campos.confirmacao) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.confirmacao) %>"><%= erroDe(campos.confirmacao) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.trocarSenha %></button>
    </div>
  </form>
</div>
