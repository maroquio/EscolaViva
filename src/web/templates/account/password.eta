<%
const { errorFor, describedBy } = it;
const fields = it.fields.password;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Conta</p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Vale para qualquer papel. Depois de trocar, a senha antiga deixa de funcionar imediatamente;
      as sessões já abertas continuam válidas até expirarem.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.routes.account.password() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="campo">
      <label class="campo__rotulo" for="senhaAtual">
        Senha atual <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaAtual"
        name="<%= fields.current %>"
        type="password"
        required
        autocomplete="current-password"
        <% if (errorFor(fields.current) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.current, false) !== '') { %>aria-describedby="<%= describedBy(fields.current, false) %>"<% } %>>
      <% if (errorFor(fields.current) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.current) %>"><%= errorFor(fields.current) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaNova">
        Senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaNova"
        name="<%= fields.new %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (errorFor(fields.new) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.new, true) %>">
      <p class="campo__ajuda" id="<%= it.helpId(fields.new) %>">
        Escolha uma senha longa e que você não use em outro sistema. Se ela for curta demais, o
        servidor recusa e diz o mínimo exigido.
      </p>
      <% if (errorFor(fields.new) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.new) %>"><%= errorFor(fields.new) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaConfirmacao">
        Repita a senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaConfirmacao"
        name="<%= fields.confirmation %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (errorFor(fields.confirmation) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.confirmation, false) !== '') { %>aria-describedby="<%= describedBy(fields.confirmation, false) %>"<% } %>>
      <% if (errorFor(fields.confirmation) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.confirmation) %>"><%= errorFor(fields.confirmation) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titles.changePassword %></button>
    </div>
  </form>
</div>
