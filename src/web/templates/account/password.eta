<%
const { errorFor, describedBy } = it;
const fields = it.fields.password;
%>
<div class="page__header">
  <div>
    <p class="overline">Conta</p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Vale para qualquer papel. Depois de trocar, a senha antiga deixa de funcionar imediatamente;
      as sessões já abertas continuam válidas até expirarem.
    </p>
  </div>
</div>

<div class="panel">
  <form class="form" method="post" action="<%= it.routes.account.password() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="field">
      <label class="field__label" for="currentPassword">
        Senha atual <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="currentPassword"
        name="<%= fields.currentPassword %>"
        type="password"
        required
        autocomplete="current-password"
        <% if (errorFor(fields.currentPassword) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.currentPassword, false) !== '') { %>aria-describedby="<%= describedBy(fields.currentPassword, false) %>"<% } %>>
      <% if (errorFor(fields.currentPassword) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.currentPassword) %>"><%= errorFor(fields.currentPassword) %></p>
      <% } %>
    </div>

    <div class="field">
      <label class="field__label" for="newPassword">
        Senha nova <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="newPassword"
        name="<%= fields.newPassword %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (errorFor(fields.newPassword) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.newPassword, true) %>">
      <p class="field__help" id="<%= it.helpId(fields.newPassword) %>">
        Escolha uma senha longa e que você não use em outro sistema. Se ela for curta demais, o
        servidor recusa e diz o mínimo exigido.
      </p>
      <% if (errorFor(fields.newPassword) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.newPassword) %>"><%= errorFor(fields.newPassword) %></p>
      <% } %>
    </div>

    <div class="field">
      <label class="field__label" for="passwordConfirmation">
        Repita a senha nova <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="passwordConfirmation"
        name="<%= fields.passwordConfirmation %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (errorFor(fields.passwordConfirmation) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.passwordConfirmation, false) !== '') { %>aria-describedby="<%= describedBy(fields.passwordConfirmation, false) %>"<% } %>>
      <% if (errorFor(fields.passwordConfirmation) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.passwordConfirmation) %>"><%= errorFor(fields.passwordConfirmation) %></p>
      <% } %>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit"><%= it.titles.changePassword %></button>
    </div>
  </form>
</div>
