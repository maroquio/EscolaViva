<%
const linhas = it.linhas ?? [];
const fechado = it.fechado === true;
const bimestre = it.bimestre;
const alocacao = it.alocacao;
const legenda = `Notas do ${it.rotuloDeBimestre(bimestre)}${it.separador}${alocacao.disciplinaNome}${it.separador}${alocacao.turmaNome}`;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= alocacao.turmaNome %><%= it.separador %><%= alocacao.serie %><%= it.separadorDeTurno %><%= alocacao.turno %></p>
    <h1 class="pagina__titulo"><%= alocacao.disciplinaNome %></h1>
    <p class="pagina__resumo">
      Lançamento de notas de <%= it.notaMinima %> a <%= it.notaMaxima %>, com uma casa decimal. O que estiver em branco no envio deixa de
      existir como nota do aluno neste bimestre.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.hrefChamada %>">Chamada</a>
    <a class="botao botao--discreto" href="<%= it.hrefFechamento %>">Fechamento</a>
    <a class="botao botao--discreto" href="<%= it.rotas.professor.painel() %>"><%= it.titulos.professor.painel %></a>
  </p>
</div>

<nav class="acoes" aria-label="Bimestre">
  <span class="sobretitulo">Bimestre</span>
  <% it.bimestres.forEach((numero) => { %>
  <a class="botao <%= numero === bimestre ? 'botao--secundario' : 'botao--discreto' %>"
     href="<%= it.acaoDoFormulario %>?<%= it.campoBimestre %>=<%= numero %>"
     <% if (numero === bimestre) { %>aria-current="page"<% } %>><%= numero %>º</a>
  <% }) %>
</nav>

<% if (fechado) { %>
<p class="aviso aviso--atencao" role="status">
  O <%= it.rotuloDeBimestre(bimestre) %> desta turma está fechado. As notas continuam visíveis, mas não podem
  mais ser alteradas — nem por aqui, nem por nenhum outro caminho do sistema.
</p>
<% } %>

<% if (linhas.length === 0) { %>
<%~ include(it.parciais.vazio, {
  titulo: it.semAlunoMatriculado,
  texto: 'Esta turma não tem matrícula ativa, então não há nota a lançar. A matrícula é feita pela secretaria.',
}) %>
<% } else { %>

<% if (!fechado) { %>
<form class="formulario formulario--largo" method="post" action="<%= it.acaoDoFormulario %>">
  <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">
  <input type="hidden" name="<%= it.campoBimestre %>" value="<%= bimestre %>">
<% } %>

  <div class="tabela-rolagem">
    <table class="tabela">
      <caption><%= legenda %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.rotulos.aluno %></th>
          <th scope="col">Nota (<%= it.notaMinima %> a <%= it.notaMaxima %>)</th>
        </tr>
      </thead>
      <tbody>
        <% linhas.forEach((linha) => { %>
        <tr>
          <th scope="row"><%= linha.alunoNome %></th>
          <td class="numero">
            <% if (fechado) { %>
            <%= it.formatarNota(linha.valor === '' ? null : linha.valor) %>
            <% } else { %>
            <label class="visualmente-oculto" for="<%= it.prefixoNota %><%= linha.matriculaId %>">
              Nota de <%= linha.alunoNome %> no <%= it.rotuloDeBimestre(bimestre) %>

            </label>
            <input class="entrada-numerica"
                   type="number"
                   inputmode="decimal"
                   step="0.1"
                   min="<%= it.notaMinima %>"
                   max="<%= it.notaMaxima %>"
                   autocomplete="off"
                   id="<%= it.prefixoNota %><%= linha.matriculaId %>"
                   name="<%= it.prefixoNota %><%= linha.matriculaId %>"
                   value="<%= linha.valor %>"
                   <% if (linha.erro) { %>aria-invalid="true" aria-describedby="<%= it.prefixos.erroDeCelula %><%= linha.matriculaId %>"<% } %>>
            <% if (linha.erro) { %>
            <p class="campo__erro" id="<%= it.prefixos.erroDeCelula %><%= linha.matriculaId %>"><%= linha.erro %></p>
            <% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

<% if (!fechado) { %>
  <div class="acoes">
    <button class="botao botao--primario" type="submit">Salvar notas do <%= it.rotuloDeBimestre(bimestre) %></button>
    <span class="suave">Campo deixado em branco apaga a nota já lançada daquele aluno.</span>
  </div>
</form>
<% } %>

<% } %>
