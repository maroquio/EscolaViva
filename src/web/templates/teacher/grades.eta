<%
const rows = it.rows ?? [];
const closed = it.closed === true;
const term = it.term;
const assignment = it.assignment;
const caption = `Notas do ${it.termLabel(term)}${it.separator}${assignment.subjectName}${it.separator}${assignment.classGroupName}`;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= assignment.classGroupName %><%= it.separator %><%= assignment.gradeLevel %><%= it.shiftSeparator %><%= assignment.shift %></p>
    <h1 class="page__title"><%= assignment.subjectName %></h1>
    <p class="page__summary">
      Lançamento de notas de <%= it.minGrade %> a <%= it.maxGrade %>, com uma casa decimal. O que estiver em branco no envio deixa de
      existir como nota do aluno neste bimestre.
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--quiet" href="<%= it.rollCallHref %>">Chamada</a>
    <a class="button button--quiet" href="<%= it.closingHref %>">Fechamento</a>
    <a class="button button--quiet" href="<%= it.routes.teacher.dashboard() %>"><%= it.titles.teacher.dashboard %></a>
  </p>
</div>

<nav class="actions" aria-label="Bimestre">
  <span class="overline">Bimestre</span>
  <% it.terms.forEach((number) => { %>
  <a class="button <%= number === term ? 'button--secondary' : 'button--quiet' %>"
     href="<%= it.formAction %>?<%= it.termParam %>=<%= number %>"
     <% if (number === term) { %>aria-current="page"<% } %>><%= number %>º</a>
  <% }) %>
</nav>

<% if (closed) { %>
<p class="notice notice--warning" role="status">
  O <%= it.termLabel(term) %> desta turma está fechado. As notas continuam visíveis, mas não podem
  mais ser alteradas — nem por aqui, nem por nenhum outro caminho do sistema.
</p>
<% } %>

<% if (rows.length === 0) { %>
<%~ include(it.partials.empty, {
  title: it.noEnrolledStudent,
  text: 'Esta turma não tem matrícula ativa, então não há nota a lançar. A matrícula é feita pela secretaria.',
}) %>
<% } else { %>

<% if (!closed) { %>
<form class="form form--wide" method="post" action="<%= it.formAction %>">
  <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
  <input type="hidden" name="<%= it.termField %>" value="<%= term %>">
<% } %>

  <div class="table-scroll">
    <table class="table">
      <caption><%= caption %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.student %></th>
          <th scope="col">Nota (<%= it.minGrade %> a <%= it.maxGrade %>)</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row) => { %>
        <tr>
          <th scope="row"><%= row.studentName %></th>
          <td class="number">
            <% if (closed) { %>
            <%= it.formatGrade(row.value === '' ? null : row.value) %>
            <% } else { %>
            <label class="visually-hidden" for="<%= it.gradePrefix %><%= row.enrollmentId %>">
              Nota de <%= row.studentName %> no <%= it.termLabel(term) %>

            </label>
            <input class="numeric-input"
                   type="number"
                   inputmode="decimal"
                   step="0.1"
                   min="<%= it.minGrade %>"
                   max="<%= it.maxGrade %>"
                   autocomplete="off"
                   id="<%= it.gradePrefix %><%= row.enrollmentId %>"
                   name="<%= it.gradePrefix %><%= row.enrollmentId %>"
                   value="<%= row.value %>"
                   <% if (row.error) { %>aria-invalid="true" aria-describedby="<%= it.prefixes.cellError %><%= row.enrollmentId %>"<% } %>>
            <% if (row.error) { %>
            <p class="field__error" id="<%= it.prefixes.cellError %><%= row.enrollmentId %>"><%= row.error %></p>
            <% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

<% if (!closed) { %>
  <div class="actions">
    <button class="button button--primary" type="submit">Salvar notas do <%= it.termLabel(term) %></button>
    <span class="muted">Campo deixado em branco apaga a nota já lançada daquele aluno.</span>
  </div>
</form>
<% } %>

<% } %>
