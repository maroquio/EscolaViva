<%
const states = it.states ?? [];
const classGroup = it.classGroup;
const subjects = classGroup.subjects ?? [];
const CLOSING_LABEL = it.closingLabel;
const CLOSING_CLASS = it.tagClass.closing;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= classGroup.gradeLevel %><%= it.shiftSeparator %><%= classGroup.shift %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Fechar um bimestre confere as notas de todos os alunos em todas as disciplinas da turma antes
      de gravar. A página só responde quando a conferência termina — em turmas grandes isso leva
      alguns segundos, e o bimestre fechado bloqueia qualquer alteração de nota daquele período.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= classGroup.rollCallHref %>">Chamada</a>
    <a class="botao botao--discreto" href="<%= it.routes.teacher.dashboard() %>"><%= it.titles.teacher.dashboard %></a>
  </p>
</div>

<ol class="pilha pilha--larga">
  <% states.forEach((state) => { %>
  <li class="quadro">
    <div class="secao__cabecalho">
      <h2><%= it.termLabel(state.term) %></h2>
      <span class="etiqueta <%= state.closed ? CLOSING_CLASS.closed : CLOSING_CLASS.open %>">
        <%= state.closed ? CLOSING_LABEL.closed : CLOSING_LABEL.open %>
      </span>
    </div>

    <% if (state.closed) { %>
    <dl class="lista-definicoes">
      <dt>Fechado em</dt>
      <dd><time class="numero" datetime="<%= state.closedAt %>"><%= it.formatDateTime(state.closedAt) %></time></dd>
    </dl>
    <p class="suave">As notas deste bimestre não podem mais ser alteradas.</p>
    <% } else { %>

    <% if (it.rejectedTerm === state.term) { %>
    <p class="campo__erro" id="<%= it.prefixes.pending %><%= state.term %>">
      Este bimestre não foi fechado: o aviso no topo da página diz quantas notas faltam e em quais
      disciplinas.
    </p>
    <% } %>

    <% if (subjects.length > 0) { %>
    <p class="suave">Minhas disciplinas nesta turma:</p>
    <ul class="linha">
      <% subjects.forEach((subject) => { %>
      <li>
        <a href="<%= subject.gradesHref %>?<%= it.termField %>=<%= state.term %>"><%= subject.subjectName %></a>
      </li>
      <% }) %>
    </ul>
    <% } %>

    <form class="acoes" method="post" action="<%= it.formAction %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <input type="hidden" name="<%= it.termField %>" value="<%= state.term %>">
      <button class="botao botao--primario" type="submit"
              <% if (it.rejectedTerm === state.term) { %>aria-describedby="<%= it.prefixes.pending %><%= state.term %>"<% } %>>
        Fechar <%= it.termLabel(state.term) %>

      </button>
      <span class="suave">A conferência é feita agora, com a página aberta.</span>
    </form>

    <% } %>
  </li>
  <% }) %>
</ol>
