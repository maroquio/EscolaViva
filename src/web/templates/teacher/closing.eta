<%
const states = it.states ?? [];
const classGroup = it.classGroup;
const subjects = classGroup.subjects ?? [];
const CLOSING_LABEL = it.closingLabel;
const CLOSING_CLASS = it.tagClass.closing;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= classGroup.gradeLevel %><%= it.shiftSeparator %><%= classGroup.shift %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Fechar um bimestre confere as notas de todos os alunos em todas as disciplinas da turma antes
      de gravar. A página só responde quando a conferência termina — em turmas grandes isso leva
      alguns segundos, e o bimestre fechado bloqueia qualquer alteração de nota daquele período.
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--quiet" href="<%= classGroup.rollCallHref %>">Chamada</a>
    <a class="button button--quiet" href="<%= it.routes.teacher.dashboard() %>"><%= it.titles.teacher.dashboard %></a>
  </p>
</div>

<ol class="stack stack--wide">
  <% states.forEach((state) => { %>
  <li class="panel">
    <div class="section__header">
      <h2><%= it.termLabel(state.term) %></h2>
      <span class="tag <%= state.closed ? CLOSING_CLASS.closed : CLOSING_CLASS.open %>">
        <%= state.closed ? CLOSING_LABEL.closed : CLOSING_LABEL.open %>
      </span>
    </div>

    <% if (state.closed) { %>
    <dl class="definition-list">
      <dt>Fechado em</dt>
      <dd><time class="number" datetime="<%= state.closedAt %>"><%= it.formatDateTime(state.closedAt) %></time></dd>
    </dl>
    <p class="muted">As notas deste bimestre não podem mais ser alteradas.</p>
    <% } else { %>

    <% if (it.rejectedTerm === state.term) { %>
    <p class="field__error" id="<%= it.prefixes.pending %><%= state.term %>">
      Este bimestre não foi fechado: o aviso no topo da página diz quantas notas faltam e em quais
      disciplinas.
    </p>
    <% } %>

    <% if (subjects.length > 0) { %>
    <p class="muted">Minhas disciplinas nesta turma:</p>
    <ul class="row">
      <% subjects.forEach((subject) => { %>
      <li>
        <a href="<%= subject.gradesHref %>?<%= it.termParam %>=<%= state.term %>"><%= subject.subjectName %></a>
      </li>
      <% }) %>
    </ul>
    <% } %>

    <form class="actions" method="post" action="<%= it.formAction %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <input type="hidden" name="<%= it.termField %>" value="<%= state.term %>">
      <button class="button button--primary" type="submit"
              <% if (it.rejectedTerm === state.term) { %>aria-describedby="<%= it.prefixes.pending %><%= state.term %>"<% } %>>
        Fechar <%= it.termLabel(state.term) %>

      </button>
      <span class="muted">A conferência é feita agora, com a página aberta.</span>
    </form>

    <% } %>
  </li>
  <% }) %>
</ol>
