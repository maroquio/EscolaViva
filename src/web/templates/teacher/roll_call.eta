<%
const rows = it.rows ?? [];
const date = it.date;
const classGroup = it.classGroup;
const caption = `Chamada de ${it.formatDate(date)}${it.separator}${classGroup.classGroupName}`;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= classGroup.gradeLevel %><%= it.shiftSeparator %><%= classGroup.shift %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Presença de um dia inteiro. A justificativa é o que o responsável informou sobre a falta, e
      aparece depois no acompanhamento de frequência do aluno.
    </p>
  </div>
  <p class="page__actions">
    <a class="button button--quiet" href="<%= classGroup.closingHref %>">Fechamento</a>
    <a class="button button--quiet" href="<%= it.routes.teacher.dashboard() %>"><%= it.titles.teacher.dashboard %></a>
  </p>
</div>

<div class="actions">
  <nav class="row" aria-label="Dia da chamada">
    <a class="button button--secondary" rel="prev"
       href="<%= it.formAction %>?<%= it.dateParam %>=<%= it.previousDay %>">
      Dia anterior<%= it.separator %><time class="number" datetime="<%= it.previousDay %>"><%= it.formatDate(it.previousDay) %></time>
    </a>
    <a class="button button--secondary" rel="next"
       href="<%= it.formAction %>?<%= it.dateParam %>=<%= it.nextDay %>">
      Dia seguinte<%= it.separator %><time class="number" datetime="<%= it.nextDay %>"><%= it.formatDate(it.nextDay) %></time>
    </a>
  </nav>

  <form class="row" method="get" action="<%= it.formAction %>">
    <label class="field__label" for="go-to-day">Ir para o dia</label>
    <span class="field">
      <input type="date" id="go-to-day" name="<%= it.dateParam %>" value="<%= date %>">
    </span>
    <button class="button button--secondary" type="submit">Abrir</button>
  </form>
</div>

<% if (rows.length === 0) { %>
<%~ include(it.partials.empty, {
  title: it.noEnrolledStudent,
  text: 'Esta turma não tem matrícula ativa, então não há chamada a registrar. A matrícula é feita pela secretaria.',
}) %>
<% } else { %>

<form class="form form--wide" method="post" action="<%= it.formAction %>">
  <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
  <input type="hidden" name="<%= it.dateField %>" value="<%= date %>">

  <div class="table-scroll">
    <table class="table">
      <caption><%= caption %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.student %></th>
          <th scope="col">Presente</th>
          <th scope="col">Justificativa da falta</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row) => { %>
        <tr>
          <th scope="row"><%= row.studentName %></th>
          <td>
            <label class="visually-hidden" for="<%= it.presentPrefix %><%= row.enrollmentId %>">
              <%= row.studentName %> esteve presente em <%= it.formatDate(date) %>
            </label>
            <input type="checkbox"
                   id="<%= it.presentPrefix %><%= row.enrollmentId %>"
                   name="<%= it.presentPrefix %><%= row.enrollmentId %>"
                   <% if (row.present) { %>checked<% } %>>
          </td>
          <td class="cell-text">
            <label class="visually-hidden" for="<%= it.excusePrefix %><%= row.enrollmentId %>">
              Justificativa da falta de <%= row.studentName %>
            </label>
            <input type="text"
                   autocomplete="off"
                   maxlength="<%= it.excuseLimit %>"
                   id="<%= it.excusePrefix %><%= row.enrollmentId %>"
                   name="<%= it.excusePrefix %><%= row.enrollmentId %>"
                   value="<%= row.excuse %>">
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="actions">
    <button class="button button--primary" type="submit">Salvar chamada</button>
    <span class="muted">Todos começam presentes: desmarque quem faltou.</span>
  </div>
</form>

<% } %>
