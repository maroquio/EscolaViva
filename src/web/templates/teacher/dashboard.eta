<%
const classGroups = it.classGroups ?? [];

const classGroupDomId = (classGroupId) => `class-group-${classGroupId}`;
%>
<div class="page__header">
  <div>
    <p class="overline">Professor</p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      As turmas em que você leciona nesta rede. Cada disciplina abre o diário de notas; a chamada e o
      fechamento valem para a turma inteira.
    </p>
  </div>
</div>

<% if (classGroups.length === 0) { %>
<%~ include(it.partials.empty, {
  title: 'Nenhuma turma alocada',
  text: 'Você ainda não foi alocado como professor em nenhuma disciplina desta rede. A alocação é feita pela secretaria, na tela da turma.',
}) %>
<% } %>

<% classGroups.forEach((classGroup) => { %>
<section class="section" aria-labelledby="<%= classGroupDomId(classGroup.classGroupId) %>">
  <div class="section__header">
    <h2 id="<%= classGroupDomId(classGroup.classGroupId) %>"><%= classGroup.classGroupName %></h2>
    <p class="section__note"><%= classGroup.gradeLevel %><%= it.shiftSeparator %><%= classGroup.shift %></p>
  </div>

  <div class="dashboard">
    <% classGroup.subjects.forEach((subject) => { %>
    <a class="card" href="<%= subject.gradesHref %>">
      <span class="card__label"><%= it.labels.subject %></span>
      <strong><%= subject.subjectName %></strong>
      <span class="card__detail">Lançar notas do bimestre</span>
    </a>
    <% }) %>
  </div>

  <div class="actions">
    <a class="button button--secondary" href="<%= classGroup.rollCallHref %>">Chamada do dia</a>
    <a class="button button--secondary" href="<%= classGroup.closingHref %>">Fechamento de bimestre</a>
  </div>
</section>
<% }) %>
