<%
const classGroups = it.classGroups ?? [];

const classGroupDomId = (classGroupId) => `turma-${classGroupId}`;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Professor</p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      As turmas em que você leciona nesta rede. Cada disciplina abre o diário de notas; a chamada e o
      fechamento valem para a turma inteira.
    </p>
  </div>
</div>

<% if (classGroups.length === 0) { %>
<%~ include(it.partials.empty, {
  title: 'Nenhuma turma alocada',
  text: 'Você ainda não foi alocado como professor em nenhuma disciplina desta rede. A alocação é feita pela secretaria, na tela da turma.',
}) %>
<% } %>

<% classGroups.forEach((classGroup) => { %>
<section class="secao" aria-labelledby="<%= classGroupDomId(classGroup.classGroupId) %>">
  <div class="secao__cabecalho">
    <h2 id="<%= classGroupDomId(classGroup.classGroupId) %>"><%= classGroup.classGroupName %></h2>
    <p class="secao__nota"><%= classGroup.gradeLevel %><%= it.shiftSeparator %><%= classGroup.shift %></p>
  </div>

  <div class="painel">
    <% classGroup.subjects.forEach((subject) => { %>
    <a class="cartao" href="<%= subject.gradesHref %>">
      <span class="cartao__rotulo"><%= it.labels.subject %></span>
      <strong><%= subject.subjectName %></strong>
      <span class="cartao__detalhe">Lançar notas do bimestre</span>
    </a>
    <% }) %>
  </div>

  <div class="acoes">
    <a class="botao botao--secundario" href="<%= classGroup.rollCallHref %>">Chamada do dia</a>
    <a class="botao botao--secundario" href="<%= classGroup.closingHref %>">Fechamento de bimestre</a>
  </div>
</section>
<% }) %>
