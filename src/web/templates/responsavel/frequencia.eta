<%
/*
  Frequência dia a dia.

  A chamada do EscolaViva é por DIA, não por aula: cada linha desta tabela é uma data em que a
  turma teve chamada registrada, e a justificativa é o texto que a secretaria recebeu.

  A etiqueta carrega a cor, o texto carrega o significado — "Falta justificada" continua se lendo
  em preto e branco, e a diferença entre falta com e sem justificativa não depende de enxergar
  âmbar ou vermelho.

  Os dois endereços da tela — o boletim da mesma matrícula e a volta para a lista de alunos — saem
  de `it.rotas`, o mesmo mapa que o router registra, e o `:id` é preenchido por quem sabe escapá-lo.
  URL literal em `.eta` não quebra compilação: quebra a tela de quem clica.

  Os caminhos das parciais incluídas seguem a mesma regra: chegam em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo.

  A linha de resumo do cabeçalho emenda dois atributos da matrícula — a turma e o ano letivo — e a
  marca que os separa é `it.apresentacao.separador`, `APRESENTACAO.separador`
  (`src/web/constantes.ts`). É exatamente o trabalho para o qual ele existe, e é o mesmo que
  `secretaria/turma.eta` já lhe dá na linha que junta série, turno, unidade e ano letivo. Os espaços
  em volta do "·" são metade do valor: quem apertar ou afrouxar o espaçamento do sistema mexe num
  lugar só. Por isso a palavra seguinte encosta na tag, sem espaço entre as duas — o espaço que falta
  no texto é o que a constante devolve, e o HTML servido sai igual ao de antes.
*/
const boletim = it.boletim;
const dias = it.dias;
const faltas = boletim.totalDias - boletim.presencas;

/*
  `VOCABULARIO.presenca` (`src/avaliacao/constantes.ts`) entregue pela rota em `it.rotuloDaPresenca`.
  O Eta não importa TypeScript, então quem lê `constantes.ts` é o handler — e as três palavras
  existem uma vez só, no módulo que decide o que conta como falta justificada.
*/
const ROTULO_DA_PRESENCA = it.rotuloDaPresenca;

/*
  A cor da etiqueta acompanha o rótulo, e não o substitui. Classe de CSS é vocabulário da folha de
  estilo, e por isso mora aqui e não em `constantes.ts`.
*/
const CLASSE_DA_PRESENCA = {
  presente: 'etiqueta--ativa',
  faltaJustificada: 'etiqueta--transferida',
  falta: 'etiqueta--reprovado',
};

/** `AUSENTE` (`src/shared/constantes.ts`), pela rota: célula sem valor mostra um travessão. */
const SEM_VALOR = it.semValor;

/*
  O piso de frequência escrito na tela chega pronto em `it.criterio`, o MESMO objeto que o boletim
  recebe, derivado de `APROVACAO.frequenciaMinimaEmCentesimos`. Escrever "75 %" à mão aqui era a
  terceira cópia do piso — e a única que ninguém acompanharia no dia em que ele mudasse.
*/
const CRITERIO = it.criterio;

const situacaoDoDia = (dia) => {
  if (dia.presente) {
    return { classe: CLASSE_DA_PRESENCA.presente, rotulo: ROTULO_DA_PRESENCA.presente };
  }
  if (dia.justificativa) {
    return {
      classe: CLASSE_DA_PRESENCA.faltaJustificada,
      rotulo: ROTULO_DA_PRESENCA.faltaJustificada,
    };
  }
  return { classe: CLASSE_DA_PRESENCA.falta, rotulo: ROTULO_DA_PRESENCA.falta };
};
%>
<header class="pagina__cabecalho">
  <div>
<%
// O sobretítulo nomeia o DOCUMENTO aberto — "Boletim", "Comunicado", "Frequência" —, e não a área
// do menu: quem imprime `it.areas.acompanhamento` são as telas de fora, o painel e o mural. %>
    <p class="sobretitulo">Frequência</p>
    <h1 class="pagina__titulo"><%= it.matricula.alunoNome %></h1>
    <p class="pagina__resumo">
<%
// A linha se lê corrida — "Turma 5º A · ano letivo 2026" —, e a marca do meio vem de
// `it.apresentacao.separador`. "ano letivo" é prosa: o 2026 é o NOME do ano, não uma contagem. %>
      Turma <%= it.matricula.turmaNome %><%= it.apresentacao.separador %>ano letivo
      <span class="numero"><%= it.matricula.ano %></span>
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario"
       href="<%= it.rotas.responsavel.boletim({ id: it.matricula.id }) %>">Ver boletim</a>
    <a class="botao botao--discreto" href="<%= it.rotas.responsavel.painel() %>"><%= it.acoes.voltarPara.alunos %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-apuracao">
  <div class="secao__cabecalho">
    <h2 id="titulo-apuracao">Apuração do ano</h2>
    <p class="secao__nota">São necessários <%= CRITERIO.frequencia %> de presença para aprovação</p>
  </div>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo"><%= it.rotulos.frequencia %></p>
      <p class="cartao__numero"><%= it.formatarPercentual(boletim.percentualFrequencia) %></p>
      <p class="cartao__detalhe">Presenças sobre dias com chamada</p>
    </div>

    <div class="cartao">
      <p class="cartao__rotulo">Presenças</p>
      <p class="cartao__numero"><%= boletim.presencas %></p>
      <p class="cartao__detalhe">
        de <span class="numero"><%= boletim.totalDias %></span> dias registrados
      </p>
    </div>

    <div class="cartao">
      <p class="cartao__rotulo">Faltas</p>
      <p class="cartao__numero"><%= faltas %></p>
      <p class="cartao__detalhe">Justificadas e não justificadas</p>
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-dias">
  <div class="secao__cabecalho">
    <h2 id="titulo-dias">Dia a dia</h2>
    <p class="secao__nota">Do dia mais recente para o mais antigo</p>
  </div>

  <% if (dias.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum dia de chamada registrado',
      texto: 'A frequência aparece aqui assim que o professor registrar a primeira chamada da turma.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Chamada de <%= it.matricula.alunoNome %></caption>
      <thead>
        <tr>
          <th scope="col" class="celula-centro">Data</th>
<%
// "Situação" encabeça cinco colunas do sistema, cada uma com um vocabulário fechado diferente, de
// quatro módulos; um dono único prometeria que as cinco mudam juntas. Ver `ROTULOS`, em
// `web/constantes.ts`.
// magic-values: permitido — cabeça genérica de cinco vocabulários de estado distintos; por isso não é membro de `it.rotulos`. %>
          <th scope="col" class="celula-centro">Situação</th>
          <th scope="col" class="celula-texto celula-elastica">Justificativa</th>
        </tr>
      </thead>
      <tbody>
        <% dias.forEach((dia) => { const situacao = situacaoDoDia(dia); %>
        <tr>
          <th scope="row" class="celula-centro">
            <time datetime="<%= dia.data %>"><%= it.formatarData(dia.data) %></time>
          </th>
          <td class="celula-centro">
            <span class="etiqueta <%= situacao.classe %>"><%= situacao.rotulo %></span>
          </td>
          <td class="celula-texto celula-elastica">
            <%= dia.justificativa ? dia.justificativa : SEM_VALOR %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: 'dias registrados' }) %>
  <% } %>
</section>
