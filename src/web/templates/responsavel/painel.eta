<%
/*
  Painel do responsável: quem ele acompanha, e o que a escola disse que ele ainda não leu.

  A ordem da página é a ordem da pergunta que traz o responsável até aqui — "como está meu filho?"
  primeiro, "o que a escola falou?" logo em seguida. Por isso os alunos vêm antes do mural, e o
  mural aparece aqui só com o que está por ler: o que já foi lido mora na própria tela do mural.
*/
const matriculas = it.matriculas;
const naoLidos = it.naoLidos;

const CLASSE_DA_SITUACAO = {
  ativa: 'etiqueta--ativa',
  transferida: 'etiqueta--transferida',
  cancelada: '',
  concluida: '',
};

const ROTULO_DA_SITUACAO = {
  ativa: 'Ativa',
  transferida: 'Transferida',
  cancelada: 'Cancelada',
  concluida: 'Concluída',
};
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Acompanhamento</p>
    <h1 class="pagina__titulo">Meus alunos</h1>
    <p class="pagina__resumo">
      Boletim, frequência e comunicados dos alunos sob sua responsabilidade.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario" href="/responsavel/mural">Abrir o mural</a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resumo">
  <h2 class="visualmente-oculto" id="titulo-resumo">Resumo</h2>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo">Alunos acompanhados</p>
      <p class="cartao__numero"><%= matriculas.length %></p>
      <p class="cartao__detalhe">Matrículas ligadas ao seu cadastro</p>
    </div>

    <a class="cartao" href="/responsavel/mural">
      <span class="cartao__rotulo">Comunicados por ler</span>
      <span class="cartao__numero"><%= naoLidos.length %></span>
      <span class="cartao__detalhe">
        <%= it.totalNoMural %> <%= it.totalNoMural === 1 ? 'comunicado' : 'comunicados' %> no mural
      </span>
    </a>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-alunos">
  <div class="secao__cabecalho">
    <h2 id="titulo-alunos">Alunos</h2>
    <p class="secao__nota">Uma matrícula por ano letivo</p>
  </div>

  <% if (matriculas.length === 0) { %>
    <%~ include("/parciais/_vazio", {
      titulo: 'Nenhum aluno vinculado à sua conta',
      texto: 'O vínculo entre você e o aluno é feito pela secretaria da unidade. Enquanto ele não existir, esta tela fica vazia — procure a secretaria da escola para conferir seu cadastro.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Matrículas sob sua responsabilidade</caption>
      <thead>
        <tr>
          <th scope="col">Aluno</th>
          <th scope="col">Turma</th>
          <th scope="col">Ano</th>
          <th scope="col">Matrícula</th>
          <th scope="col">Acompanhar</th>
        </tr>
      </thead>
      <tbody>
        <% matriculas.forEach((matricula) => { %>
        <tr>
          <th scope="row"><%= matricula.alunoNome %></th>
          <td class="celula-texto"><%= matricula.turmaNome %></td>
          <td class="numero"><%= matricula.ano %></td>
          <td>
            <span class="etiqueta <%= CLASSE_DA_SITUACAO[matricula.situacao] %>">
              <%= ROTULO_DA_SITUACAO[matricula.situacao] %>
            </span>
          </td>
          <td>
            <span class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo"
                 href="/responsavel/matriculas/<%= matricula.id %>/boletim">
                Boletim<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span>
              </a>
              <a class="botao botao--secundario botao--miudo"
                 href="/responsavel/matriculas/<%= matricula.id %>/frequencia">
                Frequência<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span>
              </a>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-nao-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-nao-lidos">Comunicados por ler</h2>
    <p class="secao__nota"><a href="/responsavel/mural">Ver o mural completo</a></p>
  </div>

  <% if (naoLidos.length === 0) { %>
    <%~ include("/parciais/_vazio", {
      titulo: 'Nada por ler',
      texto: 'Todos os comunicados enviados a você já foram marcados como lidos.',
      acao: { href: '/responsavel/mural', texto: 'Ver comunicados anteriores' },
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% naoLidos.forEach((item) => { %>
    <li class="quadro">
      <p class="linha">
        <span class="etiqueta etiqueta--em-curso">Por ler</span>
        <time class="suave" datetime="<%= item.publicadoEm %>">
          <%= it.formatarDataHora(item.publicadoEm) %>
        </time>
      </p>
      <h3>
        <a href="/responsavel/mural/<%= item.comunicadoId %>"><%= item.titulo %></a>
      </h3>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
