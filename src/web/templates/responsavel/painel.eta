<%
const matriculas = it.matriculas;
const naoLidos = it.naoLidos;

const CLASSE_DA_SITUACAO = {
  ativa: 'etiqueta--ativa',
  transferida: 'etiqueta--transferida',
  cancelada: '',
  concluida: '',
};

const ROTULO_DA_SITUACAO = it.rotuloDaSituacao;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.acompanhamento %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Boletim, frequência e comunicados dos alunos sob sua responsabilidade.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.rotas.responsavel.mural() %>">Abrir o mural</a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resumo">
  <h2 class="visualmente-oculto" id="titulo-resumo">Resumo</h2>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo">Alunos acompanhados</p>
      <p class="cartao__numero"><%= it.navegacao === undefined ? matriculas.length : it.navegacao.total %></p>
      <p class="cartao__detalhe">Matrículas ligadas ao seu cadastro</p>
    </div>

    <a class="cartao" href="<%= it.rotas.responsavel.mural() %>">
      <span class="cartao__rotulo">Comunicados não lidos</span>
      <span class="cartao__numero"><%= it.totalNaoLidos %></span>
      <span class="cartao__detalhe">
        <%= it.totalNoMural %> <%= it.pluralizar(it.totalNoMural, it.contagem.comunicado) %> no mural
      </span>
    </a>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-alunos">
  <div class="secao__cabecalho">
    <h2 id="titulo-alunos">Alunos</h2>
    <p class="secao__nota">Uma matrícula por ano letivo</p>
  </div>

  <% if (matriculas.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum aluno vinculado à sua conta',
      texto: 'O vínculo entre você e o aluno é feito pela secretaria da unidade. Enquanto ele não existir, esta tela fica vazia — procure a secretaria da escola para conferir seu cadastro.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Matrículas sob sua responsabilidade</caption>
      <thead>
        <tr>
          <th class="celula-elastica" scope="col"><%= it.rotulos.aluno %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.turma %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.ano %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.matricula %></th>
          <th class="celula-centro" scope="col">Acompanhar</th>
        </tr>
      </thead>
      <tbody>
        <% matriculas.forEach((matricula) => { %>
        <tr>
          <th class="celula-elastica" scope="row"><%= matricula.alunoNome %></th>
          <td class="celula-centro"><%= matricula.turmaNome %></td>
          <td class="numero celula-centro"><%= matricula.ano %></td>
          <td class="celula-centro">
            <span class="etiqueta <%= CLASSE_DA_SITUACAO[matricula.situacao] %>">
              <%= ROTULO_DA_SITUACAO[matricula.situacao] %>
            </span>
          </td>
          <td class="celula-centro">
            <span class="tabela__acoes">
                            <a class="botao botao--secundario botao--miudo"
                 href="<%= it.rotas.responsavel.boletim({ id: matricula.id }) %>">
                Boletim<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span></a>
              <a class="botao botao--secundario botao--miudo"
                 href="<%= it.rotas.responsavel.frequencia({ id: matricula.id }) %>">
<% // magic-values: permitido — rótulo do link que abre a tela de frequência, par do "Boletim" da linha acima; não é `ROTULOS.frequencia`, que nomeia a TAXA no cartão do boletim %>
                Frequência<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span></a>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: it.contagem.matricula.plural }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-nao-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-nao-lidos">Comunicados não lidos</h2>
    <p class="secao__nota"><a href="<%= it.rotas.responsavel.mural() %>">Ver o mural completo</a></p>
  </div>

  <% if (naoLidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nada por ler',
      texto: 'Todos os comunicados enviados a você já foram marcados como lidos.',
      acao: { href: it.rotas.responsavel.mural(), texto: 'Ver comunicados anteriores' },
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% naoLidos.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publicadoEm %>">
            <%= it.formatarDataHora(item.publicadoEm) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
