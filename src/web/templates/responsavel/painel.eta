<%
/*
  Painel do responsável: quem ele acompanha, e o que a escola disse que ele ainda não leu.

  A ordem da página é a ordem da pergunta que traz o responsável até aqui — "como está meu filho?"
  primeiro, "o que a escola falou?" logo em seguida. Por isso os alunos vêm antes do mural, e o
  mural aparece aqui só com o que está por ler: o que já foi lido mora na própria tela do mural.

  É a tela com mais saídas do responsável, e nenhuma delas é escrita à mão. Só o mural aparece
  quatro vezes — no botão do cabeçalho, no cartão de não lidos, na chamada da seção e na ação do
  estado vazio —, e ainda saem daqui o boletim e a frequência de cada linha da tabela e o
  comunicado de cada item por ler. Todas vêm de `it.rotas`, o mesmo mapa que o router registra,
  com o `:id` preenchido por quem sabe escapá-lo. Escrito à mão, o caminho do mural seriam quatro
  cópias que podem divergir de uma ponta só, e o botão do cabeçalho continuaria levando ao lugar
  certo enquanto o cartão logo abaixo apontaria para o vazio. URL literal em `.eta` não quebra
  compilação: quebra a tela de quem clica.

  Os caminhos das parciais incluídas seguem a mesma regra: chegam em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo.

  O `rotulo` que vai para a barra de paginação também não se escreve aqui. É o substantivo contável
  pelado — sem recorte, sem adjetivo —, e substantivo contável tem dono: `CONTAGEM.matricula`, que
  chega em `it.contagem`, o mesmo par singular/plural que o cartão dos comunicados lê algumas linhas
  acima e que `secretaria/aluno.eta` passa a ESTE mesmo include, no MESMO parâmetro, para ESTA mesma
  palavra. Fossem duas cópias, renomear o substantivo numa tela deixaria a outra contando a palavra
  antiga. O que fica escrito na tela são os rótulos QUALIFICADOS, do tipo dos que a lista de alunos e
  a tela de frequência usam: aqueles descrevem o recorte daquela tabela, existem uma vez só e são
  decisão de quem desenhou a tela — não do substantivo.

  O "Alunos" do `<h2>` mais abaixo NÃO vem de `it.titulos`, e não é esquecimento. Ele nomeia uma
  SEÇÃO desta página — a tabela de quem está sob a responsabilidade de quem abriu — e se escreve
  igual a `TITULOS.secretaria.alunos` por serem a mesma palavra do domínio, não a mesma decisão: o
  responsável nem enxerga a tela da secretaria, e renomeá-la não pode renomear esta seção. A
  justificativa que `scripts/magic-values.ts` exige fica na linha acima do literal, e encostada na
  margem de propósito: o Eta guarda o que vier ANTES de um `<%` como texto do documento, então
  indentar o comentário empurraria a linha seguinte dois espaços para a direita no HTML servido.

  Os dois mapas de situação logo abaixo parecem irmãos e não são. O RÓTULO — "Ativa",
  "Transferida" — é vocabulário do domínio, e quem acrescenta uma situação de matrícula é
  `academico`: por isso ele chega pronto em `it.rotuloDaSituacao`, passado pelo handler, e não
  redigitado aqui. Enquanto as quatro palavras moravam neste arquivo, uma situação nova nascia
  aparecendo como código cru na tabela, e nada acusava. A CLASSE fica: `etiqueta--ativa` é
  vocabulário da folha de estilo, não tem dono em `constantes.ts` nenhum, e é esta tela que decide
  como pinta o que mostra.
*/
const matriculas = it.matriculas;
const naoLidos = it.naoLidos;

const CLASSE_DA_SITUACAO = {
  ativa: 'etiqueta--ativa',
  transferida: 'etiqueta--transferida',
  cancelada: '',
  concluida: '',
};

const ROTULO_DA_SITUACAO = it.rotuloDaSituacao;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.acompanhamento %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Boletim, frequência e comunicados dos alunos sob sua responsabilidade.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.rotas.responsavel.mural() %>">Abrir o mural</a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resumo">
  <h2 class="visualmente-oculto" id="titulo-resumo">Resumo</h2>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo">Alunos acompanhados</p>
      <p class="cartao__numero"><%= it.navegacao === undefined ? matriculas.length : it.navegacao.total %></p>
      <p class="cartao__detalhe">Matrículas ligadas ao seu cadastro</p>
    </div>

    <a class="cartao" href="<%= it.rotas.responsavel.mural() %>">
      <span class="cartao__rotulo">Comunicados não lidos</span>
      <span class="cartao__numero"><%= it.totalNaoLidos %></span>
      <span class="cartao__detalhe">
        <%= it.totalNoMural %> <%= it.pluralizar(it.totalNoMural, it.contagem.comunicado) %> no mural
      </span>
    </a>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-alunos">
  <div class="secao__cabecalho">
<% // "Alunos" nomeia esta seção do painel, e não a tela `TITULOS.secretaria.alunos` da secretaria. %>
    <h2 id="titulo-alunos">Alunos</h2>
    <p class="secao__nota">Uma matrícula por ano letivo</p>
  </div>

  <% if (matriculas.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum aluno vinculado à sua conta',
      texto: 'O vínculo entre você e o aluno é feito pela secretaria da unidade. Enquanto ele não existir, esta tela fica vazia — procure a secretaria da escola para conferir seu cadastro.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Matrículas sob sua responsabilidade</caption>
      <thead>
        <tr>
          <th class="celula-elastica" scope="col"><%= it.rotulos.aluno %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.turma %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.ano %></th>
          <th class="celula-centro" scope="col"><%= it.rotulos.matricula %></th>
          <th class="celula-centro" scope="col">Acompanhar</th>
        </tr>
      </thead>
      <tbody>
        <% matriculas.forEach((matricula) => { %>
        <tr>
          <th class="celula-elastica" scope="row"><%= matricula.alunoNome %></th>
          <td class="celula-centro"><%= matricula.turmaNome %></td>
          <td class="numero celula-centro"><%= matricula.ano %></td>
          <td class="celula-centro">
            <span class="etiqueta <%= CLASSE_DA_SITUACAO[matricula.situacao] %>">
              <%= ROTULO_DA_SITUACAO[matricula.situacao] %>
            </span>
          </td>
          <td class="celula-centro">
            <span class="tabela__acoes">
              <%
                /* O fecho da âncora vem colado ao rótulo oculto de propósito: uma quebra de
                   linha ali vira um item vazio no flex do botão, e o `gap` tira o texto
                   visível do centro. */
              %>
              <a class="botao botao--secundario botao--miudo"
                 href="<%= it.rotas.responsavel.boletim({ id: matricula.id }) %>">
                Boletim<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span></a>
              <a class="botao botao--secundario botao--miudo"
                 href="<%= it.rotas.responsavel.frequencia({ id: matricula.id }) %>">
<% // magic-values: permitido — rótulo do link que abre a tela de frequência, par do "Boletim" da linha acima; não é `ROTULOS.frequencia`, que nomeia a TAXA no cartão do boletim %>
                Frequência<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span></a>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: it.contagem.matricula.plural }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-nao-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-nao-lidos">Comunicados não lidos</h2>
    <p class="secao__nota"><a href="<%= it.rotas.responsavel.mural() %>">Ver o mural completo</a></p>
  </div>

  <% if (naoLidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nada por ler',
      texto: 'Todos os comunicados enviados a você já foram marcados como lidos.',
      acao: { href: it.rotas.responsavel.mural(), texto: 'Ver comunicados anteriores' },
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% naoLidos.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publicadoEm %>">
            <%= it.formatarDataHora(item.publicadoEm) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
