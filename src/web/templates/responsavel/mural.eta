<%
const naoLidos = it.naoLidos;
const lidos = it.lidos;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.acompanhamento %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O que a escola enviou a você. Cada comunicado abre por inteiro e pode ser marcado como lido.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.rotas.responsavel.painel() %>"><%= it.acoes.voltarPara.alunos %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-por-ler">
  <div class="secao__cabecalho">
    <h2 id="titulo-por-ler">Não lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.totalNaoLidos %></span>
      <%= it.pluralizar(it.totalNaoLidos, it.contagem.comunicado) %>
    </p>
  </div>

  <% if (naoLidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nada por ler',
      texto: 'Todos os comunicados enviados a você já foram marcados como lidos.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% naoLidos.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publicadoEm %>">
            <%= it.formatarDataHora(item.publicadoEm) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.parciais.paginacao, {
    navegacao: it.navegacaoNaoLidos, rotulo: 'comunicados não lidos'
  }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-lidos">Já lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.totalLidos %></span>
      <%= it.pluralizar(it.totalLidos, it.contagem.comunicado) %>
    </p>
  </div>

  <% if (lidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum comunicado marcado como lido',
      texto: 'Ao abrir um comunicado, use o botão "Marcar como lido" para que a escola saiba que a mensagem chegou.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% lidos.forEach((item) => { %>
    <li class="linha">
      <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
      <span class="suave">
        publicado em
        <time datetime="<%= item.publicadoEm %>"><%= it.formatarData(item.publicadoEm) %></time>
       <%= it.apresentacao.separador %>lido em
        <time datetime="<%= item.lidoEm %>"><%= it.formatarDataHora(item.lidoEm) %></time>
      </span>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.parciais.paginacao, {
    navegacao: it.navegacaoLidos, rotulo: 'comunicados lidos'
  }) %>
  <% } %>
</section>
