<%
/*
  Mural de comunicados do responsável.

  Duas listas, e a diferença entre elas é a hierarquia da página: o que está por ler ganha cartão,
  título grande e etiqueta; o que já foi lido vira uma linha discreta com a data da leitura. É a
  mesma informação em dois pesos — e o peso é o que diz onde olhar primeiro.

  Nada nesta tela marca leitura. Abrir o comunicado é navegação; marcar como lido é uma escrita
  que o responsável faz por escolha, com um botão, na página do próprio comunicado.

  As duas listas levam ao mesmo endereço de comunicado, e ele sai de `it.rotas` — o mesmo mapa que
  o router registra —, com o `:comunicadoId` preenchido por quem sabe escapá-lo. Escrito à mão,
  seriam duas cópias do caminho que podem divergir de um lado só, e a metade lida do mural
  continuaria apontando para o lugar certo enquanto a não lida apontaria para o vazio. URL literal
  em `.eta` não quebra compilação: quebra a tela de quem clica.

  Os caminhos das parciais incluídas seguem a mesma regra: chegam em `it.parciais`, o mesmo
  `TEMPLATES.parciais` que `render.ts` usa para achar o arquivo.

  As duas notas de contagem dizem "comunicado"/"comunicados" com `it.pluralizar` sobre
  `it.contagem.comunicado`: singular e plural são uma decisão só, e as duas seções contam a MESMA
  coisa em pesos diferentes — escrever o ternário duas vezes deixaria a metade lida do mural livre
  para divergir da não lida na palavra que ambas contam.
*/

/*
  Na linha de cada comunicado já lido, o "·" que separa a data de publicação da data de leitura é
  `it.apresentacao.separador` — `APRESENTACAO` (`src/web/constantes.ts`), a mesma marca com que os
  sobretítulos de nove telas juntam a área do menu e o nome da tela. O trabalho é o mesmo: emendar
  dois fatos numa linha só. Escrito à mão, esta seria a décima ocorrência da marca tipográfica, e
  trocá-la em `APRESENTACAO` deixaria o mural pontuando de um jeito que nenhuma outra tela usa.

  O valor da constante é ` · `, com um espaço de cada lado: os espaços são metade da decisão, e não
  indentação do template. Por isso a linha que a imprime começa UM espaço à esquerda das vizinhas —
  o espaço que falta no recuo é o que a constante devolve, e o HTML servido sai com os mesmos oito
  espaços de antes. Alinhá-la com as irmãs acrescentaria um nono espaço ao texto renderizado.
*/
const naoLidos = it.naoLidos;
const lidos = it.lidos;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.acompanhamento %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O que a escola enviou a você. Cada comunicado abre por inteiro e pode ser marcado como lido.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.rotas.responsavel.painel() %>"><%= it.acoes.voltarPara.alunos %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-por-ler">
  <div class="secao__cabecalho">
    <h2 id="titulo-por-ler">Não lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.totalNaoLidos %></span>
      <%= it.pluralizar(it.totalNaoLidos, it.contagem.comunicado) %>
    </p>
  </div>

  <% if (naoLidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nada por ler',
      texto: 'Todos os comunicados enviados a você já foram marcados como lidos.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% naoLidos.forEach((item) => { %>
    <li class="quadro">
      <div class="linha linha--entre">
        <h3>
          <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
        </h3>
        <span class="linha">
          <time class="suave" datetime="<%= item.publicadoEm %>">
            <%= it.formatarDataHora(item.publicadoEm) %>
          </time>
          <span class="etiqueta etiqueta--em-curso">Não lido</span>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.parciais.paginacao, {
    navegacao: it.navegacaoNaoLidos, rotulo: 'comunicados não lidos'
  }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="titulo-lidos">
  <div class="secao__cabecalho">
    <h2 id="titulo-lidos">Já lidos</h2>
    <p class="secao__nota">
      <span class="numero"><%= it.totalLidos %></span>
      <%= it.pluralizar(it.totalLidos, it.contagem.comunicado) %>
    </p>
  </div>

  <% if (lidos.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhum comunicado marcado como lido',
      texto: 'Ao abrir um comunicado, use o botão "Marcar como lido" para que a escola saiba que a mensagem chegou.',
    }) %>
  <% } else { %>
  <ul class="pilha">
    <% lidos.forEach((item) => { %>
    <li class="linha">
      <a href="<%= it.rotas.responsavel.comunicado({ comunicadoId: item.comunicadoId }) %>"><%= item.titulo %></a>
      <span class="suave">
        publicado em
        <time datetime="<%= item.publicadoEm %>"><%= it.formatarData(item.publicadoEm) %></time>
       <%= it.apresentacao.separador %>lido em
        <time datetime="<%= item.lidoEm %>"><%= it.formatarDataHora(item.lidoEm) %></time>
      </span>
    </li>
    <% }) %>
  </ul>
  <%~ include(it.parciais.paginacao, {
    navegacao: it.navegacaoLidos, rotulo: 'comunicados lidos'
  }) %>
  <% } %>
</section>
