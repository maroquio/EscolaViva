<%
const boletim = it.boletim;

const criterio = it.criterio;

const CLASSE_DA_SITUACAO = {
  aprovado: 'etiqueta--aprovado',
  reprovado: 'etiqueta--reprovado',
  em_curso: 'etiqueta--em-curso',
};

const ROTULO_DA_SITUACAO = it.rotuloDaSituacao;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Boletim</p>
    <h1 class="pagina__titulo"><%= boletim.alunoNome %></h1>
    <p class="pagina__resumo">
      <%= it.rotulos.turma %> <%= boletim.turmaNome %><%= it.apresentacao.separador %>ano letivo <span class="numero"><%= boletim.ano %></span>
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--secundario"
       href="<%= it.rotas.responsavel.frequencia({ id: it.matriculaId }) %>">Ver frequência</a>
    <a class="botao botao--discreto" href="<%= it.rotas.responsavel.painel() %>"><%= it.acoes.voltarPara.alunos %></a>
  </p>
</header>

<section class="secao" aria-labelledby="titulo-resultado">
  <div class="secao__cabecalho">
    <h2 id="titulo-resultado">Resultado do ano</h2>
    <p class="secao__nota">Apurado a cada leitura, a partir das notas e da chamada</p>
  </div>

  <div class="pilha">
    <div class="painel">
      <div class="cartao">
        <p class="cartao__rotulo">Média geral</p>
        <p class="cartao__numero"><%= it.formatarNota(boletim.mediaGeral) %></p>
        <p class="cartao__detalhe">Média simples das disciplinas cursadas</p>
      </div>

      <div class="cartao">
        <p class="cartao__rotulo"><%= it.rotulos.frequencia %></p>
        <p class="cartao__numero"><%= it.formatarPercentual(boletim.percentualFrequencia) %></p>
        <p class="cartao__detalhe">
          <span class="numero"><%= boletim.presencas %></span> de
          <span class="numero"><%= boletim.totalDias %></span> dias com chamada registrada
        </p>
      </div>

      <div class="cartao">
<% // magic-values: permitido — substantivo genérico que encabeça cinco vocabulários de estado distintos; não é o rótulo de um dado só, e por isso não entra em ROTULOS %>
        <p class="cartao__rotulo">Situação</p>
        <p>
          <span class="etiqueta <%= CLASSE_DA_SITUACAO[boletim.situacao] %>">
            <%= ROTULO_DA_SITUACAO[boletim.situacao] %>
          </span>
        </p>
        <p class="cartao__detalhe">Critério: média <%= criterio.media %> e frequência <%= criterio.frequencia %></p>
      </div>
    </div>

    <p class="suave">
      A situação sai destes dois números: é aprovado quem termina o ano com média final de
      <strong><%= criterio.media %> ou mais</strong> e frequência de <strong><%= criterio.frequencia %> ou mais</strong> — as duas
      condições ao mesmo tempo. Enquanto algum bimestre não estiver fechado, ou faltar nota em
      alguma disciplina, o ano permanece em curso e ninguém é reprovado por lançamento que ainda
      não aconteceu.
    </p>
  </div>
</section>

<section class="secao" aria-labelledby="titulo-notas">
  <div class="secao__cabecalho">
    <h2 id="titulo-notas">Notas por disciplina</h2>
    <p class="secao__nota">O travessão marca bimestre sem nota lançada</p>
  </div>

  <% if (boletim.linhas.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhuma disciplina alocada nesta turma',
      texto: 'A turma ainda não tem professor alocado em nenhuma disciplina, então não há nota a mostrar. A secretaria da unidade faz essa alocação.',
    }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Notas de <%= boletim.alunoNome %> em <%= boletim.ano %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.rotulos.disciplina %></th>
          <% it.bimestres.forEach((bimestre) => { %>
          <th scope="col" class="celula-centro"><%= it.rotuloDeBimestre(bimestre) %></th>
          <% }) %>
          <th scope="col" class="celula-centro">Média anual</th>
        </tr>
      </thead>
      <tbody>
        <% boletim.linhas.forEach((linha) => { %>
        <tr>
          <th scope="row"><%= linha.disciplinaNome %></th>
          <% linha.notas.forEach((nota) => { %>
          <td class="numero celula-centro"><%= it.formatarNota(nota) %></td>
          <% }) %>
          <td class="numero celula-centro"><%= it.formatarNota(linha.media) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Médias</th>
          <% boletim.mediasPorBimestre.forEach((mediaDoBimestre) => { %>
          <td class="numero celula-centro"><%= it.formatarNota(mediaDoBimestre) %></td>
          <% }) %>
          <td class="numero celula-centro"><%= it.formatarNota(boletim.mediaGeral) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</section>
