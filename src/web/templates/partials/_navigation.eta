<%
const user = it.user;
const roles = new Set(user === null ? [] : user.roles.map((p) => p.role));

const ANY_ROLE = Object.values(it.role);

const groups = [
  { title: it.areas.network, roles: [it.role.networkAdmin], items: [
    { href: it.routes.network.dashboard(), text: it.titles.network.dashboard },
    { href: it.routes.network.schools(), text: it.titles.network.schools },
    { href: it.routes.network.users(), text: it.titles.network.users },
    { href: it.routes.network.academicYears(), text: it.titles.network.years },
  ] },
  { title: it.areas.registrar, roles: [it.role.registrar], items: [
    { href: it.routes.registrar.dashboard(), text: it.titles.registrar.dashboard },
    { href: it.routes.registrar.students(), text: it.titles.registrar.students },
    { href: it.routes.registrar.guardians(), text: it.titles.registrar.guardians },
    { href: it.routes.registrar.classGroups(), text: it.titles.registrar.classGroups },
    { href: it.routes.registrar.subjects(), text: it.titles.registrar.subjects },
  ] },
  { title: it.areas.teaching, roles: [it.role.teacher], items: [
    { href: it.routes.teacher.dashboard(), text: it.titles.teacher.dashboard },
  ] },
  { title: it.areas.monitoring, roles: [it.role.guardian], items: [
    { href: it.routes.guardian.dashboard(), text: it.titles.guardian.dashboard },
    { href: it.routes.guardian.board(), text: 'Mural' },
  ] },
  { title: it.areas.communication, roles: [it.role.networkAdmin, it.role.registrar], items: [
    { href: it.routes.announcements.list(), text: it.titles.announcements.list },
  ] },
  { title: it.areas.account, roles: ANY_ROLE, items: [
    { href: it.routes.account.password(), text: it.titles.changePassword },
  ] },
].filter((group) => group.roles.some((role) => roles.has(role)));

const path = it.currentPath ?? '';
const candidates = groups
  .flatMap((group) => group.items.map((item) => item.href))
  .filter((href) => path === href || path.startsWith(href + '/'));
const current = candidates.sort((a, b) => b.length - a.length)[0] ?? '';
%>
<nav class="navegacao" aria-label="Navegação principal">
  <% groups.forEach((group) => { %>
  <div class="navegacao__grupo">
    <h2 class="navegacao__titulo"><%= group.title %></h2>
    <ul class="navegacao__lista">
      <% group.items.forEach((item) => { %>
      <li>
        <a class="navegacao__link" href="<%= item.href %>"<% if (item.href === current) { %> aria-current="page"<% } %>><%= item.text %></a>
      </li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
</nav>
