<%
const usuario = it.usuario;
const papeis = new Set(usuario === null ? [] : usuario.roles.map((p) => p.role));

const QUALQUER_PAPEL = Object.values(it.papel);

const grupos = [
  { titulo: it.areas.rede, papeis: [it.papel.networkAdmin], itens: [
    { href: it.rotas.rede.painel(), texto: it.titulos.rede.painel },
    { href: it.rotas.rede.unidades(), texto: it.titulos.rede.unidades },
    { href: it.rotas.rede.usuarios(), texto: it.titulos.rede.usuarios },
    { href: it.rotas.rede.anosLetivos(), texto: it.titulos.rede.anos },
  ] },
  { titulo: it.areas.secretaria, papeis: [it.papel.registrar], itens: [
    { href: it.rotas.secretaria.painel(), texto: it.titulos.secretaria.painel },
    { href: it.rotas.secretaria.alunos(), texto: it.titulos.secretaria.alunos },
    { href: it.rotas.secretaria.responsaveis(), texto: it.titulos.secretaria.responsaveis },
    { href: it.rotas.secretaria.turmas(), texto: it.titulos.secretaria.turmas },
    { href: it.rotas.secretaria.disciplinas(), texto: it.titulos.secretaria.disciplinas },
  ] },
  { titulo: it.areas.ensino, papeis: [it.papel.teacher], itens: [
    { href: it.rotas.professor.painel(), texto: it.titulos.professor.painel },
  ] },
  { titulo: it.areas.acompanhamento, papeis: [it.papel.guardian], itens: [
    { href: it.rotas.responsavel.painel(), texto: it.titulos.responsavel.painel },
    { href: it.rotas.responsavel.mural(), texto: 'Mural' },
  ] },
  { titulo: it.areas.comunicacao, papeis: [it.papel.networkAdmin, it.papel.registrar], itens: [
    { href: it.rotas.comunicados.lista(), texto: it.titulos.comunicados.lista },
  ] },
  { titulo: it.areas.conta, papeis: QUALQUER_PAPEL, itens: [
    { href: it.rotas.conta.senha(), texto: it.titulos.trocarSenha },
  ] },
].filter((grupo) => grupo.papeis.some((papel) => papeis.has(papel)));

const caminho = it.caminhoAtual ?? '';
const candidatos = grupos
  .flatMap((grupo) => grupo.itens.map((item) => item.href))
  .filter((href) => caminho === href || caminho.startsWith(href + '/'));
const atual = candidatos.sort((a, b) => b.length - a.length)[0] ?? '';
%>
<nav class="navegacao" aria-label="Navegação principal">
  <% grupos.forEach((grupo) => { %>
  <div class="navegacao__grupo">
    <h2 class="navegacao__titulo"><%= grupo.titulo %></h2>
    <ul class="navegacao__lista">
      <% grupo.itens.forEach((item) => { %>
      <li>
        <a class="navegacao__link" href="<%= item.href %>"<% if (item.href === atual) { %> aria-current="page"<% } %>><%= item.texto %></a>
      </li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
</nav>
