<%
const user = it.user;
const schools = user === null ? [] : [...new Set(user.roles.map((p) => p.schoolName))];
%>
<header class="header">
  <a class="brand header__brand" href="<%= it.routes.public.dashboard() %>"><%~ it.presentation.brand %></a>

  <% if (user !== null) { %>
  <div class="header__context">
    <span class="header__network"><%= user.networkName %></span>
    <span class="header__school">
      <% if (schools.length === 0) { %>
        sem unidade atribuída
      <% } else if (schools.length === 1) { %>
        <%= schools[0] %>
      <% } else { %>
        <%= schools.length %> <%= it.nouns.school.plural %>

      <% } %>
    </span>
  </div>

  <div class="header__user">
    <span class="header__name" title="<%= user.email %>"><%= user.name %></span>
    <form class="header__signout" method="post" action="<%= it.routes.public.logout() %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <button class="button button--quiet button--small" type="submit">Sair</button>
    </form>
  </div>
  <% } %>
</header>
