<%
const user = it.user;
const schools = user === null ? [] : [...new Set(user.roles.map((p) => p.schoolName))];
%>
<header class="cabecalho">
  <a class="marca cabecalho__marca" href="<%= it.routes.public.dashboard() %>"><%~ it.presentation.brand %></a>

  <% if (user !== null) { %>
  <div class="cabecalho__contexto">
    <span class="cabecalho__rede"><%= user.networkName %></span>
    <span class="cabecalho__unidade">
      <% if (schools.length === 0) { %>
        sem unidade atribuída
      <% } else if (schools.length === 1) { %>
        <%= schools[0] %>
      <% } else { %>
        <%= schools.length %> <%= it.nouns.school.plural %>

      <% } %>
    </span>
  </div>

  <div class="cabecalho__usuario">
    <span class="cabecalho__nome" title="<%= user.email %>"><%= user.name %></span>
    <form class="cabecalho__sair" method="post" action="<%= it.routes.public.logout() %>">
      <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
      <button class="botao botao--discreto botao--miudo" type="submit">Sair</button>
    </form>
  </div>
  <% } %>
</header>
