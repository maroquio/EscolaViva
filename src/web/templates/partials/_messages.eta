<% if (it.mensagem) { %>
<p class="aviso aviso--sucesso" role="status"><%= it.mensagem %></p>
<% } %>

<% if (it.erro) { %>
<p class="aviso aviso--erro" role="alert"><%= it.erro %></p>
<% } %>

<% if (Array.isArray(it.erros) && it.erros.length > 0) { %>
<div class="aviso aviso--erro" role="alert">
  <p class="aviso__titulo">Não foi possível concluir</p>
  <ul>
    <% it.erros.forEach((problema) => { %>
    <li><%= problema.mensagem %></li>
    <% }) %>
  </ul>
</div>
<% } %>
