<% if (it.message) { %>
<p class="notice notice--success" role="status"><%= it.message %></p>
<% } %>

<% if (it.error) { %>
<p class="notice notice--error" role="alert"><%= it.error %></p>
<% } %>

<% if (Array.isArray(it.errors) && it.errors.length > 0) { %>
<div class="notice notice--error" role="alert">
  <p class="notice__title">Não foi possível concluir</p>
  <ul>
    <% it.errors.forEach((problem) => { %>
    <li><%= problem.mensagem %></li>
    <% }) %>
  </ul>
</div>
<% } %>
