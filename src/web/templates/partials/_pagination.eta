<%
const DEFAULT_LABEL = 'itens';

const nav = it.pagination ?? null;
const label = it.label ?? DEFAULT_LABEL;
%>
<% if (nav !== null && nav.total > 0) { %>
<nav class="pagination" aria-label="Paginação de <%= label %>">
  <p class="pagination__count">
    <span class="number"><%= nav.first %>–<%= nav.last %></span>
    de <span class="number"><%= nav.total %></span> <%= label %>
  </p>

  <% if (nav.many) { %>
  <ul class="pagination__list">
    <li>
      <% if (nav.previous !== null) { %>
      <a class="pagination__step" href="<%= nav.previous %>" rel="prev">
        <span aria-hidden="true">&lsaquo;</span> Anterior
      </a>
      <% } else { %>
      <span class="pagination__step pagination__step--inert" aria-hidden="true">
        &lsaquo; Anterior
      </span>
      <% } %>
    </li>

    <% nav.links.forEach((link) => { %>
    <li>
      <% if (link.current) { %>
      <span class="pagination__number pagination__number--current" aria-current="page">
        <%= link.number %>
      </span>
      <% } else { %>
      <a class="pagination__number" href="<%= link.href %>" aria-label="Página <%= link.number %>">
        <%= link.number %>
      </a>
      <% } %>
    </li>
    <% }) %>

    <li>
      <% if (nav.next !== null) { %>
      <a class="pagination__step" href="<%= nav.next %>" rel="next">
        Próxima <span aria-hidden="true">&rsaquo;</span>
      </a>
      <% } else { %>
      <span class="pagination__step pagination__step--inert" aria-hidden="true">
        Próxima &rsaquo;
      </span>
      <% } %>
    </li>
  </ul>
  <% } %>
</nav>
<% } %>
