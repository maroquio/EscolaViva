<%
const DEFAULT_LABEL = 'itens';

const nav = it.pagination ?? null;
const label = it.label ?? DEFAULT_LABEL;
%>
<% if (nav !== null && nav.total > 0) { %>
<nav class="paginacao" aria-label="Paginação de <%= label %>">
  <p class="paginacao__contagem">
    <span class="numero"><%= nav.first %>–<%= nav.last %></span>
    de <span class="numero"><%= nav.total %></span> <%= label %>
  </p>

  <% if (nav.many) { %>
  <ul class="paginacao__lista">
    <li>
      <% if (nav.previous !== null) { %>
      <a class="paginacao__passo" href="<%= nav.previous %>" rel="prev">
        <span aria-hidden="true">&lsaquo;</span> Anterior
      </a>
      <% } else { %>
      <span class="paginacao__passo paginacao__passo--inerte" aria-hidden="true">
        &lsaquo; Anterior
      </span>
      <% } %>
    </li>

    <% nav.links.forEach((link) => { %>
    <li>
      <% if (link.current) { %>
      <span class="paginacao__numero paginacao__numero--atual" aria-current="page">
        <%= link.number %>
      </span>
      <% } else { %>
      <a class="paginacao__numero" href="<%= link.href %>" aria-label="Página <%= link.number %>">
        <%= link.number %>
      </a>
      <% } %>
    </li>
    <% }) %>

    <li>
      <% if (nav.next !== null) { %>
      <a class="paginacao__passo" href="<%= nav.next %>" rel="next">
        Próxima <span aria-hidden="true">&rsaquo;</span>
      </a>
      <% } else { %>
      <span class="paginacao__passo paginacao__passo--inerte" aria-hidden="true">
        Próxima &rsaquo;
      </span>
      <% } %>
    </li>
  </ul>
  <% } %>
</nav>
<% } %>
