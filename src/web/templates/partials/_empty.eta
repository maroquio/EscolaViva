<%
const action = it.action ?? null;
%>
<div class="vazio">
  <p class="vazio__titulo"><%= it.title %></p>
  <% if (it.text) { %>
  <p class="vazio__texto"><%= it.text %></p>
  <% } %>
  <% if (action !== null) { %>
  <a class="botao botao--secundario" href="<%= action.href %>"><%= action.text %></a>
  <% } %>
</div>
