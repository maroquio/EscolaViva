<%
const action = it.action ?? null;
%>
<div class="empty">
  <p class="empty__title"><%= it.title %></p>
  <% if (it.text) { %>
  <p class="empty__text"><%= it.text %></p>
  <% } %>
  <% if (action !== null) { %>
  <a class="button button--secondary" href="<%= action.href %>"><%= action.text %></a>
  <% } %>
</div>
