<%
/*
  Trocar a própria senha.

  Nenhum dos três campos volta preenchido depois de um erro: senha digitada não é valor a
  preservar. O que volta é a mensagem, ligada ao campo por `aria-describedby`.

  O rótulo do botão que envia é o título DESTA tela, e por isso lê `it.titulos.trocarSenha` — a
  mesma chave que a rota passa como `it.titulo` no `<h1>` acima e que o menu já usa para nomear o
  link do grupo "Conta". São a mesma decisão dita uma vez: renomear a tela renomeia junto o botão
  que a cumpre e o caminho do menu que traz até aqui, em vez de exigir uma varredura pelos `.eta`.

  `campos` é o apelido de `CAMPOS.senha` do módulo de identidade, o dono dos três nomes. Ele cobre
  tudo que ATRAVESSA este arquivo: o `name=` que a rota lê do corpo, o `campo` que `falhaDeCampo()`
  carrega até `erroDe()`/`descricao()`, e o `id` do parágrafo que o `aria-describedby` promete —
  este último pelos auxiliares `it.idDoErro`/`it.idDaAjuda`, que são o outro lado de `descricao()`.
  Divergindo qualquer um deles, nada quebra à vista: o campo chega vazio ao servidor, ou o leitor
  de tela aponta para um id inexistente e não lê nem o erro nem a ajuda.
*/
// magic-values: permitido — o `id` do <input> e o `for=` do <label> ficam literais de propósito.
// Não são cópia de CAMPOS.senha: o valor coincide, mas o contrato é outro. Eles casam um com o
// outro dentro destas seis linhas e ninguém fora do arquivo os lê; o nome que atravessa é o
// `name=`. `for="senhaAtual"` ao lado de `id="senhaAtual"` é o HTML que um aluno lê de uma vez.
const { erroDe, descricao } = it;
const campos = it.campos.senha;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Conta</p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Vale para qualquer papel. Depois de trocar, a senha antiga deixa de funcionar imediatamente;
      as sessões já abertas continuam válidas até expirarem.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.conta.senha() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="senhaAtual">
        Senha atual <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaAtual"
        name="<%= campos.atual %>"
        type="password"
        required
        autocomplete="current-password"
        <% if (erroDe(campos.atual) !== '') { %>aria-invalid="true"<% } %>
        <% if (descricao(campos.atual, false) !== '') { %>aria-describedby="<%= descricao(campos.atual, false) %>"<% } %>>
      <% if (erroDe(campos.atual) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.atual) %>"><%= erroDe(campos.atual) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaNova">
        Senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaNova"
        name="<%= campos.nova %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (erroDe(campos.nova) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao(campos.nova, true) %>">
      <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.nova) %>">
        Escolha uma senha longa e que você não use em outro sistema. Se ela for curta demais, o
        servidor recusa e diz o mínimo exigido.
      </p>
      <% if (erroDe(campos.nova) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.nova) %>"><%= erroDe(campos.nova) %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="senhaConfirmacao">
        Repita a senha nova <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="senhaConfirmacao"
        name="<%= campos.confirmacao %>"
        type="password"
        required
        autocomplete="new-password"
        <% if (erroDe(campos.confirmacao) !== '') { %>aria-invalid="true"<% } %>
        <% if (descricao(campos.confirmacao, false) !== '') { %>aria-describedby="<%= descricao(campos.confirmacao, false) %>"<% } %>>
      <% if (erroDe(campos.confirmacao) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.confirmacao) %>"><%= erroDe(campos.confirmacao) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.trocarSenha %></button>
    </div>
  </form>
</div>
