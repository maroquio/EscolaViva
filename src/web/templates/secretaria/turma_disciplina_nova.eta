<%
/*
  Alocação de disciplina e professor numa turma.

  A lista de professores vem da unidade desta turma — quem não tem o papel ali não aparece, e o
  servidor recusa se a lista for burlada. Faltando disciplina ou professor, a página diz o que
  falta em vez de oferecer um seletor vazio.

  Os cinco endereços da tela — o destino do formulário, o atalho para cadastrar disciplina e os três
  caminhos de volta à turma — vêm de `it.rotas`, o mesmo mapa que o router registra. A página da
  turma aparece três vezes (cabeçalho, estado vazio e "Cancelar"): escritas à mão seriam três cópias
  do mesmo endereço, que podem divergir de uma só, e URL literal em `.eta` não quebra compilação —
  quebra a tela de quem clica.
*/

/*
  O travessão da célula sem valor e o rótulo da opção em branco chegam prontos pelo `it`: são de
  `AUSENTE` (`src/shared/constantes.ts`) e de `APRESENTACAO.opcaoVazia` (`src/web/constantes.ts`).
  O Eta não importa TypeScript, e reescrevê-los aqui criaria uma segunda decisão ao lado da do dono.

  Os dois nomes de campo — `disciplinaId` e `professorUsuarioId` — vêm de `it.campos.alocacao`,
  apelidado abaixo de `campos`: é `CAMPOS.alocacao` (`src/academico/constantes.ts`), o mesmo mapa
  pelo qual a rota lê o corpo do POST e pelo qual o caso de uso devolve a falha de campo. Escritos à
  mão, um `name` divergente faria o servidor recusar por obrigatório o que a pessoa acabou de
  escolher, e um `erroDe('...')` divergente esconderia a mensagem que o caso de uso mandou.
  O `id` do `<select>` e o `for` do `<label>` continuam literais de propósito: casam um com o outro
  dentro das mesmas seis linhas, ninguém fora deste arquivo os lê, e `for="disciplinaId"` ao lado de
  `id="disciplinaId"` é o HTML mais legível que se pode escrever.

  Já os ids do erro e da ajuda ATRAVESSAM o arquivo, e por isso vêm de `it.idDoErro` e
  `it.idDaAjuda` (`src/web/render.ts`): são exatamente os ids que `descricao()` promete no
  `aria-describedby`. Divergindo, a lista aponta para um id inexistente — o texto aparece na tela e
  o leitor de tela não lê nenhum dos dois, sem que nada falhe.

  O atalho do estado vazio se rotula com o título da tela para onde leva: `it.titulos` — `TITULOS`
  (`src/web/constantes.ts`), o mesmo mapa de onde a rota tira o `it.titulo` da tela de cadastro de
  disciplina. Escrito à mão, renomear aquela tela deixaria este botão chamando-a pelo nome antigo, e
  nada acusa: ele continua levando ao lugar certo com a legenda errada.

  O rótulo do dado ("Disciplina"), os dois caminhos de volta à turma e o "Cancelar" do pé do
  formulário também têm dono: `it.rotulos`, `it.acoes.voltarPara` e `it.acoes.cancelar`. "Voltar à
  turma" nomeia o destino; "Cancelar" nomeia o que se abandona, e é a mesma palavra nos doze
  formulários do sistema — por isso são duas chaves da mesma família, e não uma.

  O botão que envia fica de fora: "Alocar" é curto porque o cabeçalho da página já disse o resto, e
  não é o título "Alocar disciplina e professor". São duas frases, e não a mesma dita duas vezes.
  "Professor" também fica: o menu chama esse grupo de "Ensino", e `ROTULOS` não nomeia o papel.
*/
const turma = it.turma;
const disciplinas = it.disciplinas ?? [];
const professores = it.professores ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao } = it;
const campos = it.campos.alocacao;
const podeAlocar = disciplinas.length > 0 && professores.length > 0;
const paginaDaTurma = it.rotas.secretaria.turma({ id: turma.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Turma <%= turma.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
<%
  // "· ano letivo", logo abaixo, NÃO é ROTULOS.anoLetivo. Aquele rótulo nomeia a ENTIDADE que um
  // filtro ou um <select> escolhe; aqui o substantivo é prosa, apresentando o número no meio de uma
  // frase que identifica a turma — e o número sai dentro de um <span class="numero">. Trocar a
  // frase por constantes coladas a deixaria ilegível sem fechar contrato nenhum.
  // magic-values: permitido — prosa da frase que identifica a turma, e não o rótulo ROTULOS.anoLetivo %>
      <%= turma.serie %> · <%= turma.turno %> · <%= turma.unidadeNome %> · ano letivo
      <span class="numero"><%= turma.ano === null ? it.semValor : turma.ano %></span>
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= paginaDaTurma %>"><%= it.acoes.voltarPara.turma %></a>
  </div>
</div>

<div class="quadro">
  <% if (!podeAlocar) { %>
  <p class="suave leitura">
    <% if (disciplinas.length === 0) { %>
    Esta rede ainda não tem disciplina cadastrada.
    <% } else { %>
    Nenhum usuário tem papel de professor em <%= turma.unidadeNome %>. Peça ao administrador da
    rede para atribuir o papel antes de alocar.
    <% } %>
  </p>
  <div class="acoes">
    <% if (disciplinas.length === 0) { %>
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.disciplinaNova() %>"><%= it.titulos.secretaria.disciplinaNova %></a>
    <% } %>
    <a class="botao botao--discreto" href="<%= paginaDaTurma %>"><%= it.acoes.voltarPara.turma %></a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.turmaDisciplinas({ id: turma.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="disciplinaId">
          <%= it.rotulos.disciplina %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="disciplinaId"
          name="<%= campos.disciplinaId %>"
          required
          <% if (erroDe(campos.disciplinaId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.disciplinaId, true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% disciplinas.forEach((disciplina) => { %>
          <option value="<%= disciplina.id %>" <%= (valores.disciplinaId ?? '') === disciplina.id ? 'selected' : '' %>>
            <%= disciplina.nome %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.disciplinaId) %>">
          Cada disciplina entra uma única vez por turma.
        </p>
        <% if (erroDe(campos.disciplinaId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.disciplinaId) %>"><%= erroDe(campos.disciplinaId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="professorUsuarioId">
          Professor <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="professorUsuarioId"
          name="<%= campos.professorUsuarioId %>"
          required
          <% if (erroDe(campos.professorUsuarioId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.professorUsuarioId, true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% professores.forEach((professor) => { %>
          <option value="<%= professor.id %>" <%= (valores.professorUsuarioId ?? '') === professor.id ? 'selected' : '' %>>
            <%= professor.nome %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.professorUsuarioId) %>">
          Somente quem tem papel de professor em <%= turma.unidadeNome %>.
        </p>
        <% if (erroDe(campos.professorUsuarioId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.professorUsuarioId) %>"><%= erroDe(campos.professorUsuarioId) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Alocar</button>
      <a class="botao botao--discreto" href="<%= paginaDaTurma %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
  <% } %>
</div>
