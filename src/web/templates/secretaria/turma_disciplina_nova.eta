<%
const turma = it.turma;
const disciplinas = it.disciplinas ?? [];
const professores = it.professores ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao } = it;
const campos = it.campos.alocacao;
const podeAlocar = disciplinas.length > 0 && professores.length > 0;
const paginaDaTurma = it.rotas.secretaria.turma({ id: turma.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %><%= it.apresentacao.separador %><%= it.titulos.secretaria.turma(turma.nome) %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      <%= turma.serie %><%= it.apresentacao.separador %><%= turma.turno %><%= it.apresentacao.separador %><%= turma.unidadeNome %><%= it.apresentacao.separador %>ano letivo
      <span class="numero"><%= turma.ano === null ? it.semValor : turma.ano %></span>
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= paginaDaTurma %>"><%= it.acoes.voltarPara.turma %></a>
  </div>
</div>

<div class="quadro">
  <% if (!podeAlocar) { %>
  <p class="suave leitura">
    <% if (disciplinas.length === 0) { %>
    Esta rede ainda não tem disciplina cadastrada.
    <% } else { %>
    Nenhum usuário tem papel de professor em <%= turma.unidadeNome %>. Peça ao administrador da
    rede para atribuir o papel antes de alocar.
    <% } %>
  </p>
  <div class="acoes">
    <% if (disciplinas.length === 0) { %>
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.disciplinaNova() %>"><%= it.titulos.secretaria.disciplinaNova %></a>
    <% } %>
    <a class="botao botao--discreto" href="<%= paginaDaTurma %>"><%= it.acoes.voltarPara.turma %></a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.turmaDisciplinas({ id: turma.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="disciplinaId">
          <%= it.rotulos.disciplina %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="disciplinaId"
          name="<%= campos.disciplinaId %>"
          required
          <% if (erroDe(campos.disciplinaId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.disciplinaId, true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% disciplinas.forEach((disciplina) => { %>
          <option value="<%= disciplina.id %>" <%= (valores.disciplinaId ?? '') === disciplina.id ? 'selected' : '' %>>
            <%= disciplina.nome %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.disciplinaId) %>">
          Cada disciplina entra uma única vez por turma.
        </p>
        <% if (erroDe(campos.disciplinaId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.disciplinaId) %>"><%= erroDe(campos.disciplinaId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="professorUsuarioId">
          Professor <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="professorUsuarioId"
          name="<%= campos.professorUsuarioId %>"
          required
          <% if (erroDe(campos.professorUsuarioId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.professorUsuarioId, true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% professores.forEach((professor) => { %>
          <option value="<%= professor.id %>" <%= (valores.professorUsuarioId ?? '') === professor.id ? 'selected' : '' %>>
            <%= professor.name %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.professorUsuarioId) %>">
          Somente quem tem papel de professor em <%= turma.unidadeNome %>.
        </p>
        <% if (erroDe(campos.professorUsuarioId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.professorUsuarioId) %>"><%= erroDe(campos.professorUsuarioId) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Alocar</button>
      <a class="botao botao--discreto" href="<%= paginaDaTurma %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
  <% } %>
</div>
