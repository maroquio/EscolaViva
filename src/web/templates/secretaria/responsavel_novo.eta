<%
/*
  Cadastro de responsável.

  O responsável nasce solto: é o vínculo, feito depois na ficha do aluno, que o liga a uma criança
  e, por ela, a uma unidade. Cadastrar aqui não dá acesso ao sistema — o acesso é um convite de
  usuário, criado pelo administrador da rede a partir deste cadastro.

  Os dois endereços da tela — o destino do formulário e o "Cancelar" — vêm de `it.rotas`, o mesmo
  mapa que o router registra. São o mesmo endereço escrito duas vezes, e escrevê-lo à mão aqui não
  quebraria compilação: quebraria a tela de quem clica, porque `.eta` não passa pelo compilador.
*/

/*
  Os quatro limites chegam prontos pelo `it`, e por isso não há número nenhum escrito nesta página.
  Os donos de três deles são `LIMITES.responsavel.nome`, `.email` e `.telefone`
  (`src/academico/constantes.ts`), que `cadastrarResponsavel` faz valer com
  `MENSAGENS.responsavel.nomeLongo`, `.emailLongo` e `.telefoneLongo`; o `maxlength` só adianta a
  recusa no navegador. O quarto é `TAMANHO_DO_CPF_COM_MASCARA` (`src/shared/constantes.ts`) — onze
  dígitos, dois pontos e um traço —, que limita o que cabe na caixa: quem decide se o CPF vale é
  `shared/documento`, que aceita com ou sem pontuação.

  `campos` é o apelido curto de `CAMPOS.responsavel` (`src/academico/constantes.ts`, que a camada web
  reexporta em `it.campos`). É o nome que ATRAVESSA arquivos: o `name=` que o navegador envia, a
  leitura do corpo em `web/rotas/secretaria.ts` e o `falhaDeCampo` que `cadastrarResponsavel` devolve
  são a mesma palavra escrita em três lugares que nenhum compilador liga. Divergindo, o campo chega
  vazio e o servidor recusa por obrigatório o que a pessoa acabou de preencher.

  O `id` do `<input>` e o `for` do `<label>` continuam literais de propósito: casam um com o outro
  dentro das mesmas seis linhas, nada fora deste arquivo os lê, e `for="cpf"` ao lado de `id="cpf"` é
  o HTML mais legível que existe. Já o `id` do parágrafo de erro e o da ajuda saem de `it.idDoErro` e
  `it.idDaAjuda` (`src/web/render.ts`), que são o OUTRO lado de `descricao()`: é para eles que o
  `aria-describedby` aponta, e essa promessa atravessa daqui até o render. Escritos à mão, um id
  divergente não falha em lugar nenhum — o leitor de tela apenas para de anunciar o erro.

  O rótulo do botão que envia é o título desta tela: `it.titulos` — `TITULOS`
  (`src/web/constantes.ts`), o mesmo mapa de onde a rota tira o `it.titulo` do `<h1>` logo acima e de
  onde saem os rótulos dos botões que trazem alguém até aqui — a lista de responsáveis e o vínculo
  feito pela ficha do aluno. "Cadastrar responsável" é uma decisão só, escrita em quatro lugares;
  renomeá-la em um e esquecer os outros deixa a tela se chamando de dois jeitos, e nada acusa.

  O sobretítulo acima do `<h1>` não é um texto: é uma COMPOSIÇÃO de três decisões que já têm dono —
  a ÁREA do menu (`AREAS.secretaria`), a marca tipográfica que separa os dois (`APRESENTACAO.separador`,
  com os espaços em volta dentro dela) e o título da lista onde esta tela vive
  (`TITULOS.secretaria.responsaveis`), todos de `src/web/constantes.ts`. Escrito à mão,
  "Secretaria · Responsáveis" seria uma quarta cópia muda: renomear a área no menu ou a lista nos
  títulos deixaria esta linha dizendo o nome antigo, e nada acusaria.
*/
const valores = it.valores ?? {};
const { erroDe, descricao } = it;
const campos = it.campos.responsavel;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %><%= it.apresentacao.separador %><%= it.titulos.secretaria.responsaveis %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Quem recebe comunicado e acompanha boletim e frequência. Depois de cadastrar, vincule-o ao
      aluno pela ficha dele.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.responsaveis() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome completo <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="<%= campos.nome %>"
        type="text"
        required
        maxlength="<%= it.limiteDoNome %>"
        autocomplete="off"
        value="<%= valores.nome ?? '' %>"
        <% if (erroDe(campos.nome) !== '') { %>aria-invalid="true"<% } %>
        <% if (descricao(campos.nome) !== '') { %>aria-describedby="<%= descricao(campos.nome) %>"<% } %>>
      <% if (erroDe(campos.nome) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.nome) %>"><%= erroDe(campos.nome) %></p>
      <% } %>
    </div>

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="email">
          <%= it.rotulos.email %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= campos.email %>"
          type="email"
          required
          maxlength="<%= it.limiteDoEmail %>"
          autocomplete="off"
          value="<%= valores.email ?? '' %>"
          <% if (erroDe(campos.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.email, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.email) %>">
          Único na rede. É por ele que o responsável recebe comunicado — não é usado para entrar.
        </p>
        <% if (erroDe(campos.email) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.email) %>"><%= erroDe(campos.email) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="cpf"><%= it.rotulos.cpf %></label>
        <input
          id="cpf"
          name="<%= campos.cpf %>"
          type="text"
          maxlength="<%= it.limiteDoCpfComMascara %>"
          autocomplete="off"
          value="<%= valores.cpf ?? '' %>"
          <% if (erroDe(campos.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.cpf, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.cpf) %>">
          Opcional. Sem CPF a pessoa fica como contato e não recebe acesso ao portal.
        </p>
        <% if (erroDe(campos.cpf) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.cpf) %>"><%= erroDe(campos.cpf) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="telefone">Telefone</label>
        <input
          id="telefone"
          name="<%= campos.telefone %>"
          type="tel"
          maxlength="<%= it.limiteDoTelefone %>"
          autocomplete="off"
          value="<%= valores.telefone ?? '' %>"
          <% if (erroDe(campos.telefone) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.telefone, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.telefone) %>">Opcional. Em branco significa sem telefone.</p>
        <% if (erroDe(campos.telefone) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.telefone) %>"><%= erroDe(campos.telefone) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.secretaria.responsavelNovo %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.responsaveis() %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
</div>
