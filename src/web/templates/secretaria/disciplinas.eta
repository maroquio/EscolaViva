<%
/*
  Disciplinas da rede.

  A disciplina é da rede inteira: "Matemática" é a mesma em todas as unidades. O que varia por
  turma é quem a leciona, e essa alocação se faz na tela da turma.
*/
const disciplinas = it.disciplinas ?? [];
const valores = it.valores ?? {};
const erros = Array.isArray(it.erros) ? it.erros : [];

const erroDe = (campo) => {
  const achado = erros.find((problema) => problema.campo === campo);
  return achado === undefined ? '' : achado.mensagem;
};

const descricao = (campo, temAjuda) => {
  const ids = [];
  if (temAjuda) ids.push(campo + '-ajuda');
  if (erroDe(campo) !== '') ids.push(campo + '-erro');
  return ids.join(' ');
};
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria</p>
    <h1 class="pagina__titulo">Disciplinas</h1>
    <p class="pagina__resumo">
      Cadastradas uma vez para toda a rede. Cada turma recebe as suas na tela da turma, sempre com
      o professor responsável.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="/secretaria/turmas">Turmas</a>
  </div>
</div>

<section class="secao" aria-labelledby="cadastradas">
  <div class="secao__cabecalho">
    <h2 id="cadastradas">Cadastradas na rede</h2>
    <p class="secao__nota">
      <% const quantas = it.navegacao === undefined ? disciplinas.length : it.navegacao.total; %>
      <span class="numero"><%= quantas %></span>
      <%= quantas === 1 ? 'disciplina' : 'disciplinas' %>
    </p>
  </div>

  <% if (disciplinas.length === 0) { %>
  <%~ include("/parciais/_vazio", {
    titulo: 'Nenhuma disciplina cadastrada',
    texto: 'Sem disciplina não há alocação de professor, e sem alocação não há lançamento de nota. Comece pelo formulário abaixo.'
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Disciplinas disponíveis para alocar nas turmas</caption>
      <thead>
        <tr>
          <th scope="col">Disciplina</th>
        </tr>
      </thead>
      <tbody>
        <% disciplinas.forEach((disciplina) => { %>
        <tr>
          <th scope="row"><%= disciplina.nome %></th>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include("/parciais/_paginacao", { navegacao: it.navegacao, rotulo: 'disciplinas' }) %>
  <% } %>
</section>

<section class="secao" aria-labelledby="nova-disciplina">
  <div class="secao__cabecalho">
    <h2 id="nova-disciplina">Cadastrar disciplina</h2>
  </div>

  <div class="quadro">
    <form class="formulario" method="post" action="/secretaria/disciplinas">
      <input type="hidden" name="_chave" value="<%= it.chave %>">

      <div class="campo">
        <label class="campo__rotulo" for="nome">
          Nome da disciplina <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="nome"
          name="nome"
          type="text"
          required
          maxlength="120"
          autocomplete="off"
          value="<%= valores.nome ?? '' %>"
          <% if (erroDe('nome') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('nome', true) %>">
        <p class="campo__ajuda" id="nome-ajuda">Único na rede: não há duas “Matemática”.</p>
        <% if (erroDe('nome') !== '') { %>
        <p class="campo__erro" id="nome-erro"><%= erroDe('nome') %></p>
        <% } %>
      </div>

      <div class="acoes">
        <button class="botao botao--primario" type="submit">Cadastrar disciplina</button>
      </div>
    </form>
  </div>
</section>
