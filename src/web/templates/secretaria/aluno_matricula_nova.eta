<%
/*
  Matrícula de um aluno em uma turma.

  As turmas entram agrupadas por ano letivo: é assim que a secretaria escolhe o par sem errar. O
  ano continua sendo um campo à parte porque é ele que o domínio confere contra a turma — a tela
  não decide o par sozinha.

  Os cinco endereços da tela — o destino do formulário, o atalho para cadastrar turma e os três
  caminhos de volta à ficha — vêm de `it.rotas`, o mesmo mapa que o router registra. A ficha aparece
  três vezes (cabeçalho, estado vazio e "Cancelar"): escritas à mão seriam três cópias do mesmo
  endereço, que podem divergir de uma só, e URL literal em `.eta` não quebra compilação — quebra a
  tela de quem clica.
*/

/*
  O travessão da célula sem valor, o rótulo da opção em branco e os sufixos de id chegam prontos
  pelo `it`: são de `AUSENTE` (`src/shared/constantes.ts`), de `APRESENTACAO.opcaoVazia` e de
  `SUFIXOS_DE_ID` (`src/web/constantes.ts`). O Eta não importa TypeScript, e reescrevê-los aqui
  criaria uma segunda decisão ao lado da do dono — no caso dos sufixos, um id apontado pelo
  `aria-describedby` que `descricao()` monta e que esta página não escreveria igual.
*/
const aluno = it.aluno;
const turmas = it.turmas ?? [];
const anosLetivos = it.anosLetivos ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;

const valor = (campo, padrao) => (valores[campo] === undefined ? padrao : valores[campo]);

const agrupar = (lista) => {
  const grupos = [];
  lista.forEach((turma) => {
    let grupo = grupos.find((candidato) => candidato.anoLetivoId === turma.anoLetivoId);
    if (grupo === undefined) {
      grupo = { anoLetivoId: turma.anoLetivoId, ano: turma.ano, turmas: [] };
      grupos.push(grupo);
    }
    grupo.turmas.push(turma);
  });
  return grupos.sort((a, b) => (b.ano ?? 0) - (a.ano ?? 0));
};

const grupos = agrupar(turmas);
const fichaDoAluno = it.rotas.secretaria.aluno({ id: aluno.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · <%= aluno.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Um aluno tem, no máximo, uma matrícula ativa por ano letivo.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= fichaDoAluno %>">Voltar à ficha</a>
  </div>
</div>

<div class="quadro">
  <% if (turmas.length === 0 || anosLetivos.length === 0) { %>
  <p class="suave leitura">Não há turma disponível nas suas unidades.</p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.turmaNova() %>">Cadastrar turma</a>
    <a class="botao botao--discreto" href="<%= fichaDoAluno %>">Voltar à ficha</a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.matriculas() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">
    <input type="hidden" name="alunoId" value="<%= aluno.id %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="turmaId">
          Turma <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turmaId"
          name="turmaId"
          required
          <% if (erroDe('turmaId') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('turmaId') !== '') { %>aria-describedby="<%= descricao('turmaId') %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% grupos.forEach((grupo) => { %>
          <optgroup label="Ano letivo <%= grupo.ano === null ? it.semValor : grupo.ano %>">
            <% grupo.turmas.forEach((turma) => { %>
            <option value="<%= turma.id %>" <%= valor('turmaId', '') === turma.id ? 'selected' : '' %>>
              <%= turma.nome %> · <%= turma.serie %> · <%= turma.turno %> · <%= turma.unidadeNome %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
        <% if (erroDe('turmaId') !== '') { %>
        <p class="campo__erro" id="turmaId<%= sufixos.erro %>"><%= erroDe('turmaId') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="anoLetivoId">
          Ano letivo <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="anoLetivoId"
          name="anoLetivoId"
          required
          <% if (erroDe('anoLetivoId') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('anoLetivoId', true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% anosLetivos.forEach((anoLetivo) => { %>
          <option value="<%= anoLetivo.id %>" <%= valor('anoLetivoId', '') === anoLetivo.id ? 'selected' : '' %>>
            <%= anoLetivo.ano %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="anoLetivoId<%= sufixos.ajuda %>">
          Precisa ser o mesmo ano da turma escolhida — o servidor recusa o par que não fecha.
        </p>
        <% if (erroDe('anoLetivoId') !== '') { %>
        <p class="campo__erro" id="anoLetivoId<%= sufixos.erro %>"><%= erroDe('anoLetivoId') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="dataMatricula">
          Data da matrícula <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="dataMatricula"
          name="dataMatricula"
          type="date"
          required
          value="<%= valor('dataMatricula', it.hoje) %>"
          <% if (erroDe('dataMatricula') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('dataMatricula') !== '') { %>aria-describedby="<%= descricao('dataMatricula') %>"<% } %>>
        <% if (erroDe('dataMatricula') !== '') { %>
        <p class="campo__erro" id="dataMatricula<%= sufixos.erro %>"><%= erroDe('dataMatricula') %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Matricular</button>
      <a class="botao botao--discreto" href="<%= fichaDoAluno %>">Cancelar</a>
    </div>
  </form>
  <% } %>
</div>
