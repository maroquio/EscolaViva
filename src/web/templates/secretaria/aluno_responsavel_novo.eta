<%
/*
  Vínculo de responsável a um aluno.

  Quem já responde pelo aluno sai da lista: vincular duas vezes é o mesmo vínculo. Se não sobrar
  ninguém, a página diz por quê e aponta o caminho — cadastrar um responsável novo — em vez de
  mostrar um seletor vazio.

  Os cinco endereços da tela saem de `it.rotas`, o mesmo mapa que o router registra: são três
  destinos, e a volta à ficha sozinha aparece três vezes — no cabeçalho, no estado vazio e no
  "Cancelar". Quatro dos cinco carregam o `:id` do aluno. Escrito à mão, cada um seria uma cópia que
  pode divergir sozinha, com o id concatenado por conta própria — e URL literal em `.eta` não quebra
  compilação: quebra a tela de quem clica.
*/

/*
  O limite do parentesco, o rótulo da opção em branco, o valor que a caixa envia quando marcada e os
  sufixos de id chegam prontos pelo `it`. O dono do tamanho é `LIMITES.parentesco.descricao`
  (`src/academico/constantes.ts`), que `vincularResponsavel` faz valer com
  `MENSAGENS.vinculo.parentescoLongo`; o `maxlength` só adianta a recusa no navegador. `it.marcado` é
  `MARCADO` (`src/web/constantes.ts`) — caixa desmarcada não é enviada pelo navegador, e é a ausência
  do nome, não o valor, que o servidor lê como "não". `it.opcaoVazia` é `APRESENTACAO.opcaoVazia`, e
  os sufixos são de `SUFIXOS_DE_ID`, os mesmos que `descricao()` usa do outro lado.

  Os dois rótulos de ação também: `it.titulos` — `TITULOS` (`src/web/constantes.ts`), o mesmo mapa de
  onde a rota tira o `it.titulo` do `<h1>`. O botão que envia carrega o título desta tela, e a saída
  do estado vazio carrega o título da tela de cadastro de responsável, que é para onde ela leva.
  Escritos à mão, renomear qualquer uma das duas telas deixaria a outra ponta chamando-a pelo nome
  antigo, e nada acusa: o botão continua funcionando com a legenda errada.
*/
const aluno = it.aluno;
const disponiveis = it.disponiveis ?? [];
const temResponsaveis = it.temResponsaveis === true;
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;

const valor = (campo, padrao) => (valores[campo] === undefined ? padrao : valores[campo]);
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · <%= aluno.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O responsável é quem recebe comunicado e acompanha boletim e frequência deste aluno.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>">Voltar à ficha</a>
  </div>
</div>

<div class="quadro">
  <% if (disponiveis.length === 0) { %>
  <p class="suave leitura">
    <% if (!temResponsaveis) { %>
    Nenhum responsável cadastrado nesta rede ainda.
    <% } else { %>
    Todos os responsáveis cadastrados já estão vinculados a este aluno.
    <% } %>
  </p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.responsavelNovo() %>"><%= it.titulos.secretaria.responsavelNovo %></a>
    <a class="botao botao--discreto" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>">Voltar à ficha</a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.alunoResponsaveis({ id: aluno.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="responsavelId">
          Responsável <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="responsavelId"
          name="responsavelId"
          required
          <% if (erroDe('responsavelId') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('responsavelId') !== '') { %>aria-describedby="<%= descricao('responsavelId') %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% disponiveis.forEach((pessoa) => { %>
          <option value="<%= pessoa.id %>" <%= valor('responsavelId', '') === pessoa.id ? 'selected' : '' %>>
            <%= pessoa.nome %> — <%= pessoa.email %>
          </option>
          <% }) %>
        </select>
        <% if (erroDe('responsavelId') !== '') { %>
        <p class="campo__erro" id="responsavelId<%= sufixos.erro %>"><%= erroDe('responsavelId') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="parentesco">
          Parentesco <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="parentesco"
          name="parentesco"
          type="text"
          required
          maxlength="<%= it.limiteDoParentesco %>"
          value="<%= valor('parentesco', '') %>"
          <% if (erroDe('parentesco') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('parentesco', true) %>">
        <p class="campo__ajuda" id="parentesco<%= sufixos.ajuda %>">Mãe, pai, avó, tutor legal.</p>
        <% if (erroDe('parentesco') !== '') { %>
        <p class="campo__erro" id="parentesco<%= sufixos.erro %>"><%= erroDe('parentesco') %></p>
        <% } %>
      </div>
    </div>

    <div class="campo">
      <div class="campo campo--opcao">
        <input
          id="financeiro"
          name="financeiro"
          type="checkbox"
          value="<%= it.marcado %>"
          <%= valor('financeiro', false) === true ? 'checked' : '' %>
          aria-describedby="financeiro<%= sufixos.ajuda %>">
        <label class="campo__rotulo" for="financeiro">Responsável financeiro</label>
      </div>
      <p class="campo__ajuda" id="financeiro<%= sufixos.ajuda %>">
        Marque quem responde pela cobrança. O aluno pode ter mais de um responsável, e apenas um
        deles precisa ser o financeiro.
      </p>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.secretaria.vincularResponsavel %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>">Cancelar</a>
    </div>
  </form>
  <% } %>
</div>
