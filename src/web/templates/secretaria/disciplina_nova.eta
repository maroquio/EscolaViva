<%
/*
  Cadastro de disciplina.

  Um campo, e nenhum a mais: quem leciona a disciplina em cada turma se decide na tela da turma,
  depois que a disciplina existe. O nome é único na rede, e é a constraint do banco que garante
  isso — a mensagem aqui só traduz a recusa para o campo certo.

  Os dois endereços da tela — o destino do formulário e o "Cancelar" — vêm de `it.rotas`, o mesmo
  mapa que o router registra. São o mesmo endereço escrito duas vezes, e escrevê-lo à mão aqui não
  quebraria compilação: quebraria a tela de quem clica, porque `.eta` não passa pelo compilador.
*/

/*
  O limite do campo e os sufixos de id chegam prontos pelo `it`. O dono do tamanho é
  `LIMITES.disciplina.nome` (`src/academico/constantes.ts`), que `cadastrarDisciplina` faz valer com
  `MENSAGENS.disciplina.nomeLongo` — que ele coincida com o do aluno é coincidência, são duas
  políticas independentes. Os sufixos são de `SUFIXOS_DE_ID`, os mesmos que `descricao()` usa para
  montar o `aria-describedby` do outro lado.
*/
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Disciplinas</p>
    <h1 class="pagina__titulo">Cadastrar disciplina</h1>
    <p class="pagina__resumo">
      A disciplina vale para toda a rede. Depois de cadastrar, aloque-a nas turmas com o professor
      responsável.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.disciplinas() %>">
    <input type="hidden" name="_chave" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome da disciplina <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="nome"
        type="text"
        required
        maxlength="<%= it.limiteDoNome %>"
        autocomplete="off"
        value="<%= valores.nome ?? '' %>"
        <% if (erroDe('nome') !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao('nome', true) %>">
      <p class="campo__ajuda" id="nome<%= sufixos.ajuda %>">Único na rede: não há duas “Matemática”.</p>
      <% if (erroDe('nome') !== '') { %>
      <p class="campo__erro" id="nome<%= sufixos.erro %>"><%= erroDe('nome') %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Cadastrar disciplina</button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.disciplinas() %>">Cancelar</a>
    </div>
  </form>
</div>
