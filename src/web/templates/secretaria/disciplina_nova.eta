<%
/*
  Cadastro de disciplina.

  Um campo, e nenhum a mais: quem leciona a disciplina em cada turma se decide na tela da turma,
  depois que a disciplina existe. O nome é único na rede, e é a constraint do banco que garante
  isso — a mensagem aqui só traduz a recusa para o campo certo.
*/
const valores = it.valores ?? {};
const { erroDe, descricao } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Disciplinas</p>
    <h1 class="pagina__titulo">Cadastrar disciplina</h1>
    <p class="pagina__resumo">
      A disciplina vale para toda a rede. Depois de cadastrar, aloque-a nas turmas com o professor
      responsável.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="/secretaria/disciplinas">
    <input type="hidden" name="_chave" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome da disciplina <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="nome"
        type="text"
        required
        maxlength="120"
        autocomplete="off"
        value="<%= valores.nome ?? '' %>"
        <% if (erroDe('nome') !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao('nome', true) %>">
      <p class="campo__ajuda" id="nome-ajuda">Único na rede: não há duas “Matemática”.</p>
      <% if (erroDe('nome') !== '') { %>
      <p class="campo__erro" id="nome-erro"><%= erroDe('nome') %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Cadastrar disciplina</button>
      <a class="botao botao--discreto" href="/secretaria/disciplinas">Cancelar</a>
    </div>
  </form>
</div>
