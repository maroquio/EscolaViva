<%
/*
  Responsáveis da rede: a lista, e só. O cadastro mora em `/secretaria/responsaveis/novo`.

  O responsável pertence à rede, não a uma unidade: o vínculo com a unidade nasce da matrícula do
  aluno. Por isso a lista é a da rede inteira, e é na ficha do aluno que o vínculo se faz.
*/
const responsaveis = it.responsaveis ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria</p>
    <h1 class="pagina__titulo">Responsáveis</h1>
    <p class="pagina__resumo">
      Quem recebe comunicado e acompanha boletim e frequência. Depois de cadastrar, vincule o
      responsável ao aluno pela ficha dele.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="/secretaria/alunos">Buscar aluno</a>
    <a class="botao botao--primario" href="/secretaria/responsaveis/novo">Cadastrar responsável</a>
  </div>
</div>

<section class="secao" aria-labelledby="cadastrados">
  <div class="secao__cabecalho">
    <h2 id="cadastrados">Cadastrados na rede</h2>
    <p class="secao__nota">
      <% const quantos = it.navegacao === undefined ? responsaveis.length : it.navegacao.total; %>
      <span class="numero"><%= quantos %></span>
      <%= quantos === 1 ? 'responsável' : 'responsáveis' %>
    </p>
  </div>

  <% if (responsaveis.length === 0) { %>
  <%~ include("/parciais/_vazio", {
    titulo: 'Nenhum responsável cadastrado',
    texto: 'O e-mail é único na rede: é por ele que o responsável recebe comunicado — não é usado para entrar.',
    acao: { href: '/secretaria/responsaveis/novo', texto: 'Cadastrar responsável' }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Responsáveis cadastrados nesta rede</caption>
      <thead>
        <tr>
          <th scope="col" class="celula-elastica">Responsável</th>
          <th scope="col" class="celula-centro">CPF</th>
          <th scope="col" class="celula-texto">E-mail</th>
          <th scope="col" class="celula-centro">Telefone</th>
        </tr>
      </thead>
      <tbody>
        <% responsaveis.forEach((pessoa) => { %>
        <tr>
          <th scope="row" class="celula-elastica"><%= pessoa.nome %></th>
          <td class="numero celula-centro"><%= it.formatarCpf(pessoa.cpf ?? '') %></td>
          <td class="celula-texto"><%= pessoa.email %></td>
          <td class="numero celula-centro"><%= pessoa.telefone === null ? '—' : pessoa.telefone %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include("/parciais/_paginacao", { navegacao: it.navegacao, rotulo: 'responsáveis' }) %>
  <% } %>
</section>
