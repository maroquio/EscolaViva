<%
/*
  Cadastro de turma.

  A turma nasce dentro de uma unidade e de um ano letivo, e é isso que a torna possível de existir
  duas vezes com o mesmo nome em escolas diferentes. Faltando qualquer um dos dois, a página não
  finge um formulário que não teria o que oferecer: diz o que falta e para onde ir.

  Os três endereços da tela — o destino do formulário e os dois caminhos de volta à lista — vêm de
  `it.rotas`, o mesmo mapa que o router registra. A lista de turmas aparece três vezes (estado
  vazio, `action` e "Cancelar"): escritas à mão seriam três cópias do mesmo endereço, que podem
  divergir de uma só, e URL literal em `.eta` não quebra compilação — quebra a tela de quem clica.
*/

/*
  Os dois limites, o rótulo da opção em branco e os sufixos de id chegam prontos pelo `it`, e por
  isso não há número nenhum escrito nesta página. Os donos dos tamanhos são `LIMITES.turma.nome` e
  `LIMITES.turma.serie` (`src/academico/constantes.ts`), que `cadastrarTurma` faz valer com
  `MENSAGENS.turma.nomeLongo` e `.serieLonga` — são duas políticas, coincidentes hoje e livres para
  divergir amanhã, e o `maxlength` só adianta a recusa no navegador. `it.opcaoVazia` é
  `APRESENTACAO.opcaoVazia`, a primeira opção de todo seletor: os três desta página usam a mesma, e
  o `required` do HTML é que recusa o envio com ela. Os sufixos são de `SUFIXOS_DE_ID`, os mesmos
  que `descricao()` usa para montar o `aria-describedby` do outro lado.
*/
const unidades = it.unidades ?? [];
const anosLetivos = it.anosLetivos ?? [];
const turnos = it.turnos ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;

const listaDeTurmas = it.rotas.secretaria.turmas();
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Turmas</p>
    <h1 class="pagina__titulo">Cadastrar turma</h1>
    <p class="pagina__resumo">
      É na turma que se alocam as disciplinas com seus professores, e é para ela que os alunos são
      matriculados.
    </p>
  </div>
</div>

<div class="quadro">
  <% if (unidades.length === 0 || anosLetivos.length === 0) { %>
  <p class="suave leitura">
    <% if (unidades.length === 0) { %>
    Você ainda não tem o papel de secretaria em nenhuma unidade.
    <% } else { %>
    Esta rede ainda não tem ano letivo definido. Peça ao administrador da rede para definir um
    antes de cadastrar turmas.
    <% } %>
  </p>
  <div class="acoes">
    <a class="botao botao--discreto" href="<%= listaDeTurmas %>">Voltar às turmas</a>
  </div>
  <% } else { %>
  <form class="formulario formulario--largo" method="post" action="<%= listaDeTurmas %>">
    <input type="hidden" name="_chave" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="nome">
          Nome da turma <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="nome"
          name="nome"
          type="text"
          required
          maxlength="<%= it.limiteDoNome %>"
          autocomplete="off"
          value="<%= valores.nome ?? '' %>"
          <% if (erroDe('nome') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('nome', true) %>">
        <p class="campo__ajuda" id="nome<%= sufixos.ajuda %>">Único na unidade dentro do mesmo ano letivo.</p>
        <% if (erroDe('nome') !== '') { %>
        <p class="campo__erro" id="nome<%= sufixos.erro %>"><%= erroDe('nome') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="serie">
          Série <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="serie"
          name="serie"
          type="text"
          required
          maxlength="<%= it.limiteDaSerie %>"
          autocomplete="off"
          value="<%= valores.serie ?? '' %>"
          <% if (erroDe('serie') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('serie', true) %>">
        <p class="campo__ajuda" id="serie<%= sufixos.ajuda %>">Como a rede chama: 6º ano, 1ª série, Maternal II.</p>
        <% if (erroDe('serie') !== '') { %>
        <p class="campo__erro" id="serie<%= sufixos.erro %>"><%= erroDe('serie') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="turno">
          Turno <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turno"
          name="turno"
          required
          <% if (erroDe('turno') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('turno') !== '') { %>aria-describedby="<%= descricao('turno') %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% turnos.forEach((turno) => { %>
          <option value="<%= turno.valor %>" <%= (valores.turno ?? '') === turno.valor ? 'selected' : '' %>>
            <%= turno.nome %>
          </option>
          <% }) %>
        </select>
        <% if (erroDe('turno') !== '') { %>
        <p class="campo__erro" id="turno<%= sufixos.erro %>"><%= erroDe('turno') %></p>
        <% } %>
      </div>
    </div>

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="unidadeId">
          Unidade <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="unidadeId"
          name="unidadeId"
          required
          <% if (erroDe('unidadeId') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('unidadeId') !== '') { %>aria-describedby="<%= descricao('unidadeId') %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% unidades.forEach((unidade) => { %>
          <option value="<%= unidade.id %>" <%= (valores.unidadeId ?? '') === unidade.id ? 'selected' : '' %>>
            <%= unidade.nome %>
          </option>
          <% }) %>
        </select>
        <% if (erroDe('unidadeId') !== '') { %>
        <p class="campo__erro" id="unidadeId<%= sufixos.erro %>"><%= erroDe('unidadeId') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="anoLetivoId">
          Ano letivo <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="anoLetivoId"
          name="anoLetivoId"
          required
          <% if (erroDe('anoLetivoId') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('anoLetivoId') !== '') { %>aria-describedby="<%= descricao('anoLetivoId') %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% anosLetivos.forEach((anoLetivo) => { %>
          <option value="<%= anoLetivo.id %>" <%= (valores.anoLetivoId ?? '') === anoLetivo.id ? 'selected' : '' %>>
            <%= anoLetivo.ano %>
          </option>
          <% }) %>
        </select>
        <% if (erroDe('anoLetivoId') !== '') { %>
        <p class="campo__erro" id="anoLetivoId<%= sufixos.erro %>"><%= erroDe('anoLetivoId') %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Cadastrar turma</button>
      <a class="botao botao--discreto" href="<%= listaDeTurmas %>">Cancelar</a>
    </div>
  </form>
  <% } %>
</div>
