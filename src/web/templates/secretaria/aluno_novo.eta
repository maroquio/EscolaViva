<%
/*
  Cadastro de aluno.

  Dois campos, e nenhum a mais: matrícula, turma e responsável são vínculos que se fazem a partir
  da ficha, depois que o aluno existe. `required`, `maxlength` e `type=date` servem para o retorno
  rápido no navegador — a validação que decide é a do servidor (I22), e é dela que vêm as mensagens
  abaixo dos campos.

  Os dois endereços da tela — o destino do formulário e o "Cancelar" — vêm de `it.rotas`, o mesmo
  mapa que o router registra. São o mesmo endereço escrito duas vezes, e escrevê-lo à mão aqui não
  quebraria compilação: quebraria a tela de quem clica, porque `.eta` não passa pelo compilador.
*/

/*
  O limite do campo e os sufixos de id chegam prontos pelo `it`. O Eta não importa TypeScript, e
  redeclarar `120` aqui criaria uma segunda decisão ao lado da do dono — `LIMITES.aluno.nome`
  (`src/academico/constantes.ts`), que é o que o caso de uso `cadastrarAluno` faz valer, recusando o
  excedente com `MENSAGENS.aluno.nomeLongo`; o `maxlength` só adianta a recusa no navegador. O mesmo
  vale para `-erro` e `-ajuda`: quem monta o `aria-describedby` é `descricao()`, com `SUFIXOS_DE_ID`,
  e escrever o sufixo à mão aqui é o jeito de apontar para um id que não existe.

  O rótulo do botão que envia é o título desta tela: `it.titulos` — `TITULOS`
  (`src/web/constantes.ts`), o mesmo mapa de onde a rota tira o `it.titulo` do `<h1>` logo acima e de
  onde saem os rótulos dos botões que trazem alguém até aqui. "Cadastrar aluno" é uma decisão só,
  escrita no cabeçalho, no botão e em cada caminho de entrada; renomeá-la em um lugar e esquecer os
  outros deixa a tela se chamando de dois jeitos, e nada acusa.
*/
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Alunos</p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O aluno pertence à rede, não a uma unidade: é a matrícula que o coloca numa turma. Depois de
      cadastrar, a ficha abre com os caminhos para vincular um responsável e para matricular.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.alunos() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome completo <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="nome"
        type="text"
        required
        maxlength="<%= it.limiteDoNome %>"
        autocomplete="off"
        value="<%= valores.nome ?? '' %>"
        <% if (erroDe('nome') !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao('nome', true) %>">
      <p class="campo__ajuda" id="nome<%= sufixos.ajuda %>">Como consta no documento do aluno.</p>
      <% if (erroDe('nome') !== '') { %>
      <p class="campo__erro" id="nome<%= sufixos.erro %>"><%= erroDe('nome') %></p>
      <% } %>
    </div>

    <div class="campo">
      <label class="campo__rotulo" for="dataNascimento">
        Data de nascimento <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="dataNascimento"
        name="dataNascimento"
        type="date"
        required
        value="<%= valores.dataNascimento ?? '' %>"
        <% if (erroDe('dataNascimento') !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao('dataNascimento', true) %>">
      <p class="campo__ajuda" id="dataNascimento<%= sufixos.ajuda %>">
        Não pode estar no futuro.
      </p>
      <% if (erroDe('dataNascimento') !== '') { %>
      <p class="campo__erro" id="dataNascimento<%= sufixos.erro %>"><%= erroDe('dataNascimento') %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.secretaria.alunoNovo %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.alunos() %>">Cancelar</a>
    </div>
  </form>
</div>
