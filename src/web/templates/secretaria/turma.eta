<%
/*
  Detalhe da turma: as disciplinas alocadas com seus professores e quem está matriculado nela.

  A alocação é o que dá acesso ao professor: sem uma linha aqui, ele não vê a turma para lançar
  nota nem para registrar chamada. Por isso a lista de professores vem da unidade desta turma —
  quem não tem o papel ali não aparece, e o servidor recusa se a lista for burlada.
*/
const turma = it.turma;
const alocacoes = it.alocacoes ?? [];
const disciplinas = it.disciplinas ?? [];
const professores = it.professores ?? [];
const matriculas = it.matriculas ?? [];
const valores = it.valores ?? {};
const erros = Array.isArray(it.erros) ? it.erros : [];
const podeAlocar = disciplinas.length > 0 && professores.length > 0;

const erroDe = (campo) => {
  const achado = erros.find((problema) => problema.campo === campo);
  return achado === undefined ? '' : achado.mensagem;
};

const descricao = (campo, temAjuda) => {
  const ids = [];
  if (temAjuda) ids.push(campo + '-ajuda');
  if (erroDe(campo) !== '') ids.push(campo + '-erro');
  return ids.join(' ');
};
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · Turma</p>
    <h1 class="pagina__titulo"><%= turma.nome %></h1>
    <p class="pagina__resumo">
      <%= turma.serie %> · <%= turma.turno %> · <%= turma.unidadeNome %> · ano letivo
      <span class="numero"><%= turma.ano === null ? '—' : turma.ano %></span>
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="/secretaria/turmas">Voltar às turmas</a>
  </div>
</div>

<section class="secao" aria-labelledby="alocacoes">
  <div class="secao__cabecalho">
    <h2 id="alocacoes">Disciplinas alocadas</h2>
    <p class="secao__nota">
      <span class="numero"><%= alocacoes.length %></span>
      <%= alocacoes.length === 1 ? 'disciplina' : 'disciplinas' %>
    </p>
  </div>

  <div class="pilha pilha--larga">
    <% if (alocacoes.length === 0) { %>
    <%~ include("/parciais/_vazio", {
      titulo: 'Nenhuma disciplina alocada',
      texto: 'Enquanto não houver disciplina com professor nesta turma, nenhum professor consegue lançar nota nem registrar chamada aqui.'
    }) %>
    <% } else { %>
    <div class="tabela-rolagem">
      <table class="tabela">
        <caption>Quem leciona o quê nesta turma</caption>
        <thead>
          <tr>
            <th scope="col">Disciplina</th>
            <th scope="col">Professor</th>
          </tr>
        </thead>
        <tbody>
          <% alocacoes.forEach((alocacao) => { %>
          <tr>
            <th scope="row"><%= alocacao.disciplinaNome %></th>
            <td class="celula-texto"><%= alocacao.professorNome %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="quadro">
      <form class="formulario" method="post" action="/secretaria/turmas/<%= turma.id %>/disciplinas">
        <input type="hidden" name="_chave" value="<%= it.chave %>">
        <fieldset>
          <legend>Alocar disciplina e professor</legend>

          <% if (!podeAlocar) { %>
          <p class="suave leitura">
            <% if (disciplinas.length === 0) { %>
            Esta rede ainda não tem disciplina cadastrada.
            <a href="/secretaria/disciplinas">Cadastrar disciplina</a>
            <% } else { %>
            Nenhum usuário tem papel de professor em <%= turma.unidadeNome %>. Peça ao
            administrador da rede para atribuir o papel antes de alocar.
            <% } %>
          </p>
          <% } else { %>
          <div class="formulario__linha">
            <div class="campo">
              <label class="campo__rotulo" for="disciplinaId">
                Disciplina <span class="campo__obrigatorio" aria-hidden="true">*</span>
              </label>
              <select
                id="disciplinaId"
                name="disciplinaId"
                required
                <% if (erroDe('disciplinaId') !== '') { %>aria-invalid="true"<% } %>
                aria-describedby="<%= descricao('disciplinaId', true) %>">
                <option value="">Selecione…</option>
                <% disciplinas.forEach((disciplina) => { %>
                <option value="<%= disciplina.id %>" <%= (valores.disciplinaId ?? '') === disciplina.id ? 'selected' : '' %>>
                  <%= disciplina.nome %>
                </option>
                <% }) %>
              </select>
              <p class="campo__ajuda" id="disciplinaId-ajuda">
                Cada disciplina entra uma única vez por turma.
              </p>
              <% if (erroDe('disciplinaId') !== '') { %>
              <p class="campo__erro" id="disciplinaId-erro"><%= erroDe('disciplinaId') %></p>
              <% } %>
            </div>

            <div class="campo">
              <label class="campo__rotulo" for="professorUsuarioId">
                Professor <span class="campo__obrigatorio" aria-hidden="true">*</span>
              </label>
              <select
                id="professorUsuarioId"
                name="professorUsuarioId"
                required
                <% if (erroDe('professorUsuarioId') !== '') { %>aria-invalid="true"<% } %>
                aria-describedby="<%= descricao('professorUsuarioId', true) %>">
                <option value="">Selecione…</option>
                <% professores.forEach((professor) => { %>
                <option value="<%= professor.id %>" <%= (valores.professorUsuarioId ?? '') === professor.id ? 'selected' : '' %>>
                  <%= professor.nome %>
                </option>
                <% }) %>
              </select>
              <p class="campo__ajuda" id="professorUsuarioId-ajuda">
                Somente quem tem papel de professor em <%= turma.unidadeNome %>.
              </p>
              <% if (erroDe('professorUsuarioId') !== '') { %>
              <p class="campo__erro" id="professorUsuarioId-erro"><%= erroDe('professorUsuarioId') %></p>
              <% } %>
            </div>
          </div>

          <div class="acoes">
            <button class="botao botao--primario" type="submit">Alocar</button>
          </div>
          <% } %>
        </fieldset>
      </form>
    </div>
  </div>
</section>

<section class="secao" aria-labelledby="matriculados">
  <div class="secao__cabecalho">
    <h2 id="matriculados">Matrículas ativas</h2>
    <p class="secao__nota">
      <span class="numero"><%= matriculas.length %></span>
      <%= matriculas.length === 1 ? 'aluno' : 'alunos' %>
    </p>
  </div>

  <% if (matriculas.length === 0) { %>
  <%~ include("/parciais/_vazio", {
    titulo: 'Nenhum aluno matriculado',
    texto: 'Matricule pela ficha do aluno: procure pelo nome e escolha esta turma.',
    acao: { href: '/secretaria/alunos', texto: 'Buscar aluno' }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Alunos com matrícula ativa nesta turma</caption>
      <thead>
        <tr>
          <th scope="col">Aluno</th>
          <th scope="col">Matriculado em</th>
          <th scope="col">Situação</th>
          <th scope="col"><span class="visualmente-oculto">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% matriculas.forEach((matricula) => { %>
        <tr>
          <th scope="row"><%= matricula.alunoNome %></th>
          <td class="numero"><%= it.formatarData(matricula.dataMatricula) %></td>
          <td>
            <span class="etiqueta etiqueta--<%= matricula.situacao %>"><%= matricula.situacaoNome %></span>
          </td>
          <td>
            <div class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo" href="/secretaria/alunos/<%= matricula.alunoId %>">
                Abrir ficha<span class="visualmente-oculto"> de <%= matricula.alunoNome %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
