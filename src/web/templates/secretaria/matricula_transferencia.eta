<%
/*
  Transferência de turma.

  A turma de origem sai da lista de destino — transferir para onde já se está não é transferência.
  A operação é uma só: a matrícula atual passa a "transferida" e uma nova matrícula ativa nasce no
  destino, as duas escritas na mesma transação.

  Os cinco endereços da tela — o destino do formulário, o atalho para cadastrar turma e os três
  caminhos de volta à ficha — vêm de `it.rotas`, o mesmo mapa que o router registra. A ficha aparece
  três vezes (cabeçalho, estado vazio e "Cancelar"): escritas à mão seriam três cópias do mesmo
  endereço, que podem divergir de uma só, e URL literal em `.eta` não quebra compilação — quebra a
  tela de quem clica.
*/

/*
  O travessão da célula sem valor, o rótulo da opção em branco e os sufixos de id chegam prontos
  pelo `it`: são de `AUSENTE` (`src/shared/constantes.ts`), de `APRESENTACAO.opcaoVazia` e de
  `SUFIXOS_DE_ID` (`src/web/constantes.ts`). O Eta não importa TypeScript, e reescrevê-los aqui
  criaria uma segunda decisão ao lado da do dono — no caso dos sufixos, um id apontado pelo
  `aria-describedby` que `descricao()` monta e que esta página não escreveria igual.

  O atalho do estado vazio se rotula com o título da tela para onde leva: `it.titulos` — `TITULOS`
  (`src/web/constantes.ts`), o mesmo mapa de onde a rota tira o `it.titulo` da tela de cadastro de
  turma. Escrito à mão, renomear aquela tela deixaria este botão chamando-a pelo nome antigo, e nada
  acusa: ele continua levando ao lugar certo com a legenda errada.

  O botão que envia fica de fora: "Transferir matrícula" nomeia o que o clique faz com o registro, e
  o título desta tela — "Transferir de turma" — nomeia o movimento do aluno. São duas frases, e não a
  mesma dita duas vezes.
*/
const aluno = it.aluno;
const ativa = it.ativa;
const turmas = it.turmas ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao, sufixos } = it;

const valor = (campo, padrao) => (valores[campo] === undefined ? padrao : valores[campo]);

const agrupar = (lista) => {
  const grupos = [];
  lista.forEach((turma) => {
    let grupo = grupos.find((candidato) => candidato.anoLetivoId === turma.anoLetivoId);
    if (grupo === undefined) {
      grupo = { anoLetivoId: turma.anoLetivoId, ano: turma.ano, turmas: [] };
      grupos.push(grupo);
    }
    grupo.turmas.push(turma);
  });
  return grupos.sort((a, b) => (b.ano ?? 0) - (a.ano ?? 0));
};

const grupos = agrupar(turmas);
const fichaDoAluno = it.rotas.secretaria.aluno({ id: aluno.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria · <%= aluno.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Matrícula ativa em <strong><%= ativa.turmaNome %></strong>, ano letivo
      <span class="numero"><%= ativa.ano %></span>.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= fichaDoAluno %>">Voltar à ficha</a>
  </div>
</div>

<div class="quadro">
  <% if (grupos.length === 0) { %>
  <p class="suave leitura">Não há outra turma nas suas unidades para receber esta matrícula.</p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.turmaNova() %>"><%= it.titulos.secretaria.turmaNova %></a>
    <a class="botao botao--discreto" href="<%= fichaDoAluno %>">Voltar à ficha</a>
  </div>
  <% } else { %>
  <p class="suave leitura">
    A matrícula em <strong><%= ativa.turmaNome %></strong> passa a <em>transferida</em> e uma nova
    matrícula ativa é aberta na turma de destino — as duas escritas na mesma transação.
  </p>

  <form class="formulario" method="post" action="<%= it.rotas.secretaria.matriculaTransferir({ id: ativa.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="turmaDestinoId">
          Turma de destino <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turmaDestinoId"
          name="turmaDestinoId"
          required
          <% if (erroDe('turmaDestinoId') !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao('turmaDestinoId', true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% grupos.forEach((grupo) => { %>
          <optgroup label="Ano letivo <%= grupo.ano === null ? it.semValor : grupo.ano %>">
            <% grupo.turmas.forEach((turma) => { %>
            <option value="<%= turma.id %>" <%= valor('turmaDestinoId', '') === turma.id ? 'selected' : '' %>>
              <%= turma.nome %> · <%= turma.serie %> · <%= turma.turno %> · <%= turma.unidadeNome %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="turmaDestinoId<%= sufixos.ajuda %>">
          Precisa pertencer ao mesmo ano letivo da matrícula atual.
        </p>
        <% if (erroDe('turmaDestinoId') !== '') { %>
        <p class="campo__erro" id="turmaDestinoId<%= sufixos.erro %>"><%= erroDe('turmaDestinoId') %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="data">
          Data da transferência <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="data"
          name="data"
          type="date"
          required
          value="<%= valor('data', it.hoje) %>"
          <% if (erroDe('data') !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao('data') !== '') { %>aria-describedby="<%= descricao('data') %>"<% } %>>
        <% if (erroDe('data') !== '') { %>
        <p class="campo__erro" id="data<%= sufixos.erro %>"><%= erroDe('data') %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Transferir matrícula</button>
      <a class="botao botao--discreto" href="<%= fichaDoAluno %>">Cancelar</a>
    </div>
  </form>
  <% } %>
</div>
