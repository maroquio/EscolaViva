<%
/*
  Turmas das unidades em que a pessoa é secretaria: a lista e o filtro dela. O cadastro mora em
  `/secretaria/turmas/nova`.

  O filtro vive na URL, não em estado do servidor: a tela filtrada é um endereço que se guarda e se
  envia a outra pessoa. Só aparecem no seletor as unidades da própria secretaria — filtrar por uma
  unidade de fora não é uma opção que a tela ofereça.
*/
const turmas = it.turmas ?? [];
const unidades = it.unidades ?? [];
const anosLetivos = it.anosLetivos ?? [];
const filtro = it.filtro ?? { unidadeId: '', anoLetivoId: '' };
const filtrando = filtro.unidadeId !== '' || filtro.anoLetivoId !== '';
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo">Secretaria</p>
    <h1 class="pagina__titulo">Turmas</h1>
    <p class="pagina__resumo">
      A turma pertence a uma unidade e a um ano letivo. É nela que se alocam as disciplinas com seus
      professores, e é para ela que os alunos são matriculados.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="/secretaria/disciplinas">Disciplinas</a>
    <a class="botao botao--primario" href="/secretaria/turmas/nova">Cadastrar turma</a>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="get" action="/secretaria/turmas">
    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="unidade">Unidade</label>
        <select id="unidade" name="unidade">
          <option value="">Todas as suas unidades</option>
          <% unidades.forEach((unidade) => { %>
          <option value="<%= unidade.id %>" <%= filtro.unidadeId === unidade.id ? 'selected' : '' %>>
            <%= unidade.nome %>
          </option>
          <% }) %>
        </select>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="ano">Ano letivo</label>
        <select id="ano" name="ano">
          <option value="">Todos os anos</option>
          <% anosLetivos.forEach((anoLetivo) => { %>
          <option value="<%= anoLetivo.id %>" <%= filtro.anoLetivoId === anoLetivo.id ? 'selected' : '' %>>
            <%= anoLetivo.ano %>
          </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Filtrar</button>
      <% if (filtrando) { %>
      <a class="botao botao--discreto" href="/secretaria/turmas">Limpar filtro</a>
      <% } %>
    </div>
  </form>
</div>

<section class="secao" aria-labelledby="lista">
  <div class="secao__cabecalho">
    <h2 id="lista">Turmas</h2>
    <% const quantas = it.navegacao === undefined ? turmas.length : it.navegacao.total; %>
    <p class="secao__nota">
      <span class="numero"><%= quantas %></span>
      <%= quantas === 1 ? 'turma' : 'turmas' %><%= filtrando ? ' no filtro atual' : '' %>
    </p>
  </div>

  <% if (turmas.length === 0) { %>
  <%~ include("/parciais/_vazio", filtrando
    ? {
        titulo: 'Nenhuma turma nesse filtro',
        texto: 'Nenhuma turma das suas unidades combina com a unidade e o ano letivo escolhidos. Limpe o filtro para ver todas.',
        acao: { href: '/secretaria/turmas', texto: 'Limpar filtro' }
      }
    : {
        titulo: 'Nenhuma turma cadastrada',
        texto: 'Sem turma não há matrícula, alocação de professor nem chamada.',
        acao: { href: '/secretaria/turmas/nova', texto: 'Cadastrar turma' }
      }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Turmas das unidades sob sua secretaria</caption>
      <thead>
        <tr>
          <th scope="col">Turma</th>
          <th scope="col">Série</th>
          <th scope="col">Turno</th>
          <th scope="col">Unidade</th>
          <th scope="col">Ano</th>
          <th scope="col"><span class="visualmente-oculto">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% turmas.forEach((turma) => { %>
        <tr>
          <th scope="row"><%= turma.nome %></th>
          <td class="celula-texto"><%= turma.serie %></td>
          <td class="celula-texto"><%= turma.turno %></td>
          <td class="celula-texto"><%= turma.unidadeNome %></td>
          <td class="numero"><%= turma.ano === null ? '—' : turma.ano %></td>
          <td>
            <div class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo" href="/secretaria/turmas/<%= turma.id %>">
                Abrir<span class="visualmente-oculto"> turma <%= turma.nome %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include("/parciais/_paginacao", { navegacao: it.navegacao, rotulo: 'turmas' }) %>
  <% } %>
</section>
