<%
const schools = it.schools ?? [];
const totals = it.totals;
const currentYear = it.currentYear ?? null;

const shortcuts = [
  { href: it.routes.registrar.studentNew(), label: it.labels.student,
    title: it.titles.registrar.studentNew,
    detail: 'Nome e data de nascimento. A matrícula vem depois, na ficha.' },
  { href: it.routes.registrar.students(), label: it.labels.enrollment,
    title: 'Buscar e matricular',
    detail: 'Procure pelo nome para matricular, transferir ou vincular responsável.' },
  { href: it.routes.registrar.classGroups(), label: it.labels.classGroup,
    title: 'Turmas e professores',
    detail: 'Abra a turma para alocar disciplina e professor da unidade.' },
  { href: it.routes.registrar.guardians(), label: it.labels.guardian,
    // magic-values: permitido — não é `TITLES.registrar.guardianNew` nem `TITLES.registrar.guardians`
    title: 'Cadastrar responsável',
    detail: 'Quem recebe comunicado e responde pelo aluno.' },
];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Matrícula, transferência, turma e disciplina em um lugar só. Os números abaixo consideram
      apenas as unidades em que você tem o papel de secretaria.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.routes.registrar.studentNew() %>"><%= it.titles.registrar.studentNew %></a>
    <a class="botao botao--secundario" href="<%= it.routes.registrar.students() %>"><%= it.actions.searchStudent %></a>
  </div>
</div>

<% if (schools.length === 0) { %>
<%~ include(it.partials.empty, {
  title: 'Nenhuma unidade atribuída',
  text: 'Seu acesso existe, mas ainda não foi ligado a nenhuma unidade. Peça ao administrador da rede para atribuir o papel de secretaria em uma unidade.'
}) %>
<% } else { %>

<section class="secao" aria-labelledby="numbers">
  <div class="secao__cabecalho">
    <h2 id="numbers">Hoje</h2>
    <p class="secao__nota">
      <% if (currentYear === null) { %>
        Nenhum ano letivo definido nesta rede
      <% } else { %>
        Ano letivo mais recente: <span class="numero"><%= currentYear.year %></span>
        (<%= it.formatDate(currentYear.startDate) %> a <%= it.formatDate(currentYear.endDate) %>)
      <% } %>
    </p>
  </div>

  <div class="painel">
    <div class="cartao">
      <p class="cartao__rotulo"><%= it.labels.activeEnrollments %></p>
      <p class="cartao__numero"><%= totals.enrollments %></p>
      <p class="cartao__detalhe">alunos com matrícula ativa nas suas turmas</p>
    </div>
    <div class="cartao">
      <p class="cartao__rotulo">Turmas</p>
      <p class="cartao__numero"><%= totals.classGroups %></p>
      <p class="cartao__detalhe">em todos os anos letivos das suas unidades</p>
    </div>
    <div class="cartao">
      <p class="cartao__rotulo">Responsáveis</p>
      <p class="cartao__numero"><%= totals.guardians %></p>
      <p class="cartao__detalhe">com aluno matriculado nas suas unidades</p>
    </div>
    <div class="cartao">
      <p class="cartao__rotulo">Disciplinas</p>
      <p class="cartao__numero"><%= totals.subjects %></p>
      <p class="cartao__detalhe">cadastradas na rede, disponíveis para alocar</p>
    </div>
  </div>
</section>

<%
const schoolCount = it.pagination === undefined ? schools.length : it.pagination.total;
%>
<% if (schoolCount > 1) { %>
<section class="secao" aria-labelledby="by-school">
  <div class="secao__cabecalho">
    <h2 id="by-school">Por unidade</h2>
    <p class="secao__nota">
      Você responde por
      <span class="numero"><%= schoolCount %></span>
      <%= it.nouns.school.plural %>

    </p>
  </div>

  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Números de cada unidade sob sua secretaria</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.school %></th>
          <th scope="col">Turmas</th>
          <th scope="col"><%= it.labels.activeEnrollments %></th>
          <th scope="col">Responsáveis</th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach((school) => { %>
        <tr>
          <th scope="row"><%= school.name %></th>
          <td class="numero"><%= school.classGroups %></td>
          <td class="numero"><%= school.enrollments %></td>
          <td class="numero"><%= school.guardians %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.school.plural }) %>
</section>
<% } %>

<section class="secao" aria-labelledby="shortcuts">
  <div class="secao__cabecalho">
    <h2 id="shortcuts">Atalhos do dia</h2>
  </div>

  <div class="painel">
    <% shortcuts.forEach((shortcut) => { %>
    <a class="cartao" href="<%= shortcut.href %>">
      <p class="cartao__rotulo"><%= shortcut.label %></p>
      <h3><%= shortcut.title %></h3>
      <p class="cartao__detalhe"><%= shortcut.detail %></p>
    </a>
    <% }) %>
  </div>
</section>

<% } %>
