<%
const schools = it.schools ?? [];
const totals = it.totals;
const currentYear = it.currentYear ?? null;

const shortcuts = [
  { href: it.routes.registrar.studentNew(), label: it.labels.student,
    title: it.titles.registrar.studentNew,
    detail: 'Nome e data de nascimento. A matrícula vem depois, na ficha.' },
  { href: it.routes.registrar.students(), label: it.labels.enrollment,
    title: 'Buscar e matricular',
    detail: 'Procure pelo nome para matricular, transferir ou vincular responsável.' },
  { href: it.routes.registrar.classGroups(), label: it.labels.classGroup,
    title: 'Turmas e professores',
    detail: 'Abra a turma para alocar disciplina e professor da unidade.' },
  { href: it.routes.registrar.guardians(), label: it.labels.guardian,
    // magic-values: allowed — this is neither `TITLES.registrar.guardianNew` nor `TITLES.registrar.guardians`
    title: 'Cadastrar responsável',
    detail: 'Quem recebe comunicado e responde pelo aluno.' },
];
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Matrícula, transferência, turma e disciplina em um lugar só. Os números abaixo consideram
      apenas as unidades em que você tem o papel de secretaria.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--primary" href="<%= it.routes.registrar.studentNew() %>"><%= it.titles.registrar.studentNew %></a>
    <a class="button button--secondary" href="<%= it.routes.registrar.students() %>"><%= it.actions.searchStudent %></a>
  </div>
</div>

<% if (schools.length === 0) { %>
<%~ include(it.partials.empty, {
  title: 'Nenhuma unidade atribuída',
  text: 'Seu acesso existe, mas ainda não foi ligado a nenhuma unidade. Peça ao administrador da rede para atribuir o papel de secretaria em uma unidade.'
}) %>
<% } else { %>

<section class="section" aria-labelledby="numbers">
  <div class="section__header">
    <h2 id="numbers">Hoje</h2>
    <p class="section__note">
      <% if (currentYear === null) { %>
        Nenhum ano letivo definido nesta rede
      <% } else { %>
        Ano letivo mais recente: <span class="number"><%= currentYear.year %></span>
        (<%= it.formatDate(currentYear.startDate) %> a <%= it.formatDate(currentYear.endDate) %>)
      <% } %>
    </p>
  </div>

  <div class="dashboard">
    <div class="card">
      <p class="card__label"><%= it.labels.activeEnrollments %></p>
      <p class="card__number"><%= totals.enrollments %></p>
      <p class="card__detail">alunos com matrícula ativa nas suas turmas</p>
    </div>
    <div class="card">
      <p class="card__label">Turmas</p>
      <p class="card__number"><%= totals.classGroups %></p>
      <p class="card__detail">em todos os anos letivos das suas unidades</p>
    </div>
    <div class="card">
      <p class="card__label">Responsáveis</p>
      <p class="card__number"><%= totals.guardians %></p>
      <p class="card__detail">com aluno matriculado nas suas unidades</p>
    </div>
    <div class="card">
      <p class="card__label">Disciplinas</p>
      <p class="card__number"><%= totals.subjects %></p>
      <p class="card__detail">cadastradas na rede, disponíveis para alocar</p>
    </div>
  </div>
</section>

<%
const schoolCount = it.pagination === undefined ? schools.length : it.pagination.total;
%>
<% if (schoolCount > 1) { %>
<section class="section" aria-labelledby="by-school">
  <div class="section__header">
    <h2 id="by-school">Por unidade</h2>
    <p class="section__note">
      Você responde por
      <span class="number"><%= schoolCount %></span>
      <%= it.nouns.school.plural %>

    </p>
  </div>

  <div class="table-scroll">
    <table class="table">
      <caption>Números de cada unidade sob sua secretaria</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.school %></th>
          <th scope="col">Turmas</th>
          <th scope="col"><%= it.labels.activeEnrollments %></th>
          <th scope="col">Responsáveis</th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach((school) => { %>
        <tr>
          <th scope="row"><%= school.name %></th>
          <td class="number"><%= school.classGroups %></td>
          <td class="number"><%= school.enrollments %></td>
          <td class="number"><%= school.guardians %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.school.plural }) %>
</section>
<% } %>

<section class="section" aria-labelledby="shortcuts">
  <div class="section__header">
    <h2 id="shortcuts">Atalhos do dia</h2>
  </div>

  <div class="dashboard">
    <% shortcuts.forEach((shortcut) => { %>
    <a class="card" href="<%= shortcut.href %>">
      <p class="card__label"><%= shortcut.label %></p>
      <h3><%= shortcut.title %></h3>
      <p class="card__detail"><%= shortcut.detail %></p>
    </a>
    <% }) %>
  </div>
</section>

<% } %>
