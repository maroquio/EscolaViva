<%
const student = it.student;
const guardianLinks = it.guardianLinks ?? [];
const enrollments = it.enrollments ?? [];
const active = it.active ?? null;
const separatorAtLineEnd = it.presentation.separator.trimEnd();

const STATUS_CLASS = it.tagClass.enrollmentStatus;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.student %></p>
    <h1 class="page__title"><%= student.name %></h1>
    <p class="page__summary">
      Nascimento em <span class="number"><%= it.formatDate(student.birthDate) %></span>.
      <% if (active === null) { %>
        Sem matrícula ativa nas suas unidades.
      <% } else { %>
        Matriculado na turma <%= active.classGroupName %>, ano letivo <span class="number"><%= active.year %></span>.
      <% } %>
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.registrar.students() %>"><%= it.actions.backTo.search %></a>
  </div>
</div>

<section class="section" aria-labelledby="data">
  <div class="section__header">
    <h2 id="data">Dados do aluno</h2>
  </div>

  <div class="panel">
    <dl class="definition-list">
      <dt><%= it.labels.name %></dt>
      <dd><%= student.name %></dd>
      <dt>Nascimento</dt>
      <dd class="number"><%= it.formatDate(student.birthDate) %></dd>
      <dt>Matrícula ativa</dt>
      <dd>
        <% if (active === null) { %>
        <span class="muted">nenhuma</span>
        <% } else { %>
        <span class="tag tag--active"><%= it.statusLabel[active.status] %></span>
        <%= active.classGroupName %><%= it.presentation.separator %>ano letivo <span class="number"><%= active.year %></span><%= separatorAtLineEnd %>

        matriculado em <span class="number"><%= it.formatDate(active.enrollmentDate) %></span>
        <% } %>
      </dd>
    </dl>
  </div>
</section>

<section class="section" aria-labelledby="guardians">
  <div class="section__header">
    <h2 id="guardians">Responsáveis vinculados</h2>
    <% const linkCount =
         it.guardianLinksPagination === undefined ? guardianLinks.length : it.guardianLinksPagination.total; %>
    <p class="section__note">
      <span class="number"><%= linkCount %></span>
      <%= it.pluralize(linkCount, it.nouns.guardian) %>
    </p>
  </div>

  <div class="stack stack--wide">
    <% if (guardianLinks.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhum responsável vinculado',
      text: 'O responsável é quem recebe comunicado e acompanha boletim e frequência deste aluno.',
      action: {
        href: it.routes.registrar.studentGuardianNew({ id: student.id }),
        text: it.titles.registrar.linkGuardian
      }
    }) %>
    <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <caption>Quem responde por este aluno</caption>
        <thead>
          <tr>
            <th scope="col"><%= it.labels.guardian %></th>
            <th scope="col">Parentesco</th>
            <th scope="col"><%= it.labels.email %></th>
            <th scope="col">Financeiro</th>
          </tr>
        </thead>
        <tbody>
          <% guardianLinks.forEach((link) => { %>
          <tr>
            <th scope="row"><%= link.name %></th>
            <td class="cell-text"><%= link.relationship %></td>
            <td class="cell-text"><%= link.email %></td>
            <td><%= link.financiallyResponsible ? 'Sim' : 'Não' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%~ include(it.partials.pagination, {
      pagination: it.guardianLinksPagination, label: 'responsáveis vinculados'
    }) %>

    <div class="actions">
      <a class="button button--primary" href="<%= it.routes.registrar.studentGuardianNew({ id: student.id }) %>">
        <%= it.titles.registrar.linkGuardian %>

      </a>
    </div>
    <% } %>
  </div>
</section>

<section class="section" aria-labelledby="enrollments">
  <div class="section__header">
    <h2 id="enrollments">Matrículas</h2>
    <% const recordCount =
         it.enrollmentsPagination === undefined ? enrollments.length : it.enrollmentsPagination.total; %>
    <p class="section__note">
      <span class="number"><%= recordCount %></span>
      <%= recordCount === 1 ? 'registro' : 'registros' %> nas suas unidades
    </p>
  </div>

  <div class="stack stack--wide">
    <% if (enrollments.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma matrícula registrada',
      text: 'Este aluno ainda não foi matriculado em nenhuma turma sob sua secretaria.',
      action: { href: it.routes.registrar.studentEnroll({ id: student.id }), text: 'Matricular' }
    }) %>
    <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <caption>Histórico de matrículas deste aluno</caption>
        <thead>
          <tr>
            <th scope="col"><%= it.labels.classGroup %></th>
            <th scope="col"><%= it.labels.year %></th>
            <th scope="col">Data</th>
<% // magic-values: permitido — this is not a label out of LABELS, nor the ACADEMIC_VOCABULARY.enrollmentStatus of the cell below %>
            <th scope="col">Situação</th>
          </tr>
        </thead>
        <tbody>
          <% enrollments.forEach((enrollment) => { %>
          <tr>
            <th scope="row"><%= enrollment.classGroupName %></th>
            <td class="number"><%= enrollment.year %></td>
            <td class="number"><%= it.formatDate(enrollment.enrollmentDate) %></td>
            <td>
              <span class="tag <%= STATUS_CLASS[enrollment.status] %>"><%= it.statusLabel[enrollment.status] %></span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%~ include(it.partials.pagination, {
      pagination: it.enrollmentsPagination, label: it.nouns.enrollment.plural
    }) %>

    <div class="actions">
      <a class="button button--primary" href="<%= it.routes.registrar.studentEnroll({ id: student.id }) %>">
        <%= it.titles.registrar.enroll %>

      </a>
      <% if (active !== null) { %>
      <a class="button button--secondary" href="<%= it.routes.registrar.enrollmentTransfer({ id: active.id }) %>">
        <%= it.titles.registrar.transfer %>

      </a>
      <% } %>
      <p class="section__note">Um aluno tem, no máximo, uma matrícula ativa por ano letivo.</p>
    </div>
    <% } %>
  </div>
</section>
