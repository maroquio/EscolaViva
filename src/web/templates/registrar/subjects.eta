<%
const subjects = it.subjects ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Cadastradas uma vez para toda a rede. Cada turma recebe as suas na tela da turma, sempre com
      o professor responsável.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.routes.registrar.classGroups() %>"><%= it.titles.registrar.classGroups %></a>
    <a class="botao botao--primario" href="<%= it.routes.registrar.subjectNew() %>"><%= it.titles.registrar.subjectNew %></a>
  </div>
</div>

<section class="secao" aria-labelledby="registered">
  <div class="secao__cabecalho">
    <h2 id="registered">Cadastradas na rede</h2>
    <p class="secao__nota">
      <% const count = it.pagination === undefined ? subjects.length : it.pagination.total; %>
      <span class="numero"><%= count %></span>
      <%= it.pluralize(count, it.nouns.subject) %>
    </p>
  </div>

  <% if (subjects.length === 0) { %>
  <%~ include(it.partials.empty, {
    title: 'Nenhuma disciplina cadastrada',
    text: 'Sem disciplina não há alocação de professor, e sem alocação não há lançamento de nota.',
    action: { href: it.routes.registrar.subjectNew(), text: it.titles.registrar.subjectNew }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Disciplinas disponíveis para alocar nas turmas</caption>
      <thead>
        <tr>
          <th scope="col"><%= it.labels.subject %></th>
        </tr>
      </thead>
      <tbody>
        <% subjects.forEach((subject) => { %>
        <tr>
          <th scope="row"><%= subject.name %></th>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.subject.plural }) %>
  <% } %>
</section>
