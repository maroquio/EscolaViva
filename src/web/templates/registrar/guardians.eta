<%
const responsaveis = it.responsaveis ?? [];
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Quem recebe comunicado e acompanha boletim e frequência. Depois de cadastrar, vincule o
      responsável ao aluno pela ficha dele.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.rotas.secretaria.alunos() %>"><%= it.acoes.buscarAluno %></a>
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.responsavelNovo() %>"><%= it.titulos.secretaria.responsavelNovo %></a>
  </div>
</div>

<section class="secao" aria-labelledby="cadastrados">
  <div class="secao__cabecalho">
    <h2 id="cadastrados">Cadastrados na rede</h2>
    <p class="secao__nota">
      <% const quantos = it.navegacao === undefined ? responsaveis.length : it.navegacao.total; %>
      <span class="numero"><%= quantos %></span>
      <%= it.pluralizar(quantos, it.contagem.responsavel) %>
    </p>
  </div>

  <% if (responsaveis.length === 0) { %>
  <%~ include(it.parciais.vazio, {
    titulo: 'Nenhum responsável cadastrado',
    texto: 'O e-mail é único na rede: é por ele que o responsável recebe comunicado — não é usado para entrar.',
    acao: { href: it.rotas.secretaria.responsavelNovo(), texto: it.titulos.secretaria.responsavelNovo }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Responsáveis cadastrados nesta rede</caption>
      <thead>
        <tr>
          <th scope="col" class="celula-elastica"><%= it.rotulos.responsavel %></th>
          <th scope="col" class="celula-centro"><%= it.rotulos.cpf %></th>
          <th scope="col" class="celula-texto"><%= it.rotulos.email %></th>
          <th scope="col" class="celula-centro">Telefone</th>
        </tr>
      </thead>
      <tbody>
        <% responsaveis.forEach((pessoa) => { %>
        <tr>
          <th scope="row" class="celula-elastica"><%= pessoa.nome %></th>
          <td class="numero celula-centro"><%= it.formatarCpf(pessoa.cpf ?? '') %></td>
          <td class="celula-texto"><%= pessoa.email %></td>
          <td class="numero celula-centro"><%= pessoa.telefone === null ? it.semValor : pessoa.telefone %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.parciais.paginacao, { navegacao: it.navegacao, rotulo: it.contagem.responsavel.plural }) %>
  <% } %>
</section>
