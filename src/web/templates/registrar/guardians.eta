<%
const guardians = it.guardians ?? [];
const invite = it.invite ?? null;
const invited = invite === null ? null : (guardians.find((g) => g.id === invite.userId) ?? null);
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Quem recebe comunicado e acompanha boletim e frequência. O cadastro já cria o acesso ao
      portal; depois, vincule o responsável ao aluno pela ficha dele.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.registrar.students() %>"><%= it.actions.searchStudent %></a>
    <a class="button button--primary" href="<%= it.routes.registrar.guardianNew() %>"><%= it.titles.registrar.guardianNew %></a>
  </div>
</div>

<% if (invite !== null && invited !== null) { %>
<div class="notice notice--warning" role="status">
  <p class="notice__title">Senha provisória de <%= invited.name %></p>
  <p><code class="code"><%= invite.password %></code></p>
  <p>
    Anote agora: esta senha aparece uma única vez e não pode ser recuperada depois que você sair
    desta página. Entregue-a pessoalmente ou por um canal que vocês já usem — o envio automático
    por e-mail entra no Estágio 04. Peça que a pessoa entre com o CPF
    <strong><%= it.formatCpf(invited.cpf ?? '') %></strong> e troque a senha no primeiro acesso.
  </p>
</div>
<% } %>

<section class="section" aria-labelledby="registered">
  <div class="section__header">
    <h2 id="registered">Cadastrados na rede</h2>
    <p class="section__note">
      <% const count = it.pagination === undefined ? guardians.length : it.pagination.total; %>
      <span class="number"><%= count %></span>
      <%= it.pluralize(count, it.nouns.guardian) %>
    </p>
  </div>

  <% if (guardians.length === 0) { %>
  <%~ include(it.partials.empty, {
    title: 'Nenhum responsável cadastrado',
    text: 'Cadastrar um responsável cria o acesso ao portal: o CPF é como ele entra, e o e-mail é só contato.',
    action: { href: it.routes.registrar.guardianNew(), text: it.titles.registrar.guardianNew }
  }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Responsáveis cadastrados nesta rede</caption>
      <thead>
        <tr>
          <th scope="col" class="cell-elastic"><%= it.labels.guardian %></th>
          <th scope="col" class="cell-center"><%= it.labels.cpf %></th>
          <th scope="col" class="cell-text"><%= it.labels.email %></th>
          <th scope="col" class="cell-center">Telefone</th>
        </tr>
      </thead>
      <tbody>
        <% guardians.forEach((guardian) => { %>
        <tr>
          <th scope="row" class="cell-elastic"><%= guardian.name %></th>
          <td class="number cell-center"><%= it.formatCpf(guardian.cpf ?? '') %></td>
          <td class="cell-text"><%= guardian.email %></td>
          <td class="number cell-center"><%= guardian.phone === null ? it.missingValue : guardian.phone %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.guardian.plural }) %>
  <% } %>
</section>
