<%
const values = it.values ?? {};
const { errorFor, describedBy } = it;
const fields = it.fields.guardian;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.guardians %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Quem recebe comunicado e acompanha boletim e frequência. Depois de cadastrar, vincule-o ao
      aluno pela ficha dele.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.routes.registrar.guardians() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome completo <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="<%= fields.name %>"
        type="text"
        required
        maxlength="<%= it.nameLimit %>"
        autocomplete="off"
        value="<%= values.name ?? '' %>"
        <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.name) !== '') { %>aria-describedby="<%= describedBy(fields.name) %>"<% } %>>
      <% if (errorFor(fields.name) !== '') { %>
      <p class="campo__erro" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
      <% } %>
    </div>

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="email">
          <%= it.labels.email %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= fields.email %>"
          type="email"
          required
          maxlength="<%= it.emailLimit %>"
          autocomplete="off"
          value="<%= values.email ?? '' %>"
          <% if (errorFor(fields.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.email, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.email) %>">
          Único na rede. É por ele que o responsável recebe comunicado — não é usado para entrar.
        </p>
        <% if (errorFor(fields.email) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.email) %>"><%= errorFor(fields.email) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="cpf"><%= it.labels.cpf %></label>
        <input
          id="cpf"
          name="<%= fields.cpf %>"
          type="text"
          maxlength="<%= it.maskedCpfLimit %>"
          autocomplete="off"
          value="<%= values.cpf ?? '' %>"
          <% if (errorFor(fields.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.cpf, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.cpf) %>">
          Opcional. Sem CPF a pessoa fica como contato e não recebe acesso ao portal.
        </p>
        <% if (errorFor(fields.cpf) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.cpf) %>"><%= errorFor(fields.cpf) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="telefone">Telefone</label>
        <input
          id="telefone"
          name="<%= fields.phone %>"
          type="tel"
          maxlength="<%= it.phoneLimit %>"
          autocomplete="off"
          value="<%= values.phone ?? '' %>"
          <% if (errorFor(fields.phone) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.phone, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.phone) %>">Opcional. Em branco significa sem telefone.</p>
        <% if (errorFor(fields.phone) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.phone) %>"><%= errorFor(fields.phone) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titles.registrar.guardianNew %></button>
      <a class="botao botao--discreto" href="<%= it.routes.registrar.guardians() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
