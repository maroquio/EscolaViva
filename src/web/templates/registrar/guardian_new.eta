<%
const values = it.values ?? {};
const { errorFor, describedBy } = it;
const fields = it.fields.guardian;
const schools = it.schools ?? [];
const chosenSchool = values.schoolId ?? '';
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.guardians %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Quem recebe comunicado e acompanha boletim e frequência. Cadastrar cria o acesso ao portal:
      a senha provisória é gerada agora e aparece uma única vez na lista. Depois, vincule o
      responsável ao aluno pela ficha dele.
    </p>
  </div>
</div>

<div class="panel">
  <form class="form" method="post" action="<%= it.routes.registrar.guardians() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="field">
      <label class="field__label" for="name">
        Nome completo <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="name"
        name="<%= fields.name %>"
        type="text"
        required
        maxlength="<%= it.nameLimit %>"
        autocomplete="off"
        value="<%= values.name ?? '' %>"
        <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
        <% if (describedBy(fields.name) !== '') { %>aria-describedby="<%= describedBy(fields.name) %>"<% } %>>
      <% if (errorFor(fields.name) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
      <% } %>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="email">
          <%= it.labels.email %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="<%= fields.email %>"
          type="email"
          required
          maxlength="<%= it.emailLimit %>"
          autocomplete="off"
          value="<%= values.email ?? '' %>"
          <% if (errorFor(fields.email) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.email, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.email) %>">
          Contato: é por ele que o responsável recebe comunicado. Não é usado para entrar, e uma
          mesma família pode repetir o endereço.
        </p>
        <% if (errorFor(fields.email) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.email) %>"><%= errorFor(fields.email) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="cpf">
          <%= it.labels.cpf %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="cpf"
          name="<%= fields.cpf %>"
          type="text"
          required
          maxlength="<%= it.maskedCpfLimit %>"
          autocomplete="off"
          value="<%= values.cpf ?? '' %>"
          <% if (errorFor(fields.cpf) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.cpf, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.cpf) %>">
          É por ele que o responsável entra. Com ou sem pontos.
        </p>
        <% if (errorFor(fields.cpf) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.cpf) %>"><%= errorFor(fields.cpf) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="phone">Telefone</label>
        <input
          id="phone"
          name="<%= fields.phone %>"
          type="tel"
          maxlength="<%= it.phoneLimit %>"
          autocomplete="off"
          value="<%= values.phone ?? '' %>"
          <% if (errorFor(fields.phone) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.phone, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.phone) %>">Opcional. Em branco significa sem telefone.</p>
        <% if (errorFor(fields.phone) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.phone) %>"><%= errorFor(fields.phone) %></p>
        <% } %>
      </div>
    </div>

    <% if (schools.length > 1) { %>
    <div class="field">
      <label class="field__label" for="schoolId">
        <%= it.labels.school %> <span class="field__required" aria-hidden="true">*</span>
      </label>
      <select
        id="schoolId"
        name="<%= fields.schoolId %>"
        required
        <% if (errorFor(fields.schoolId) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.schoolId, true) %>">
        <option value=""><%= it.emptyOption %></option>
        <% schools.forEach((school) => { %>
        <option value="<%= school.id %>" <%= chosenSchool === school.id ? 'selected' : '' %>><%= school.name %></option>
        <% }) %>
      </select>
      <p class="field__help" id="<%= it.helpId(fields.schoolId) %>">
        Onde o responsável entra no portal. O vínculo com cada aluno vem depois, pela ficha dele.
      </p>
      <% if (errorFor(fields.schoolId) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.schoolId) %>"><%= errorFor(fields.schoolId) %></p>
      <% } %>
    </div>
    <% } %>

    <div class="actions">
      <button class="button button--primary" type="submit"><%= it.titles.registrar.guardianNew %></button>
      <a class="button button--quiet" href="<%= it.routes.registrar.guardians() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
