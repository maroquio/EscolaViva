<%
const classGroup = it.classGroup;
const subjects = it.subjects ?? [];
const teachers = it.teachers ?? [];
const values = it.values ?? {};
const { errorFor, describedBy } = it;
const fields = it.fields.teachingAssignment;
const canAssign = subjects.length > 0 && teachers.length > 0;
const classGroupPage = it.routes.registrar.classGroup({ id: classGroup.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.classGroup(classGroup.name) %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      <%= classGroup.gradeLevel %><%= it.presentation.separator %><%= classGroup.shiftName %><%= it.presentation.separator %><%= classGroup.schoolName %><%= it.presentation.separator %>ano letivo
      <span class="numero"><%= classGroup.year === null ? it.missingValue : classGroup.year %></span>
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= classGroupPage %>"><%= it.actions.backTo.classGroup %></a>
  </div>
</div>

<div class="quadro">
  <% if (!canAssign) { %>
  <p class="suave leitura">
    <% if (subjects.length === 0) { %>
    Esta rede ainda não tem disciplina cadastrada.
    <% } else { %>
    Nenhum usuário tem papel de professor em <%= classGroup.schoolName %>. Peça ao administrador da
    rede para atribuir o papel antes de alocar.
    <% } %>
  </p>
  <div class="acoes">
    <% if (subjects.length === 0) { %>
    <a class="botao botao--primario" href="<%= it.routes.registrar.subjectNew() %>"><%= it.titles.registrar.subjectNew %></a>
    <% } %>
    <a class="botao botao--discreto" href="<%= classGroupPage %>"><%= it.actions.backTo.classGroup %></a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.routes.registrar.classGroupSubjects({ id: classGroup.id }) %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="disciplinaId">
          <%= it.labels.subject %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="disciplinaId"
          name="<%= fields.subjectId %>"
          required
          <% if (errorFor(fields.subjectId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.subjectId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% subjects.forEach((subject) => { %>
          <option value="<%= subject.id %>" <%= (values.subjectId ?? '') === subject.id ? 'selected' : '' %>>
            <%= subject.name %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.helpId(fields.subjectId) %>">
          Cada disciplina entra uma única vez por turma.
        </p>
        <% if (errorFor(fields.subjectId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.subjectId) %>"><%= errorFor(fields.subjectId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="professorUsuarioId">
          Professor <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="professorUsuarioId"
          name="<%= fields.teacherUserId %>"
          required
          <% if (errorFor(fields.teacherUserId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.teacherUserId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% teachers.forEach((teacher) => { %>
          <option value="<%= teacher.id %>" <%= (values.teacherUserId ?? '') === teacher.id ? 'selected' : '' %>>
            <%= teacher.name %>
          </option>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.helpId(fields.teacherUserId) %>">
          Somente quem tem papel de professor em <%= classGroup.schoolName %>.
        </p>
        <% if (errorFor(fields.teacherUserId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.teacherUserId) %>"><%= errorFor(fields.teacherUserId) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Alocar</button>
      <a class="botao botao--discreto" href="<%= classGroupPage %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
