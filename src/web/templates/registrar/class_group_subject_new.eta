<%
const classGroup = it.classGroup;
const subjects = it.subjects ?? [];
const teachers = it.teachers ?? [];
const values = it.values ?? {};
const { errorFor, describedBy } = it;
const fields = it.fields.teachingAssignment;
const canAssign = subjects.length > 0 && teachers.length > 0;
const classGroupPage = it.routes.registrar.classGroup({ id: classGroup.id });
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.classGroup(classGroup.name) %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      <%= classGroup.gradeLevel %><%= it.presentation.separator %><%= classGroup.shiftName %><%= it.presentation.separator %><%= classGroup.schoolName %><%= it.presentation.separator %>ano letivo
      <span class="number"><%= classGroup.year === null ? it.missingValue : classGroup.year %></span>
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= classGroupPage %>"><%= it.actions.backTo.classGroup %></a>
  </div>
</div>

<div class="panel">
  <% if (!canAssign) { %>
  <p class="muted reading">
    <% if (subjects.length === 0) { %>
    Esta rede ainda não tem disciplina cadastrada.
    <% } else { %>
    Nenhum usuário tem papel de professor em <%= classGroup.schoolName %>. Peça ao administrador da
    rede para atribuir o papel antes de alocar.
    <% } %>
  </p>
  <div class="actions">
    <% if (subjects.length === 0) { %>
    <a class="button button--primary" href="<%= it.routes.registrar.subjectNew() %>"><%= it.titles.registrar.subjectNew %></a>
    <% } %>
    <a class="button button--quiet" href="<%= classGroupPage %>"><%= it.actions.backTo.classGroup %></a>
  </div>
  <% } else { %>
  <form class="form" method="post" action="<%= it.routes.registrar.classGroupSubjects({ id: classGroup.id }) %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="subjectId">
          <%= it.labels.subject %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="subjectId"
          name="<%= fields.subjectId %>"
          required
          <% if (errorFor(fields.subjectId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.subjectId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% subjects.forEach((subject) => { %>
          <option value="<%= subject.id %>" <%= (values.subjectId ?? '') === subject.id ? 'selected' : '' %>>
            <%= subject.name %>
          </option>
          <% }) %>
        </select>
        <p class="field__help" id="<%= it.helpId(fields.subjectId) %>">
          Cada disciplina entra uma única vez por turma.
        </p>
        <% if (errorFor(fields.subjectId) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.subjectId) %>"><%= errorFor(fields.subjectId) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="teacherUserId">
          Professor <span class="field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="teacherUserId"
          name="<%= fields.teacherUserId %>"
          required
          <% if (errorFor(fields.teacherUserId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.teacherUserId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% teachers.forEach((teacher) => { %>
          <option value="<%= teacher.id %>" <%= (values.teacherUserId ?? '') === teacher.id ? 'selected' : '' %>>
            <%= teacher.name %>
          </option>
          <% }) %>
        </select>
        <p class="field__help" id="<%= it.helpId(fields.teacherUserId) %>">
          Somente quem tem papel de professor em <%= classGroup.schoolName %>.
        </p>
        <% if (errorFor(fields.teacherUserId) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.teacherUserId) %>"><%= errorFor(fields.teacherUserId) %></p>
        <% } %>
      </div>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit">Alocar</button>
      <a class="button button--quiet" href="<%= classGroupPage %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
