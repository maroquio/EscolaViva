<%
const student = it.student;
const active = it.active;
const classGroups = it.classGroups ?? [];
const values = it.values ?? {};
const { errorFor, describedBy, actions } = it;
const fields = it.fields.transfer;

const chosenClassGroup = values.targetClassGroupId ?? '';
const transferDate = values.date ?? it.today;

const classGroupLabel = (classGroup) =>
  [classGroup.name, classGroup.gradeLevel, classGroup.shiftName, classGroup.schoolName].join(it.presentation.separator);

const groupByYear = (items) => {
  const groups = [];
  items.forEach((classGroup) => {
    let group = groups.find((candidate) => candidate.academicYearId === classGroup.academicYearId);
    if (group === undefined) {
      group = { academicYearId: classGroup.academicYearId, year: classGroup.year, classGroups: [] };
      groups.push(group);
    }
    group.classGroups.push(classGroup);
  });
  return groups.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
};

const groups = groupByYear(classGroups);
const studentRecord = it.routes.registrar.student({ id: student.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= student.name %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Matrícula ativa em <strong><%= active.classGroupName %></strong>, ano letivo
      <span class="numero"><%= active.year %></span>.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= studentRecord %>"><%= actions.backTo.record %></a>
  </div>
</div>

<div class="quadro">
  <% if (groups.length === 0) { %>
  <p class="suave leitura">Não há outra turma nas suas unidades para receber esta matrícula.</p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.routes.registrar.classGroupNew() %>"><%= it.titles.registrar.classGroupNew %></a>
    <a class="botao botao--discreto" href="<%= studentRecord %>"><%= actions.backTo.record %></a>
  </div>
  <% } else { %>
  <p class="suave leitura">
    A matrícula em <strong><%= active.classGroupName %></strong> passa a <em>transferida</em> e uma nova
    matrícula ativa é aberta na turma de destino — as duas escritas na mesma transação.
  </p>

  <form class="formulario" method="post" action="<%= it.routes.registrar.enrollmentTransfer({ id: active.id }) %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="turmaDestinoId">
          Turma de destino <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turmaDestinoId"
          name="<%= fields.targetClassGroupId %>"
          required
          <% if (errorFor(fields.targetClassGroupId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.targetClassGroupId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% groups.forEach((group) => { %>
          <optgroup label="<%= it.labels.academicYear %> <%= group.year === null ? it.missingValue : group.year %>">
            <% group.classGroups.forEach((classGroup) => { %>
            <option value="<%= classGroup.id %>" <%= chosenClassGroup === classGroup.id ? 'selected' : '' %>>
              <%= classGroupLabel(classGroup) %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.helpId(fields.targetClassGroupId) %>">
          Precisa pertencer ao mesmo ano letivo da matrícula atual.
        </p>
        <% if (errorFor(fields.targetClassGroupId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.targetClassGroupId) %>"><%= errorFor(fields.targetClassGroupId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="data">
          Data da transferência <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="data"
          name="<%= fields.date %>"
          type="date"
          required
          value="<%= transferDate %>"
          <% if (errorFor(fields.date) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.date) !== '') { %>aria-describedby="<%= describedBy(fields.date) %>"<% } %>>
        <% if (errorFor(fields.date) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.date) %>"><%= errorFor(fields.date) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Transferir matrícula</button>
      <a class="botao botao--discreto" href="<%= studentRecord %>"><%= actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
