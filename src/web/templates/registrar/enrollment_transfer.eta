<%
const aluno = it.aluno;
const ativa = it.ativa;
const turmas = it.turmas ?? [];
const valores = it.valores ?? {};
const { erroDe, descricao, acoes } = it;
const campos = it.campos.transferencia;

const valor = (campo, padrao) => (valores[campo] === undefined ? padrao : valores[campo]);

const rotuloDaTurma = (turma) =>
  [turma.nome, turma.serie, turma.turno, turma.unidadeNome].join(it.apresentacao.separador);

const agrupar = (lista) => {
  const grupos = [];
  lista.forEach((turma) => {
    let grupo = grupos.find((candidato) => candidato.anoLetivoId === turma.anoLetivoId);
    if (grupo === undefined) {
      grupo = { anoLetivoId: turma.anoLetivoId, ano: turma.ano, turmas: [] };
      grupos.push(grupo);
    }
    grupo.turmas.push(turma);
  });
  return grupos.sort((a, b) => (b.ano ?? 0) - (a.ano ?? 0));
};

const grupos = agrupar(turmas);
const fichaDoAluno = it.rotas.secretaria.aluno({ id: aluno.id });
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %><%= it.apresentacao.separador %><%= aluno.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      Matrícula ativa em <strong><%= ativa.turmaNome %></strong>, ano letivo
      <span class="numero"><%= ativa.ano %></span>.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= fichaDoAluno %>"><%= acoes.voltarPara.ficha %></a>
  </div>
</div>

<div class="quadro">
  <% if (grupos.length === 0) { %>
  <p class="suave leitura">Não há outra turma nas suas unidades para receber esta matrícula.</p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.turmaNova() %>"><%= it.titulos.secretaria.turmaNova %></a>
    <a class="botao botao--discreto" href="<%= fichaDoAluno %>"><%= acoes.voltarPara.ficha %></a>
  </div>
  <% } else { %>
  <p class="suave leitura">
    A matrícula em <strong><%= ativa.turmaNome %></strong> passa a <em>transferida</em> e uma nova
    matrícula ativa é aberta na turma de destino — as duas escritas na mesma transação.
  </p>

  <form class="formulario" method="post" action="<%= it.rotas.secretaria.matriculaTransferir({ id: ativa.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="turmaDestinoId">
          Turma de destino <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turmaDestinoId"
          name="<%= campos.turmaDestinoId %>"
          required
          <% if (erroDe(campos.turmaDestinoId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.turmaDestinoId, true) %>">
          <option value=""><%= it.opcaoVazia %></option>
          <% grupos.forEach((grupo) => { %>
          <optgroup label="<%= it.rotulos.anoLetivo %> <%= grupo.ano === null ? it.semValor : grupo.ano %>">
            <% grupo.turmas.forEach((turma) => { %>
            <option value="<%= turma.id %>" <%= valor(campos.turmaDestinoId, '') === turma.id ? 'selected' : '' %>>
              <%= rotuloDaTurma(turma) %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.turmaDestinoId) %>">
          Precisa pertencer ao mesmo ano letivo da matrícula atual.
        </p>
        <% if (erroDe(campos.turmaDestinoId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.turmaDestinoId) %>"><%= erroDe(campos.turmaDestinoId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="data">
          Data da transferência <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="data"
          name="<%= campos.data %>"
          type="date"
          required
          value="<%= valor(campos.data, it.hoje) %>"
          <% if (erroDe(campos.data) !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao(campos.data) !== '') { %>aria-describedby="<%= descricao(campos.data) %>"<% } %>>
        <% if (erroDe(campos.data) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.data) %>"><%= erroDe(campos.data) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Transferir matrícula</button>
      <a class="botao botao--discreto" href="<%= fichaDoAluno %>"><%= acoes.cancelar %></a>
    </div>
  </form>
  <% } %>
</div>
