<%
const student = it.student;
const classGroups = it.classGroups ?? [];
const academicYears = it.academicYears ?? [];
const values = it.values ?? {};
const fields = it.fields.enrollment;
const { errorFor, describedBy } = it;

const chosenClassGroup = values.classGroupId ?? '';
const chosenYear = values.academicYearId ?? '';
const enrollmentDate = values.enrollmentDate ?? it.today;

const groupByYear = (items) => {
  const groups = [];
  items.forEach((classGroup) => {
    let group = groups.find((candidate) => candidate.academicYearId === classGroup.academicYearId);
    if (group === undefined) {
      group = { academicYearId: classGroup.academicYearId, year: classGroup.year, classGroups: [] };
      groups.push(group);
    }
    group.classGroups.push(classGroup);
  });
  return groups.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
};

const groups = groupByYear(classGroups);
const studentRecord = it.routes.registrar.student({ id: student.id });

const classGroupLabel = (classGroup) =>
  [classGroup.name, classGroup.gradeLevel, classGroup.shiftName, classGroup.schoolName].join(it.presentation.separator);
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= student.name %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      Um aluno tem, no máximo, uma matrícula ativa por ano letivo.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= studentRecord %>"><%= it.actions.backTo.record %></a>
  </div>
</div>

<div class="panel">
  <% if (classGroups.length === 0 || academicYears.length === 0) { %>
  <p class="muted reading">Não há turma disponível nas suas unidades.</p>
  <div class="actions">
    <a class="button button--primary" href="<%= it.routes.registrar.classGroupNew() %>"><%= it.titles.registrar.classGroupNew %></a>
    <a class="button button--quiet" href="<%= studentRecord %>"><%= it.actions.backTo.record %></a>
  </div>
  <% } else { %>
  <form class="form" method="post" action="<%= it.routes.registrar.enrollments() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">
    <input type="hidden" name="<%= fields.studentId %>" value="<%= student.id %>">

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="classGroupId">
          <%= it.labels.classGroup %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="classGroupId"
          name="<%= fields.classGroupId %>"
          required
          <% if (errorFor(fields.classGroupId) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.classGroupId) !== '') { %>aria-describedby="<%= describedBy(fields.classGroupId) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% groups.forEach((group) => { %>
          <optgroup label="<%= it.labels.academicYear %> <%= group.year === null ? it.missingValue : group.year %>">
            <% group.classGroups.forEach((classGroup) => { %>
            <option value="<%= classGroup.id %>" <%= chosenClassGroup === classGroup.id ? 'selected' : '' %>>
              <%= classGroupLabel(classGroup) %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
        <% if (errorFor(fields.classGroupId) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.classGroupId) %>"><%= errorFor(fields.classGroupId) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="academicYearId">
          <%= it.labels.academicYear %> <span class="field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="academicYearId"
          name="<%= fields.academicYearId %>"
          required
          <% if (errorFor(fields.academicYearId) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.academicYearId, true) %>">
          <option value=""><%= it.emptyOption %></option>
          <% academicYears.forEach((academicYear) => { %>
          <option value="<%= academicYear.id %>" <%= chosenYear === academicYear.id ? 'selected' : '' %>>
            <%= academicYear.year %>
          </option>
          <% }) %>
        </select>
        <p class="field__help" id="<%= it.helpId(fields.academicYearId) %>">
          Precisa ser o mesmo ano da turma escolhida — o servidor recusa o par que não fecha.
        </p>
        <% if (errorFor(fields.academicYearId) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.academicYearId) %>"><%= errorFor(fields.academicYearId) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="enrollmentDate">
          Data da matrícula <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="enrollmentDate"
          name="<%= fields.enrollmentDate %>"
          type="date"
          required
          value="<%= enrollmentDate %>"
          <% if (errorFor(fields.enrollmentDate) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.enrollmentDate) !== '') { %>aria-describedby="<%= describedBy(fields.enrollmentDate) %>"<% } %>>
        <% if (errorFor(fields.enrollmentDate) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.enrollmentDate) %>"><%= errorFor(fields.enrollmentDate) %></p>
        <% } %>
      </div>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit">Matricular</button>
      <a class="button button--quiet" href="<%= studentRecord %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
