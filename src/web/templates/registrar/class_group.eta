<%
const classGroup = it.classGroup;
const assignments = it.assignments ?? [];
const enrollments = it.enrollments ?? [];

const STATUS_CLASS = it.tagClass.enrollmentStatus;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.labels.classGroup %></p>
    <h1 class="pagina__titulo"><%= classGroup.name %></h1>
    <p class="pagina__resumo">
      <%= classGroup.gradeLevel %><%= it.presentation.separator %><%= classGroup.shiftName %><%= it.presentation.separator %><%= classGroup.schoolName %><%= it.presentation.separator %>ano letivo
      <span class="numero"><%= classGroup.year === null ? it.missingValue : classGroup.year %></span>
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.routes.registrar.classGroups() %>"><%= it.actions.backTo.classGroups %></a>
  </div>
</div>

<section class="secao" aria-labelledby="alocacoes">
  <div class="secao__cabecalho">
    <h2 id="alocacoes">Disciplinas alocadas</h2>
    <% const assignmentCount =
         it.assignmentsPagination === undefined ? assignments.length : it.assignmentsPagination.total; %>
    <p class="secao__nota">
      <span class="numero"><%= assignmentCount %></span>
      <%= it.pluralize(assignmentCount, it.nouns.subject) %>
    </p>
  </div>

  <div class="pilha pilha--larga">
    <% if (assignments.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma disciplina alocada',
      text: 'Enquanto não houver disciplina com professor nesta turma, nenhum professor consegue lançar nota nem registrar chamada aqui.',
      action: {
        href: it.routes.registrar.classGroupSubjectNew({ id: classGroup.id }),
        text: 'Alocar disciplina'
      }
    }) %>
    <% } else { %>
    <div class="tabela-rolagem">
      <table class="tabela">
        <caption>Quem leciona o quê nesta turma</caption>
        <thead>
          <tr>
            <th scope="col"><%= it.labels.subject %></th>
            <th scope="col" class="celula-texto">Professor</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach((assignment) => { %>
          <tr>
            <th scope="row"><%= assignment.subjectName %></th>
            <td class="celula-texto"><%= assignment.teacherName %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%~ include(it.partials.pagination, {
      pagination: it.assignmentsPagination, label: 'disciplinas alocadas'
    }) %>

    <div class="acoes">
      <a class="botao botao--primario" href="<%= it.routes.registrar.classGroupSubjectNew({ id: classGroup.id }) %>">
        <%= it.titles.registrar.assign %>

      </a>
    </div>
    <% } %>
  </div>
</section>

<section class="secao" aria-labelledby="matriculados">
  <div class="secao__cabecalho">
    <h2 id="matriculados"><%= it.labels.activeEnrollments %></h2>
    <% const studentCount =
         it.enrollmentsPagination === undefined ? enrollments.length : it.enrollmentsPagination.total; %>
    <p class="secao__nota">
      <span class="numero"><%= studentCount %></span>
      <%= it.pluralize(studentCount, it.nouns.student) %>
    </p>
  </div>

  <% if (enrollments.length === 0) { %>
  <%~ include(it.partials.empty, {
    title: it.noEnrolledStudent,
    text: 'Matricule pela ficha do aluno: procure pelo nome e escolha esta turma.',
    action: { href: it.routes.registrar.students(), text: it.actions.searchStudent }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Alunos com matrícula ativa nesta turma</caption>
      <thead>
        <tr>
          <th scope="col" class="celula-elastica"><%= it.labels.student %></th>
          <th scope="col" class="celula-centro">Matriculado em</th>
<% // magic-values: permitido — a cabeça da coluna não é um rótulo de `LABELS` %>
          <th scope="col" class="celula-centro">Situação</th>
          <th scope="col" class="celula-centro"><%= it.labels.actions %></th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach((enrollment) => { %>
        <tr>
          <th scope="row" class="celula-elastica"><%= enrollment.studentName %></th>
          <td class="numero celula-centro"><%= it.formatDate(enrollment.enrollmentDate) %></td>
          <td class="celula-centro">
            <span class="etiqueta <%= STATUS_CLASS[enrollment.status] %>"><%= it.statusLabel[enrollment.status] %></span>
          </td>
          <td class="celula-centro">
            <div class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo" href="<%= it.routes.registrar.student({ id: enrollment.studentId }) %>">
                Abrir ficha<span class="visualmente-oculto"> de <%= enrollment.studentName %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, {
    pagination: it.enrollmentsPagination, label: 'matrículas ativas'
  }) %>
  <% } %>
</section>
