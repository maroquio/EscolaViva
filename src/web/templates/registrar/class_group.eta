<%
const classGroup = it.classGroup;
const assignments = it.assignments ?? [];
const enrollments = it.enrollments ?? [];

const STATUS_CLASS = it.tagClass.enrollmentStatus;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.labels.classGroup %></p>
    <h1 class="page__title"><%= classGroup.name %></h1>
    <p class="page__summary">
      <%= classGroup.gradeLevel %><%= it.presentation.separator %><%= classGroup.shiftName %><%= it.presentation.separator %><%= classGroup.schoolName %><%= it.presentation.separator %>ano letivo
      <span class="number"><%= classGroup.year === null ? it.missingValue : classGroup.year %></span>
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.registrar.classGroups() %>"><%= it.actions.backTo.classGroups %></a>
  </div>
</div>

<section class="section" aria-labelledby="assignments">
  <div class="section__header">
    <h2 id="assignments">Disciplinas alocadas</h2>
    <% const assignmentCount =
         it.assignmentsPagination === undefined ? assignments.length : it.assignmentsPagination.total; %>
    <p class="section__note">
      <span class="number"><%= assignmentCount %></span>
      <%= it.pluralize(assignmentCount, it.nouns.subject) %>
    </p>
  </div>

  <div class="stack stack--wide">
    <% if (assignments.length === 0) { %>
    <%~ include(it.partials.empty, {
      title: 'Nenhuma disciplina alocada',
      text: 'Enquanto não houver disciplina com professor nesta turma, nenhum professor consegue lançar nota nem registrar chamada aqui.',
      action: {
        href: it.routes.registrar.classGroupSubjectNew({ id: classGroup.id }),
        text: 'Alocar disciplina'
      }
    }) %>
    <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <caption>Quem leciona o quê nesta turma</caption>
        <thead>
          <tr>
            <th scope="col"><%= it.labels.subject %></th>
            <th scope="col" class="cell-text">Professor</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach((assignment) => { %>
          <tr>
            <th scope="row"><%= assignment.subjectName %></th>
            <td class="cell-text"><%= assignment.teacherName %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%~ include(it.partials.pagination, {
      pagination: it.assignmentsPagination, label: 'disciplinas alocadas'
    }) %>

    <div class="actions">
      <a class="button button--primary" href="<%= it.routes.registrar.classGroupSubjectNew({ id: classGroup.id }) %>">
        <%= it.titles.registrar.assign %>

      </a>
    </div>
    <% } %>
  </div>
</section>

<section class="section" aria-labelledby="enrolled">
  <div class="section__header">
    <h2 id="enrolled"><%= it.labels.activeEnrollments %></h2>
    <% const studentCount =
         it.enrollmentsPagination === undefined ? enrollments.length : it.enrollmentsPagination.total; %>
    <p class="section__note">
      <span class="number"><%= studentCount %></span>
      <%= it.pluralize(studentCount, it.nouns.student) %>
    </p>
  </div>

  <% if (enrollments.length === 0) { %>
  <%~ include(it.partials.empty, {
    title: it.noEnrolledStudent,
    text: 'Matricule pela ficha do aluno: procure pelo nome e escolha esta turma.',
    action: { href: it.routes.registrar.students(), text: it.actions.searchStudent }
  }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Alunos com matrícula ativa nesta turma</caption>
      <thead>
        <tr>
          <th scope="col" class="cell-elastic"><%= it.labels.student %></th>
          <th scope="col" class="cell-center">Matriculado em</th>
<% // magic-values: allowed — the column head is not a label out of `LABELS` %>
          <th scope="col" class="cell-center">Situação</th>
          <th scope="col" class="cell-center"><%= it.labels.actions %></th>
        </tr>
      </thead>
      <tbody>
        <% enrollments.forEach((enrollment) => { %>
        <tr>
          <th scope="row" class="cell-elastic"><%= enrollment.studentName %></th>
          <td class="number cell-center"><%= it.formatDate(enrollment.enrollmentDate) %></td>
          <td class="cell-center">
            <span class="tag <%= STATUS_CLASS[enrollment.status] %>"><%= it.statusLabel[enrollment.status] %></span>
          </td>
          <td class="cell-center">
            <div class="table__actions">
              <a class="button button--secondary button--small" href="<%= it.routes.registrar.student({ id: enrollment.studentId }) %>">
                Abrir ficha<span class="visually-hidden"> de <%= enrollment.studentName %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, {
    pagination: it.enrollmentsPagination, label: 'matrículas ativas'
  }) %>
  <% } %>
</section>
