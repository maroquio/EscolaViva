<%
const schools = it.schools ?? [];
const academicYears = it.academicYears ?? [];
const shifts = it.shifts ?? [];
const values = it.values ?? {};
const fields = it.fields.classGroup;
const { errorFor, describedBy } = it;

const classGroupList = it.routes.registrar.classGroups();
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.classGroups %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      É na turma que se alocam as disciplinas com seus professores, e é para ela que os alunos são
      matriculados.
    </p>
  </div>
</div>

<div class="quadro">
  <% if (schools.length === 0 || academicYears.length === 0) { %>
  <p class="suave leitura">
    <% if (schools.length === 0) { %>
    Você ainda não tem o papel de secretaria em nenhuma unidade.
    <% } else { %>
    Esta rede ainda não tem ano letivo definido. Peça ao administrador da rede para definir um
    antes de cadastrar turmas.
    <% } %>
  </p>
  <div class="acoes">
    <a class="botao botao--discreto" href="<%= classGroupList %>"><%= it.actions.backTo.classGroups %></a>
  </div>
  <% } else { %>
  <form class="formulario formulario--largo" method="post" action="<%= classGroupList %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="nome">
          Nome da turma <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="nome"
          name="<%= fields.name %>"
          type="text"
          required
          maxlength="<%= it.nameLimit %>"
          autocomplete="off"
          value="<%= values.name ?? '' %>"
          <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.name, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.name) %>">Único na unidade dentro do mesmo ano letivo.</p>
        <% if (errorFor(fields.name) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="serie">
          Série <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="serie"
          name="<%= fields.gradeLevel %>"
          type="text"
          required
          maxlength="<%= it.gradeLevelLimit %>"
          autocomplete="off"
          value="<%= values.gradeLevel ?? '' %>"
          <% if (errorFor(fields.gradeLevel) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.gradeLevel, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.gradeLevel) %>">Como a rede chama: 6º ano, 1ª série, Maternal II.</p>
        <% if (errorFor(fields.gradeLevel) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.gradeLevel) %>"><%= errorFor(fields.gradeLevel) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="turno">
          Turno <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="turno"
          name="<%= fields.shift %>"
          required
          <% if (errorFor(fields.shift) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.shift) !== '') { %>aria-describedby="<%= describedBy(fields.shift) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% shifts.forEach((shift) => { %>
          <option value="<%= shift.value %>" <%= (values.shift ?? '') === shift.value ? 'selected' : '' %>>
            <%= shift.label %>
          </option>
          <% }) %>
        </select>
        <% if (errorFor(fields.shift) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.shift) %>"><%= errorFor(fields.shift) %></p>
        <% } %>
      </div>
    </div>

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="unidadeId">
          <%= it.labels.school %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="unidadeId"
          name="<%= fields.schoolId %>"
          required
          <% if (errorFor(fields.schoolId) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.schoolId) !== '') { %>aria-describedby="<%= describedBy(fields.schoolId) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% schools.forEach((school) => { %>
          <option value="<%= school.id %>" <%= (values.schoolId ?? '') === school.id ? 'selected' : '' %>>
            <%= school.name %>
          </option>
          <% }) %>
        </select>
        <% if (errorFor(fields.schoolId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.schoolId) %>"><%= errorFor(fields.schoolId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="anoLetivoId">
          <%= it.labels.academicYear %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="anoLetivoId"
          name="<%= fields.academicYearId %>"
          required
          <% if (errorFor(fields.academicYearId) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.academicYearId) !== '') { %>aria-describedby="<%= describedBy(fields.academicYearId) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% academicYears.forEach((academicYear) => { %>
          <option value="<%= academicYear.id %>" <%= (values.academicYearId ?? '') === academicYear.id ? 'selected' : '' %>>
            <%= academicYear.year %>
          </option>
          <% }) %>
        </select>
        <% if (errorFor(fields.academicYearId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.academicYearId) %>"><%= errorFor(fields.academicYearId) %></p>
        <% } %>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titles.registrar.classGroupNew %></button>
      <a class="botao botao--discreto" href="<%= classGroupList %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
