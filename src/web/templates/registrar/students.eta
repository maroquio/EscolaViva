<%
const students = it.students ?? [];
const term = it.term ?? '';
const searched = it.searched === true;

const STATUS_CLASS = it.tagClass.enrollmentStatus;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      Procure pelo nome para abrir a ficha, matricular, transferir ou vincular um responsável.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--primario" href="<%= it.routes.registrar.studentNew() %>"><%= it.titles.registrar.studentNew %></a>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="get" action="<%= it.routes.registrar.students() %>" role="search" aria-label="<%= it.actions.searchStudent %>">
    <div class="campo">
      <label class="campo__rotulo" for="q">Nome do aluno</label>
      <input id="q" name="<%= it.searchField %>" type="search" value="<%= term %>" autocomplete="off"
             maxlength="<%= it.nameLimit %>" aria-describedby="q<%= it.suffixes.help %>">
      <p class="campo__ajuda" id="q<%= it.suffixes.help %>">
        Encontra qualquer trecho do nome, sem diferenciar maiúsculas. Lista em ordem alfabética,
        <%= it.rowsPerPage %> por página.
      </p>
    </div>
    <div class="acoes">
      <button class="botao botao--primario" type="submit">Buscar</button>
      <% if (term !== '') { %>
      <a class="botao botao--discreto" href="<%= it.routes.registrar.students() %>">Limpar busca</a>
      <% } %>
    </div>
  </form>
</div>

<section class="secao" aria-labelledby="resultado">
  <div class="secao__cabecalho">
    <h2 id="resultado">Resultado</h2>
    <% if (searched) { %>
    <% const found = it.pagination === undefined ? students.length : it.pagination.total; %>
    <p class="secao__nota">
      <span class="numero"><%= found %></span>
      <%= found === 1 ? 'aluno encontrado' : 'alunos encontrados' %>
    </p>
    <% } %>
  </div>

  <% if (!searched) { %>
  <%~ include(it.partials.empty, {
    title: 'Comece pela busca',
    text: 'Digite parte do nome do aluno acima. A lista só aparece depois da busca — é ela que evita carregar a rede inteira para achar uma pessoa.'
  }) %>
  <% } else if (students.length === 0) { %>
  <%~ include(it.partials.empty, {
    title: 'Nenhum aluno com esse nome',
    text: 'Confira a grafia ou tente apenas o primeiro nome. Se o aluno ainda não existe nesta rede, cadastre-o agora.',
    action: { href: it.routes.registrar.studentNew(), text: it.titles.registrar.studentNew }
  }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Alunos encontrados para “<%= term %>”</caption>
      <thead>
        <tr>
          <th scope="col" class="celula-elastica"><%= it.labels.student %></th>
          <th scope="col" class="celula-centro">Nascimento</th>
          <th scope="col" class="celula-centro"><%= it.labels.classGroup %></th>
          <th scope="col" class="celula-centro"><%= it.labels.year %></th>
          <th scope="col" class="celula-centro"><%= it.labels.enrollment %></th>
          <th scope="col" class="celula-centro"><%= it.labels.actions %></th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach((student) => { %>
        <tr>
          <th scope="row" class="celula-elastica"><%= student.name %></th>
          <td class="numero celula-centro"><%= it.formatDate(student.birthDate) %></td>
          <td class="celula-centro"><%= student.classGroupName === null ? it.missingValue : student.classGroupName %></td>
          <td class="numero celula-centro"><%= student.year === null ? it.missingValue : student.year %></td>
          <td class="celula-centro">
            <% if (student.status === null) { %>
                        <span class="etiqueta">Sem matrícula</span>
            <% } else { %>
            <span class="etiqueta <%= STATUS_CLASS[student.status] %>"><%= it.statusLabel[student.status] %></span>
            <% } %>
          </td>
          <td class="celula-centro">
            <div class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo" href="<%= it.routes.registrar.student({ id: student.id }) %>">
                Abrir ficha<span class="visualmente-oculto"> de <%= student.name %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: 'alunos encontrados' }) %>
  <% } %>
</section>
