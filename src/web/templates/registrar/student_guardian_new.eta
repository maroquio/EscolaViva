<%
const aluno = it.aluno;
const disponiveis = it.disponiveis ?? [];
const temResponsaveis = it.temResponsaveis === true;
const valores = it.valores ?? {};
const campos = it.campos.vinculo;
const { erroDe, descricao } = it;

const valor = (campo, padrao) => (valores[campo] === undefined ? padrao : valores[campo]);
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %><%= it.apresentacao.separador %><%= aluno.nome %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O responsável é quem recebe comunicado e acompanha boletim e frequência deste aluno.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>"><%= it.acoes.voltarPara.ficha %></a>
  </div>
</div>

<div class="quadro">
  <% if (disponiveis.length === 0) { %>
  <p class="suave leitura">
    <% if (!temResponsaveis) { %>
    Nenhum responsável cadastrado nesta rede ainda.
    <% } else { %>
    Todos os responsáveis cadastrados já estão vinculados a este aluno.
    <% } %>
  </p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.rotas.secretaria.responsavelNovo() %>"><%= it.titulos.secretaria.responsavelNovo %></a>
    <a class="botao botao--discreto" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>"><%= it.acoes.voltarPara.ficha %></a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.alunoResponsaveis({ id: aluno.id }) %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="responsavelId">
          Responsável <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="responsavelId"
          name="<%= campos.responsavelId %>"
          required
          <% if (erroDe(campos.responsavelId) !== '') { %>aria-invalid="true"<% } %>
          <% if (descricao(campos.responsavelId) !== '') { %>aria-describedby="<%= descricao(campos.responsavelId) %>"<% } %>>
          <option value=""><%= it.opcaoVazia %></option>
          <% disponiveis.forEach((pessoa) => { %>
          <option value="<%= pessoa.id %>" <%= valor(campos.responsavelId, '') === pessoa.id ? 'selected' : '' %>>
            <%= pessoa.nome %> — <%= pessoa.email %>
          </option>
          <% }) %>
        </select>
        <% if (erroDe(campos.responsavelId) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.responsavelId) %>"><%= erroDe(campos.responsavelId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="parentesco">
          Parentesco <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="parentesco"
          name="<%= campos.parentesco %>"
          type="text"
          required
          maxlength="<%= it.limiteDoParentesco %>"
          value="<%= valor(campos.parentesco, '') %>"
          <% if (erroDe(campos.parentesco) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= descricao(campos.parentesco, true) %>">
        <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.parentesco) %>">Mãe, pai, avó, tutor legal.</p>
        <% if (erroDe(campos.parentesco) !== '') { %>
        <p class="campo__erro" id="<%= it.idDoErro(campos.parentesco) %>"><%= erroDe(campos.parentesco) %></p>
        <% } %>
      </div>
    </div>

    <div class="campo">
      <div class="campo campo--opcao">
        <input
          id="financeiro"
          name="<%= campos.financeiro %>"
          type="checkbox"
          value="<%= it.marcado %>"
          <%= valor(campos.financeiro, false) === true ? 'checked' : '' %>
          aria-describedby="<%= it.idDaAjuda(campos.financeiro) %>">
        <label class="campo__rotulo" for="financeiro">Responsável financeiro</label>
      </div>
      <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.financeiro) %>">
        Marque quem responde pela cobrança. O aluno pode ter mais de um responsável, e apenas um
        deles precisa ser o financeiro.
      </p>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.secretaria.vincularResponsavel %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.aluno({ id: aluno.id }) %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
  <% } %>
</div>
