<%
const student = it.student;
const available = it.available ?? [];
const hasGuardians = it.hasGuardians === true;
const values = it.values ?? {};
const fields = it.fields.guardianLink;
const { errorFor, describedBy } = it;

const chosenGuardian = values.guardianId ?? '';
const relationship = values.relationship ?? '';
const financiallyResponsible = values.financiallyResponsible === true;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %><%= it.presentation.separator %><%= student.name %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      O responsável é quem recebe comunicado e acompanha boletim e frequência deste aluno.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.backTo.record %></a>
  </div>
</div>

<div class="quadro">
  <% if (available.length === 0) { %>
  <p class="suave leitura">
    <% if (!hasGuardians) { %>
    Nenhum responsável cadastrado nesta rede ainda.
    <% } else { %>
    Todos os responsáveis cadastrados já estão vinculados a este aluno.
    <% } %>
  </p>
  <div class="acoes">
    <a class="botao botao--primario" href="<%= it.routes.registrar.guardianNew() %>"><%= it.titles.registrar.guardianNew %></a>
    <a class="botao botao--discreto" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.backTo.record %></a>
  </div>
  <% } else { %>
  <form class="formulario" method="post" action="<%= it.routes.registrar.studentGuardians({ id: student.id }) %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="responsavelId">
          Responsável <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <select
          id="responsavelId"
          name="<%= fields.guardianId %>"
          required
          <% if (errorFor(fields.guardianId) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.guardianId) !== '') { %>aria-describedby="<%= describedBy(fields.guardianId) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% available.forEach((guardian) => { %>
          <option value="<%= guardian.id %>" <%= chosenGuardian === guardian.id ? 'selected' : '' %>>
            <%= guardian.name %> — <%= guardian.email %>
          </option>
          <% }) %>
        </select>
        <% if (errorFor(fields.guardianId) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.guardianId) %>"><%= errorFor(fields.guardianId) %></p>
        <% } %>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="parentesco">
          Parentesco <span class="campo__obrigatorio" aria-hidden="true">*</span>
        </label>
        <input
          id="parentesco"
          name="<%= fields.relationship %>"
          type="text"
          required
          maxlength="<%= it.relationshipLimit %>"
          value="<%= relationship %>"
          <% if (errorFor(fields.relationship) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.relationship, true) %>">
        <p class="campo__ajuda" id="<%= it.helpId(fields.relationship) %>">Mãe, pai, avó, tutor legal.</p>
        <% if (errorFor(fields.relationship) !== '') { %>
        <p class="campo__erro" id="<%= it.errorId(fields.relationship) %>"><%= errorFor(fields.relationship) %></p>
        <% } %>
      </div>
    </div>

    <div class="campo">
      <div class="campo campo--opcao">
        <input
          id="financeiro"
          name="<%= fields.financiallyResponsible %>"
          type="checkbox"
          value="<%= it.checkedValue %>"
          <%= financiallyResponsible ? 'checked' : '' %>
          aria-describedby="<%= it.helpId(fields.financiallyResponsible) %>">
        <label class="campo__rotulo" for="financeiro">Responsável financeiro</label>
      </div>
      <p class="campo__ajuda" id="<%= it.helpId(fields.financiallyResponsible) %>">
        Marque quem responde pela cobrança. O aluno pode ter mais de um responsável, e apenas um
        deles precisa ser o financeiro.
      </p>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titles.registrar.linkGuardian %></button>
      <a class="botao botao--discreto" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
