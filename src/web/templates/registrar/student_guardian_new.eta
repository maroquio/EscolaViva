<%
const student = it.student;
const available = it.available ?? [];
const hasGuardians = it.hasGuardians === true;
const values = it.values ?? {};
const fields = it.fields.guardianLink;
const { errorFor, describedBy } = it;

const chosenGuardian = values.userId ?? '';
const relationship = values.relationship ?? '';
const financiallyResponsible = values.financiallyResponsible === true;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= student.name %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      O responsável é quem recebe comunicado e acompanha boletim e frequência deste aluno.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.backTo.record %></a>
  </div>
</div>

<div class="panel">
  <% if (available.length === 0) { %>
  <p class="muted reading">
    <% if (!hasGuardians) { %>
    Nenhum responsável cadastrado nesta rede ainda.
    <% } else { %>
    Todos os responsáveis cadastrados já estão vinculados a este aluno.
    <% } %>
  </p>
  <div class="actions">
    <a class="button button--primary" href="<%= it.routes.registrar.guardianNew() %>"><%= it.titles.registrar.guardianNew %></a>
    <a class="button button--quiet" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.backTo.record %></a>
  </div>
  <% } else { %>
  <form class="form" method="post" action="<%= it.routes.registrar.studentGuardians({ id: student.id }) %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="userId">
          Responsável <span class="field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="userId"
          name="<%= fields.userId %>"
          required
          <% if (errorFor(fields.userId) !== '') { %>aria-invalid="true"<% } %>
          <% if (describedBy(fields.userId) !== '') { %>aria-describedby="<%= describedBy(fields.userId) %>"<% } %>>
          <option value=""><%= it.emptyOption %></option>
          <% available.forEach((guardian) => { %>
          <option value="<%= guardian.id %>" <%= chosenGuardian === guardian.id ? 'selected' : '' %>>
            <%= guardian.name %> — <%= guardian.email %>
          </option>
          <% }) %>
        </select>
        <% if (errorFor(fields.userId) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.userId) %>"><%= errorFor(fields.userId) %></p>
        <% } %>
      </div>

      <div class="field">
        <label class="field__label" for="relationship">
          Parentesco <span class="field__required" aria-hidden="true">*</span>
        </label>
        <input
          id="relationship"
          name="<%= fields.relationship %>"
          type="text"
          required
          maxlength="<%= it.relationshipLimit %>"
          value="<%= relationship %>"
          <% if (errorFor(fields.relationship) !== '') { %>aria-invalid="true"<% } %>
          aria-describedby="<%= describedBy(fields.relationship, true) %>">
        <p class="field__help" id="<%= it.helpId(fields.relationship) %>">Mãe, pai, avó, tutor legal.</p>
        <% if (errorFor(fields.relationship) !== '') { %>
        <p class="field__error" id="<%= it.errorId(fields.relationship) %>"><%= errorFor(fields.relationship) %></p>
        <% } %>
      </div>
    </div>

    <div class="field">
      <div class="field field--choice">
        <input
          id="financiallyResponsible"
          name="<%= fields.financiallyResponsible %>"
          type="checkbox"
          value="<%= it.checkedValue %>"
          <%= financiallyResponsible ? 'checked' : '' %>
          aria-describedby="<%= it.helpId(fields.financiallyResponsible) %>">
        <label class="field__label" for="financiallyResponsible">Responsável financeiro</label>
      </div>
      <p class="field__help" id="<%= it.helpId(fields.financiallyResponsible) %>">
        Marque quem responde pela cobrança. O aluno pode ter mais de um responsável, e apenas um
        deles precisa ser o financeiro.
      </p>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit"><%= it.titles.registrar.linkGuardian %></button>
      <a class="button button--quiet" href="<%= it.routes.registrar.student({ id: student.id }) %>"><%= it.actions.cancel %></a>
    </div>
  </form>
  <% } %>
</div>
