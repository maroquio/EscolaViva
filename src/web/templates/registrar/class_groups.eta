<%
const classGroups = it.classGroups ?? [];
const schools = it.schools ?? [];
const academicYears = it.academicYears ?? [];
const filter = it.filter ?? { schoolId: '', academicYearId: '' };
const filtering = filter.schoolId !== '' || filter.academicYearId !== '';
const classGroupList = it.routes.registrar.classGroups();
const classGroupForm = it.routes.registrar.classGroupNew();
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.registrar %></p>
    <h1 class="pagina__titulo"><%= it.title %></h1>
    <p class="pagina__resumo">
      A turma pertence a uma unidade e a um ano letivo. É nela que se alocam as disciplinas com seus
      professores, e é para ela que os alunos são matriculados.
    </p>
  </div>
  <div class="pagina__acoes">
    <a class="botao botao--secundario" href="<%= it.routes.registrar.subjects() %>"><%= it.titles.registrar.subjects %></a>
    <a class="botao botao--primario" href="<%= classGroupForm %>"><%= it.titles.registrar.classGroupNew %></a>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="get" action="<%= classGroupList %>">
    <div class="formulario__linha">
      <div class="campo">
        <label class="campo__rotulo" for="school"><%= it.labels.school %></label>
        <select id="school" name="<%= it.schoolField %>">
          <option value="">Todas as suas unidades</option>
          <% schools.forEach((school) => { %>
          <option value="<%= school.id %>" <%= filter.schoolId === school.id ? 'selected' : '' %>>
            <%= school.name %>
          </option>
          <% }) %>
        </select>
      </div>

      <div class="campo">
        <label class="campo__rotulo" for="year"><%= it.labels.academicYear %></label>
        <select id="year" name="<%= it.yearField %>">
          <option value="">Todos os anos</option>
          <% academicYears.forEach((academicYear) => { %>
          <option value="<%= academicYear.id %>" <%= filter.academicYearId === academicYear.id ? 'selected' : '' %>>
            <%= academicYear.year %>
          </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Filtrar</button>
      <% if (filtering) { %>
      <a class="botao botao--discreto" href="<%= classGroupList %>">Limpar filtro</a>
      <% } %>
    </div>
  </form>
</div>

<section class="secao" aria-labelledby="list">
  <div class="secao__cabecalho">
    <h2 id="list">Turmas</h2>
    <% const count = it.pagination === undefined ? classGroups.length : it.pagination.total; %>
    <p class="secao__nota">
      <span class="numero"><%= count %></span>
      <%= it.pluralize(count, it.nouns.classGroup) %><%= filtering ? ' no filtro atual' : '' %>
    </p>
  </div>

  <% if (classGroups.length === 0) { %>
  <%~ include(it.partials.empty, filtering
    ? {
        title: 'Nenhuma turma nesse filtro',
        text: 'Nenhuma turma das suas unidades combina com a unidade e o ano letivo escolhidos. Limpe o filtro para ver todas.',
        action: { href: classGroupList, text: 'Limpar filtro' }
      }
    : {
        title: 'Nenhuma turma cadastrada',
        text: 'Sem turma não há matrícula, alocação de professor nem chamada.',
        action: { href: classGroupForm, text: it.titles.registrar.classGroupNew }
      }) %>
  <% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Turmas das unidades sob sua secretaria</caption>
      <thead>
        <tr>
          <th scope="col" class="celula-centro"><%= it.labels.classGroup %></th>
          <th scope="col" class="celula-centro">Série</th>
          <th scope="col" class="celula-centro">Turno</th>
          <th scope="col" class="celula-centro"><%= it.labels.school %></th>
          <th scope="col" class="celula-centro"><%= it.labels.year %></th>
          <th scope="col" class="celula-centro"><%= it.labels.actions %></th>
        </tr>
      </thead>
      <tbody>
        <% classGroups.forEach((classGroup) => { %>
        <tr>
          <th scope="row" class="celula-centro"><%= classGroup.name %></th>
          <td class="celula-centro"><%= classGroup.gradeLevel %></td>
          <td class="celula-centro"><%= classGroup.shiftName %></td>
          <td class="celula-centro"><%= classGroup.schoolName %></td>
          <td class="numero celula-centro"><%= classGroup.year === null ? it.missingValue : classGroup.year %></td>
          <td class="celula-centro">
            <div class="tabela__acoes">
              <a class="botao botao--secundario botao--miudo" href="<%= it.routes.registrar.classGroup({ id: classGroup.id }) %>">
<% // magic-values: permitido — não é NOUNS.classGroup.singular, o substantivo que vem DEPOIS DE UM NÚMERO %>
                Abrir<span class="visualmente-oculto"> turma <%= classGroup.name %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.classGroup.plural }) %>
  <% } %>
</section>
