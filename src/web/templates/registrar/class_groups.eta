<%
const classGroups = it.classGroups ?? [];
const schools = it.schools ?? [];
const academicYears = it.academicYears ?? [];
const filter = it.filter ?? { schoolId: '', academicYearId: '' };
const filtering = filter.schoolId !== '' || filter.academicYearId !== '';
const classGroupList = it.routes.registrar.classGroups();
const classGroupForm = it.routes.registrar.classGroupNew();
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      A turma pertence a uma unidade e a um ano letivo. É nela que se alocam as disciplinas com seus
      professores, e é para ela que os alunos são matriculados.
    </p>
  </div>
  <div class="page__actions">
    <a class="button button--secondary" href="<%= it.routes.registrar.subjects() %>"><%= it.titles.registrar.subjects %></a>
    <a class="button button--primary" href="<%= classGroupForm %>"><%= it.titles.registrar.classGroupNew %></a>
  </div>
</div>

<div class="panel">
  <form class="form" method="get" action="<%= classGroupList %>">
    <div class="form__row">
      <div class="field">
        <label class="field__label" for="school"><%= it.labels.school %></label>
        <select id="school" name="<%= it.schoolField %>">
          <option value="">Todas as suas unidades</option>
          <% schools.forEach((school) => { %>
          <option value="<%= school.id %>" <%= filter.schoolId === school.id ? 'selected' : '' %>>
            <%= school.name %>
          </option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="year"><%= it.labels.academicYear %></label>
        <select id="year" name="<%= it.yearField %>">
          <option value="">Todos os anos</option>
          <% academicYears.forEach((academicYear) => { %>
          <option value="<%= academicYear.id %>" <%= filter.academicYearId === academicYear.id ? 'selected' : '' %>>
            <%= academicYear.year %>
          </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit">Filtrar</button>
      <% if (filtering) { %>
      <a class="button button--quiet" href="<%= classGroupList %>">Limpar filtro</a>
      <% } %>
    </div>
  </form>
</div>

<section class="section" aria-labelledby="list">
  <div class="section__header">
    <h2 id="list">Turmas</h2>
    <% const count = it.pagination === undefined ? classGroups.length : it.pagination.total; %>
    <p class="section__note">
      <span class="number"><%= count %></span>
      <%= it.pluralize(count, it.nouns.classGroup) %><%= filtering ? ' no filtro atual' : '' %>
    </p>
  </div>

  <% if (classGroups.length === 0) { %>
  <%~ include(it.partials.empty, filtering
    ? {
        title: 'Nenhuma turma nesse filtro',
        text: 'Nenhuma turma das suas unidades combina com a unidade e o ano letivo escolhidos. Limpe o filtro para ver todas.',
        action: { href: classGroupList, text: 'Limpar filtro' }
      }
    : {
        title: 'Nenhuma turma cadastrada',
        text: 'Sem turma não há matrícula, alocação de professor nem chamada.',
        action: { href: classGroupForm, text: it.titles.registrar.classGroupNew }
      }) %>
  <% } else { %>
  <div class="table-scroll">
    <table class="table">
      <caption>Turmas das unidades sob sua secretaria</caption>
      <thead>
        <tr>
          <th scope="col" class="cell-center"><%= it.labels.classGroup %></th>
          <th scope="col" class="cell-center">Série</th>
          <th scope="col" class="cell-center">Turno</th>
          <th scope="col" class="cell-center"><%= it.labels.school %></th>
          <th scope="col" class="cell-center"><%= it.labels.year %></th>
          <th scope="col" class="cell-center"><%= it.labels.actions %></th>
        </tr>
      </thead>
      <tbody>
        <% classGroups.forEach((classGroup) => { %>
        <tr>
          <th scope="row" class="cell-center"><%= classGroup.name %></th>
          <td class="cell-center"><%= classGroup.gradeLevel %></td>
          <td class="cell-center"><%= classGroup.shiftName %></td>
          <td class="cell-center"><%= classGroup.schoolName %></td>
          <td class="number cell-center"><%= classGroup.year === null ? it.missingValue : classGroup.year %></td>
          <td class="cell-center">
            <div class="table__actions">
              <a class="button button--secondary button--small" href="<%= it.routes.registrar.classGroup({ id: classGroup.id }) %>">
<% // magic-values: permitido — não é NOUNS.classGroup.singular, o substantivo que vem DEPOIS DE UM NÚMERO %>
                Abrir<span class="visually-hidden"> turma <%= classGroup.name %></span>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%~ include(it.partials.pagination, { pagination: it.pagination, label: it.nouns.classGroup.plural }) %>
  <% } %>
</section>
