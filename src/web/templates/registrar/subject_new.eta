<%
const valores = it.valores ?? {};
const campos = it.campos.disciplina;
const { erroDe, descricao } = it;
%>
<div class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.secretaria %><%= it.apresentacao.separador %><%= it.titulos.secretaria.disciplinas %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      A disciplina vale para toda a rede. Depois de cadastrar, aloque-a nas turmas com o professor
      responsável.
    </p>
  </div>
</div>

<div class="quadro">
  <form class="formulario" method="post" action="<%= it.rotas.secretaria.disciplinas() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">

    <div class="campo">
      <label class="campo__rotulo" for="nome">
        Nome da disciplina <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input
        id="nome"
        name="<%= campos.nome %>"
        type="text"
        required
        maxlength="<%= it.limiteDoNome %>"
        autocomplete="off"
        value="<%= valores.nome ?? '' %>"
        <% if (erroDe(campos.nome) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= descricao(campos.nome, true) %>">
      <p class="campo__ajuda" id="<%= it.idDaAjuda(campos.nome) %>">Único na rede: não há duas “Matemática”.</p>
      <% if (erroDe(campos.nome) !== '') { %>
      <p class="campo__erro" id="<%= it.idDoErro(campos.nome) %>"><%= erroDe(campos.nome) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit"><%= it.titulos.secretaria.disciplinaNova %></button>
      <a class="botao botao--discreto" href="<%= it.rotas.secretaria.disciplinas() %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
</div>
