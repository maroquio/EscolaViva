<%
const values = it.values ?? {};
const { errorFor, describedBy } = it;
const fields = it.fields.student;
%>
<div class="page__header">
  <div>
    <p class="overline"><%= it.areas.registrar %><%= it.presentation.separator %><%= it.titles.registrar.students %></p>
    <h1 class="page__title"><%= it.title %></h1>
    <p class="page__summary">
      O aluno pertence à rede, não a uma unidade: é a matrícula que o coloca numa turma. Depois de
      cadastrar, a ficha abre com os caminhos para vincular um responsável e para matricular.
    </p>
  </div>
</div>

<div class="panel">
  <form class="form" method="post" action="<%= it.routes.registrar.students() %>">
    <input type="hidden" name="<%= it.keyField %>" value="<%= it.key %>">

    <div class="field">
      <label class="field__label" for="<%= fields.name %>">
        Nome completo <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="<%= fields.name %>"
        name="<%= fields.name %>"
        type="text"
        required
        maxlength="<%= it.nameLimit %>"
        autocomplete="off"
        value="<%= values.name ?? '' %>"
        <% if (errorFor(fields.name) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.name, true) %>">
      <p class="field__help" id="<%= it.helpId(fields.name) %>">Como consta no documento do aluno.</p>
      <% if (errorFor(fields.name) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.name) %>"><%= errorFor(fields.name) %></p>
      <% } %>
    </div>

    <div class="field">
      <label class="field__label" for="<%= fields.birthDate %>">
        Data de nascimento <span class="field__required" aria-hidden="true">*</span>
      </label>
      <input
        id="<%= fields.birthDate %>"
        name="<%= fields.birthDate %>"
        type="date"
        required
        value="<%= values.birthDate ?? '' %>"
        <% if (errorFor(fields.birthDate) !== '') { %>aria-invalid="true"<% } %>
        aria-describedby="<%= describedBy(fields.birthDate, true) %>">
      <p class="field__help" id="<%= it.helpId(fields.birthDate) %>">
        Não pode estar no futuro.
      </p>
      <% if (errorFor(fields.birthDate) !== '') { %>
      <p class="field__error" id="<%= it.errorId(fields.birthDate) %>"><%= errorFor(fields.birthDate) %></p>
      <% } %>
    </div>

    <div class="actions">
      <button class="button button--primary" type="submit"><%= it.titles.registrar.studentNew %></button>
      <a class="button button--quiet" href="<%= it.routes.registrar.students() %>"><%= it.actions.cancel %></a>
    </div>
  </form>
</div>
