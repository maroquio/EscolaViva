<%
const valores = it.valores;
const responsaveis = it.responsaveis;
const selecionados = new Set(valores.selecionados);
const campos = it.campos.comunicado;
const alcances = it.alcances;
const separadorAntesDaQuebra = it.apresentacao.separador.trimEnd();
const { erroDe, descricao, idDoErro, idDaAjuda } = it;
%>
<header class="pagina__cabecalho">
  <div>
    <p class="sobretitulo"><%= it.areas.comunicacao %></p>
    <h1 class="pagina__titulo"><%= it.titulo %></h1>
    <p class="pagina__resumo">
      O comunicado aparece no mural dos responsáveis escolhidos, e a leitura de cada um passa a ser
      medida a partir da publicação.
    </p>
  </div>
  <p class="pagina__acoes">
    <a class="botao botao--discreto" href="<%= it.rotas.comunicados.lista() %>"><%= it.acoes.voltarPara.comunicados %></a>
  </p>
</header>

<% if (it.unidade === null) { %>
<section class="secao" aria-labelledby="titulo-unidade">
  <div class="secao__cabecalho">
    <h2 id="titulo-unidade">Passo 1<%= it.apresentacao.separador %>Unidade</h2>
    <p class="secao__nota">A lista de destinatários é a dos responsáveis desta unidade</p>
  </div>

  <% if (it.unidades.length === 0) { %>
    <%~ include(it.parciais.vazio, {
      titulo: 'Nenhuma unidade ativa ao seu alcance',
      texto: 'Comunicado é sempre de uma unidade para os responsáveis dela. Peça ao administrador da rede uma unidade ativa com o seu papel.',
    }) %>
  <% } else { %>
  <form class="formulario" method="get" action="<%= it.rotas.comunicados.novo() %>">
    <div class="campo">
      <label class="campo__rotulo" for="unidadeId">
        <%= it.rotulos.unidade %> <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <select id="unidadeId" name="<%= it.campoDaUnidade %>" required
              aria-describedby="<%= descricao(campos.unidadeId, true) %>"
              <% if (erroDe(campos.unidadeId) !== '') { %>aria-invalid="true"<% } %>>
        <option value="">Escolha a unidade</option>
        <% it.unidades.forEach((unidade) => { %>
        <option value="<%= unidade.id %>"><%= unidade.nome %></option>
        <% }) %>
      </select>
      <p class="campo__ajuda" id="<%= idDaAjuda(campos.unidadeId) %>">
        Só aparecem as unidades ativas em que você tem papel.
      </p>
      <% if (erroDe(campos.unidadeId) !== '') { %>
      <p class="campo__erro" id="<%= idDoErro(campos.unidadeId) %>"><%= erroDe(campos.unidadeId) %></p>
      <% } %>
    </div>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Continuar</button>
    </div>
  </form>
  <% } %>
</section>
<% } else { %>
<section class="secao" aria-labelledby="titulo-mensagem">
  <div class="secao__cabecalho">
    <h2 id="titulo-mensagem">Passo 2<%= it.apresentacao.separador %>Mensagem</h2>
    <p class="secao__nota">
      <%= it.rotulos.unidade %> <strong><%= it.unidade.nome %></strong><%= separadorAntesDaQuebra %>

      <a href="<%= it.rotas.comunicados.novo() %>">trocar unidade</a>
    </p>
  </div>

  <form class="formulario formulario--largo" method="post" action="<%= it.rotas.comunicados.novo() %>">
    <input type="hidden" name="<%= it.campoChave %>" value="<%= it.chave %>">
    <input type="hidden" name="<%= campos.unidadeId %>" value="<%= it.unidade.id %>">

    <div class="campo leitura">
      <label class="campo__rotulo" for="titulo">
        Título <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <input type="text" id="titulo" name="<%= campos.titulo %>" required
             value="<%= valores.titulo %>"
             aria-describedby="<%= descricao(campos.titulo, true) %>"
             <% if (erroDe(campos.titulo) !== '') { %>aria-invalid="true"<% } %>>
      <p class="campo__ajuda" id="<%= idDaAjuda(campos.titulo) %>">
        É a linha que o responsável vê na lista do mural.
      </p>
      <% if (erroDe(campos.titulo) !== '') { %>
      <p class="campo__erro" id="<%= idDoErro(campos.titulo) %>"><%= erroDe(campos.titulo) %></p>
      <% } %>
    </div>

    <div class="campo leitura">
      <label class="campo__rotulo" for="corpo">
        Mensagem <span class="campo__obrigatorio" aria-hidden="true">*</span>
      </label>
      <textarea id="corpo" name="<%= campos.corpo %>" required rows="<%= it.linhasDaMensagem %>"
                <% if (erroDe(campos.corpo) !== '') { %>aria-invalid="true"<% } %>
                aria-describedby="<%= descricao(campos.corpo, true) %>"><%= valores.corpo %></textarea>
      <p class="campo__ajuda" id="<%= idDaAjuda(campos.corpo) %>">
        O texto aparece como foi digitado, com as quebras de linha preservadas.
      </p>
      <% if (erroDe(campos.corpo) !== '') { %>
      <p class="campo__erro" id="<%= idDoErro(campos.corpo) %>"><%= erroDe(campos.corpo) %></p>
      <% } %>
    </div>

    <fieldset aria-describedby="<%= descricao(campos.destinatarios, true) %>">
      <legend><%= it.rotulos.destinatarios %></legend>

      <div class="pilha">
        <div class="campo campo--opcao">
          <input type="radio" id="alcance-unidade" name="<%= campos.alcance %>" value="<%= alcances.unidade %>"
                 <% if (valores.alcance === alcances.unidade) { %>checked<% } %>>
          <label class="campo__rotulo" for="alcance-unidade">
            Todos os responsáveis da unidade
            (<span class="numero"><%= responsaveis.length %></span>)
          </label>
        </div>

        <div class="campo campo--opcao">
          <input type="radio" id="alcance-selecionados" name="<%= campos.alcance %>" value="<%= alcances.selecionados %>"
                 <% if (valores.alcance === alcances.selecionados) { %>checked<% } %>>
          <label class="campo__rotulo" for="alcance-selecionados">
            Apenas os responsáveis marcados abaixo
          </label>
        </div>

        <p class="campo__ajuda" id="<%= idDaAjuda(campos.destinatarios) %>">
          Enviar para toda a unidade alcança quem tiver aluno com matrícula ativa no dia do envio.
        </p>

        <% if (erroDe(campos.destinatarios) !== '') { %>
        <p class="campo__erro" id="<%= idDoErro(campos.destinatarios) %>"><%= erroDe(campos.destinatarios) %></p>
        <% } %>

        <% if (responsaveis.length === 0) { %>
          <%~ include(it.parciais.vazio, {
            titulo: 'Nenhum responsável nesta unidade',
            texto: 'Só recebe comunicado quem está vinculado a um aluno com matrícula ativa aqui. A secretaria faz esse vínculo na ficha do aluno.',
          }) %>
        <% } else { %>
                <p class="linha">
          <button class="botao botao--secundario botao--miudo" type="button"
                  id="marcar-todos" hidden>Selecionar todos</button>
        </p>

        <ul class="grade-opcoes">
          <% responsaveis.forEach((responsavel) => { %>
          <li class="campo campo--opcao">
            <input type="checkbox" id="responsavel-<%= responsavel.id %>"
                   name="<%= campos.responsaveis %>" value="<%= responsavel.id %>"
                   <% if (selecionados.has(responsavel.id)) { %>checked<% } %>>
            <label class="campo__rotulo" for="responsavel-<%= responsavel.id %>">
              <%= responsavel.nome %>
            </label>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </fieldset>

    <div class="acoes">
      <button class="botao botao--primario" type="submit">Publicar comunicado</button>
      <a class="botao botao--discreto" href="<%= it.rotas.comunicados.lista() %>"><%= it.acoes.cancelar %></a>
    </div>
  </form>
</section>

<script>
  (() => {
    const botao = document.getElementById('marcar-todos');
    const caixas = Array.from(document.querySelectorAll('input[name="<%= campos.responsaveis %>"]'));
    const alcanceSelecionados = document.getElementById('alcance-selecionados');
    if (botao === null || caixas.length === 0) return;

    const todasMarcadas = () => caixas.every((caixa) => caixa.checked);
    const atualizarRotulo = () => {
      botao.textContent = todasMarcadas() ? 'Desmarcar todos' : 'Selecionar todos';
    };

    botao.addEventListener('click', () => {
      const marcar = !todasMarcadas();
      caixas.forEach((caixa) => { caixa.checked = marcar; });
      if (marcar && alcanceSelecionados !== null) alcanceSelecionados.checked = true;
      atualizarRotulo();
    });

    caixas.forEach((caixa) => caixa.addEventListener('change', atualizarRotulo));

    atualizarRotulo();
    botao.hidden = false;
  })();
</script>
<% } %>
